// Iterators: the Iterator<T> interface, for loops over iterators, and lazy adapters.

struct Countdown is Iterator<int> {
    n: int;

    func next(): Option<int> {
        if self.n == 0 {
            return Option::None;
        }
        self.n -= 1;
        return Option::Some(self.n + 1);
    }
}

func main() {
    for x in (Countdown { n: 3 }) {
        print("${x} ");
    }
    println("");
    var v: Vec<int> = Vec::new();
    for i in 1..=6 {
        v.push(i);
    }
    var squares = v.iter().filter(func(n) => n % 2 == 0).map(func(n) => n * n).collect();
    println(", ".join(squares.iter().map(func(n) => "${n}").collect()));
    for (i, x) in v.iter().enumerate() {
        if i < 2 {
            println("${i}: ${x}");
        }
    }
    var ages: Map<str, int> = Map::new();
    ages.insert("ada", 36);
    var total = 0;
    for (name, age) in ages {
        println("${name} is ${age}");
        total += age;
    }
    println(range(0, 5).fold(0, func(acc, n) => acc + n));
    println(range(0, 100).filter(func(n) => n % 7 == 0).count());
    println("hello".chars().filter(func(c) => c == 'l').count());
    println(range(1, 1000000).take(3).collect().len);
    println(Countdown { n: 5 }.any(func(n) => n == 2));
    for c in "hi".chars() {
        print(c);
    }
    println("");
}
