// Arenas: objects allocated in bulk and freed together, while still keeping
// collected objects they point to alive.

struct Node {
    value: int,
    label: str,
    next: &Node,
}

struct Parser {
    arena: Arena,
    count: int,
}

impl Parser {
    // Allocating through a field of a struct passed by pointer
    func make(self: &Parser, value: int): &Node {
        self.count = self.count + 1;
        return alloc(Node { value: value, label: null, next: null }) in self.arena;
    }
}

func label(n: int): str {
    var sb = StringBuilder::new();
    sb.append("node");
    sb.append_int(n);
    return sb.build();
}

// Allocate enough garbage to force collections
func churn() {
    var i = 0;
    while i < 1000 {
        var junk: str = malloc(8192 * sizeof(u8));
        junk[0] = 'x';
        i = i + 1;
    }
}

func main {
    var arena = Arena::new();
    var head: &Node = null;
    var i = 0;
    while i < 10000 {
        // The labels live on the collected heap, referenced only from arena memory
        head = alloc(Node { value: i, label: label(i), next: head }) in arena;
        i = i + 1;
    }
    churn();

    var total = 0;
    var cur = head;
    while cur != null {
        total = total + cur.value;
        cur = cur.next;
    }
    printf("sum %ld, first label %s, arena %ld KB\n", total, head.label, arena.allocated() / 1024);
    printf("a label from deep in the list: %s\n", head.next.next.next.label);

    var parser = Parser { arena: Arena::new(), count: 0 };
    var a = parser.make(1);
    var b = parser.make(2);
    a.next = b;
    printf("parser made %ld nodes: %ld -> %ld\n", parser.count, a.value, a.next.value);

    arena.free_all();
    parser.arena.free_all();
    printf("after free_all: %ld bytes\n", arena.allocated());

    // Reuse after free_all
    var again = alloc(Node { value: 42, label: "again", next: null }) in arena;
    printf("%s %ld\n", again.label, again.value);
    churn();
    if gc_collections() == 0 {
        printf("expected collections\n");
    }
}
