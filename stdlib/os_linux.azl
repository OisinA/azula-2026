// Operating system details that differ between platforms (Linux). Imported
// as "std/os.azl": the compilers pick os_linux.azl or os_macos.azl to match
// the host.

extern func setsockopt(i32, i32, i32, &i32, i32): i32;
extern func __errno_location(): &i32;

pub const SOL_SOCKET: i32 = 1;
pub const SO_REUSEADDR: i32 = 2;
// Flags for send(): report a closed connection as an error instead of
// raising SIGPIPE
pub const SEND_FLAGS: i32 = 16384;
// The offset of ai_addr in struct addrinfo
pub const ADDRINFO_ADDR_OFFSET: int = 24;

// The calling thread's errno
pub func errno(): i32 {
    return __errno_location()[0];
}

// Set up a new socket (nothing to do: send() takes MSG_NOSIGNAL instead)
pub func init_socket(fd: i32) {}

// Fill in the family of a struct sockaddr_in (a 16-bit sin_family)
pub func set_sockaddr_family(address: &u8, family: i32) {
    address[0] = family as u8;
    address[1] = 0;
}
