// A growable array.
struct Vec<T> {
    data: &T,
    len: int,
    cap: int,
}

impl Vec<T> {
    func new(): Vec<T> {
        return Vec::<T>::with_capacity(8);
    }

    func with_capacity(capacity: int): Vec<T> {
        var cap = capacity;
        if cap < 1 {
            cap = 1;
        }
        return Vec { data: malloc(cap * sizeof(T)), len: 0, cap: cap };
    }

    func push(self: &Vec<T>, value: T) {
        if self.len == self.cap {
            self.cap = self.cap * 2;
            self.data = realloc(self.data, self.cap * sizeof(T));
        }
        self.data[self.len] = value;
        self.len = self.len + 1;
    }

    func check_index(self: Vec<T>, index: int) {
        if index < 0 || index >= self.len {
            printf("Vec index %ld out of bounds (length %ld)\n", index, self.len);
            exit(1);
        }
    }

    func get(self: Vec<T>, index: int): T {
        self.check_index(index);
        return self.data[index];
    }

    func set(self: &Vec<T>, index: int, value: T) {
        self.check_index(index);
        self.data[index] = value;
    }

    func length(self: Vec<T>): int {
        return self.len;
    }

    func is_empty(self: Vec<T>): bool {
        return self.len == 0;
    }

    func pop(self: &Vec<T>): T {
        self.check_index(self.len - 1);
        self.len = self.len - 1;
        return self.data[self.len];
    }

    func peek(self: Vec<T>): T {
        return self.get(self.len - 1);
    }

    func clear(self: &Vec<T>) {
        self.len = 0;
    }

    func free_data(self: Vec<T>) {
        free(self.data);
    }
}
