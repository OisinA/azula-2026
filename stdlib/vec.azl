// A growable array.
struct Vec<T> {
    data: &T;
    len: int;
    cap: int;

    static func new(): Vec<T> {
        return Vec::<T>::with_capacity(8);
    }

    static func with_capacity(capacity: int): Vec<T> {
        var cap = capacity;
        if cap < 1 {
            cap = 1;
        }
        return Vec { data: malloc(cap * sizeof(T)), len: 0, cap: cap };
    }

    func push(value: T) {
        if self.len == self.cap {
            self.cap *= 2;
            self.data = realloc(self.data, self.cap * sizeof(T));
        }
        self.data[self.len] = value;
        self.len += 1;
    }

    func check_index(index: int) {
        if index < 0 || index >= self.len {
            printf("Vec index %ld out of bounds (length %ld)\n", index, self.len);
            exit(1);
        }
    }

    func get(index: int): T {
        self.check_index(index);
        return self.data[index];
    }

    func set(index: int, value: T) {
        self.check_index(index);
        self.data[index] = value;
    }

    func length(): int {
        return self.len;
    }

    func is_empty(): bool {
        return self.len == 0;
    }

    func pop(): T {
        self.check_index(self.len - 1);
        self.len -= 1;
        return self.data[self.len];
    }

    func peek(): T {
        return self.get(self.len - 1);
    }

    func clear() {
        self.len = 0;
    }

    func free_data() {
        free(self.data);
    }

    // Call `f` with each element in turn
    func each(f: func(T)) {
        var i = 0;
        while i < self.len {
            f(self.data[i]);
            i += 1;
        }
    }

    // A new Vec of `f` applied to each element
    func map<U>(f: func(T): U): Vec<U> {
        var out: Vec<U> = Vec::with_capacity(self.len);
        var i = 0;
        while i < self.len {
            out.push(f(self.data[i]));
            i += 1;
        }
        return out;
    }

    // A new Vec of the elements `keep` returns true for
    func filter(keep: func(T): bool): Vec<T> {
        var out: Vec<T> = Vec::new();
        var i = 0;
        while i < self.len {
            if keep(self.data[i]) {
                out.push(self.data[i]);
            }
            i += 1;
        }
        return out;
    }

    // Combine the elements into one value, starting from `initial`
    func fold<A>(initial: A, f: func(A, T): A): A {
        var result = initial;
        var i = 0;
        while i < self.len {
            result = f(result, self.data[i]);
            i += 1;
        }
        return result;
    }

    func any(test: func(T): bool): bool {
        var i = 0;
        while i < self.len {
            if test(self.data[i]) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    func all(test: func(T): bool): bool {
        var i = 0;
        while i < self.len {
            if !test(self.data[i]) {
                return false;
            }
            i += 1;
        }
        return true;
    }
}

