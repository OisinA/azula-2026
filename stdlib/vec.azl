// A growable array.
struct Vec<T> {
    data: &T;
    len: int;
    cap: int;

    static func new(): Vec<T> {
        return Vec::<T>::with_capacity(8);
    }

    static func with_capacity(capacity: int): Vec<T> {
        var cap = capacity;
        if cap < 1 {
            cap = 1;
        }
        return Vec { data: malloc(cap * sizeof(T)), len: 0, cap: cap };
    }

    func push(value: T) {
        if self.len == self.cap {
            self.cap *= 2;
            self.data = realloc(self.data, self.cap * sizeof(T));
        }
        self.data[self.len] = value;
        self.len += 1;
    }

    func check_index(index: int) {
        if index < 0 || index >= self.len {
            printf("Vec index %ld out of bounds (length %ld)\n", index, self.len);
            exit(1);
        }
    }

    func get(index: int): T {
        self.check_index(index);
        return self.data[index];
    }

    func set(index: int, value: T) {
        self.check_index(index);
        self.data[index] = value;
    }

    func length(): int {
        return self.len;
    }

    func is_empty(): bool {
        return self.len == 0;
    }

    func pop(): T {
        self.check_index(self.len - 1);
        self.len -= 1;
        return self.data[self.len];
    }

    func peek(): T {
        return self.get(self.len - 1);
    }

    func clear() {
        self.len = 0;
    }

    func free_data() {
        free(self.data);
    }

    func first(): Option<T> {
        if self.len == 0 {
            return Option::None;
        }
        return Option::Some(self.data[0]);
    }

    func last(): Option<T> {
        if self.len == 0 {
            return Option::None;
        }
        return Option::Some(self.data[self.len - 1]);
    }

    // Insert `value` at `index`, moving later elements along
    func insert(index: int, value: T) {
        if index < 0 || index > self.len {
            printf("Vec insert at %ld out of bounds (length %ld)\n", index, self.len);
            exit(1);
        }
        self.push(value);
        var i = self.len - 1;
        while i > index {
            self.data[i] = self.data[i - 1];
            i -= 1;
        }
        self.data[index] = value;
    }

    // Remove and return the element at `index`, moving later elements back
    func remove(index: int): T {
        self.check_index(index);
        var value = self.data[index];
        var i = index;
        while i + 1 < self.len {
            self.data[i] = self.data[i + 1];
            i += 1;
        }
        self.len -= 1;
        return value;
    }

    // Add all of `other`'s elements to the end
    func push_all(other: Vec<T>) {
        var i = 0;
        while i < other.len {
            self.push(other.data[i]);
            i += 1;
        }
    }

    // A new Vec of the elements from `start` up to (not including) `end`,
    // which are clamped to the Vec
    func slice(start: int, end: int): Vec<T> {
        var from = start;
        var to = end;
        if from < 0 {
            from = 0;
        }
        if to > self.len {
            to = self.len;
        }
        var out: Vec<T> = Vec::new();
        var i = from;
        while i < to {
            out.push(self.data[i]);
            i += 1;
        }
        return out;
    }

    func reverse() {
        var i = 0;
        var j = self.len - 1;
        while i < j {
            var t = self.data[i];
            self.data[i] = self.data[j];
            self.data[j] = t;
            i += 1;
            j -= 1;
        }
    }

    // The position of the first element equal to `value`, if any
    func index_of(value: T): Option<int> {
        var i = 0;
        while i < self.len {
            if self.data[i] == value {
                return Option::Some(i);
            }
            i += 1;
        }
        return Option::None;
    }

    func contains(value: T): bool {
        return self.index_of(value).is_some();
    }

    // Sort into ascending order (a stable merge sort) using `<`, which works
    // for numbers, strings, chars and types that are Ord
    func sort() {
        self.sort_by(func(a, b) => a < b);
    }

    // Sort so that `less(a, b)` holds for any a before b (stable)
    func sort_by(less: func(T, T): bool) {
        if self.len < 2 {
            return;
        }
        var temp: &T = malloc(self.len * sizeof(T));
        var width = 1;
        while width < self.len {
            var start = 0;
            while start < self.len {
                var mid = start + width;
                if mid > self.len {
                    mid = self.len;
                }
                var end = start + 2 * width;
                if end > self.len {
                    end = self.len;
                }
                // Merge [start, mid) and [mid, end) into temp
                var i = start;
                var j = mid;
                var k = start;
                while k < end {
                    if i < mid && (j >= end || !less(self.data[j], self.data[i])) {
                        temp[k] = self.data[i];
                        i += 1;
                    } else {
                        temp[k] = self.data[j];
                        j += 1;
                    }
                    k += 1;
                }
                start = end;
            }
            memcpy(self.data, temp, self.len * sizeof(T));
            width *= 2;
        }
        free(temp);
    }

    // Call `f` with each element in turn
    func each(f: func(T)) {
        var i = 0;
        while i < self.len {
            f(self.data[i]);
            i += 1;
        }
    }

    // A new Vec of `f` applied to each element
    func map<U>(f: func(T): U): Vec<U> {
        var out: Vec<U> = Vec::with_capacity(self.len);
        var i = 0;
        while i < self.len {
            out.push(f(self.data[i]));
            i += 1;
        }
        return out;
    }

    // A new Vec of the elements `keep` returns true for
    func filter(keep: func(T): bool): Vec<T> {
        var out: Vec<T> = Vec::new();
        var i = 0;
        while i < self.len {
            if keep(self.data[i]) {
                out.push(self.data[i]);
            }
            i += 1;
        }
        return out;
    }

    // Combine the elements into one value, starting from `initial`
    func fold<A>(initial: A, f: func(A, T): A): A {
        var result = initial;
        var i = 0;
        while i < self.len {
            result = f(result, self.data[i]);
            i += 1;
        }
        return result;
    }

    func any(test: func(T): bool): bool {
        var i = 0;
        while i < self.len {
            if test(self.data[i]) {
                return true;
            }
            i += 1;
        }
        return false;
    }

    func all(test: func(T): bool): bool {
        var i = 0;
        while i < self.len {
            if !test(self.data[i]) {
                return false;
            }
            i += 1;
        }
        return true;
    }
}

