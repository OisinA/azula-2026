// The standard interfaces, and their implementations for the built-in types.
//
// Types implementing Eq and Ord can be compared with `==`, `!=`, `<`, `<=`,
// `>` and `>=`, which call `equals` and `compare`. Values of types
// implementing Show can be interpolated into strings.

interface Eq {
    func equals(other: Self): bool;
}

// `compare` returns a negative number, zero or a positive number when `self`
// is less than, equal to or greater than `other`
interface Ord {
    func compare(other: Self): int;
}

// Equal values must have equal hashes
interface Hash {
    func hash(): int;
}

interface Show {
    func to_str(): str;
}

extend int is Eq, Ord, Hash, Show {
    func equals(other: int): bool {
        return self == other;
    }

    func compare(other: int): int {
        if self < other {
            return -1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }

    func hash(): int {
        // Mix the bits so nearby numbers spread out
        var h = self * -7046029254386353131;
        return (h ^ (h >> 32)) & 0x7fffffffffffffff;
    }

    func to_str(): str {
        return str_from_int(self);
    }
}

extend str is Eq, Ord, Hash, Show {
    func equals(other: str): bool {
        return self == other;
    }

    func compare(other: str): int {
        return str_compare(self, other);
    }

    func hash(): int {
        var h = 5381;
        var i = 0;
        while self[i] != 0 {
            h = ((h << 5) + h) ^ (self[i] as int);
            i += 1;
        }
        return h & 0x7fffffffffffffff;
    }

    func to_str(): str {
        return self;
    }
}

extend char is Eq, Ord, Hash, Show {
    func equals(other: char): bool {
        return self == other;
    }

    func compare(other: char): int {
        return (self as int) - (other as int);
    }

    func hash(): int {
        return self as int & 255;
    }

    func to_str(): str {
        return str_from_char(self);
    }
}

extend bool is Eq, Hash, Show {
    func equals(other: bool): bool {
        return self == other;
    }

    func hash(): int {
        if self {
            return 1;
        }
        return 0;
    }

    func to_str(): str {
        return str_from_bool(self);
    }
}

extend float is Eq, Ord, Show {
    func equals(other: float): bool {
        return self == other;
    }

    func compare(other: float): int {
        if self < other {
            return -1;
        }
        if self > other {
            return 1;
        }
        return 0;
    }

    func to_str(): str {
        return str_from_float(self);
    }
}

// Something that produces values one at a time: `for x in it` calls `next()`
// until it gives None. Types with an `iter()` method returning an Iterator can
// be used in `for` loops too. The other methods are lazy adapters and helpers
// that every iterator gets.
interface Iterator<T> {
    func next(): Option<T>;

    // `f` applied to each value
    func map<U>(f: func(T): U): Mapped<Self, T, U> {
        return Mapped { source: *self, f: f };
    }

    // The values `keep` returns true for
    func filter(keep: func(T): bool): Filtered<Self, T> {
        return Filtered { source: *self, keep: keep };
    }

    // Each value with its position: (0, a), (1, b), ...
    func enumerate(): Enumerated<Self, T> {
        return Enumerated { source: *self, index: 0 };
    }

    // At most the first `count` values
    func take(count: int): Taken<Self, T> {
        return Taken { source: *self, left: count };
    }

    // All the remaining values, in a Vec
    func collect(): Vec<T> {
        var out: Vec<T> = Vec::new();
        while true {
            match self.next() {
                Option::Some(value) => { out.push(value); },
                Option::None => { return out; },
            }
        }
        return out;
    }

    func count(): int {
        var n = 0;
        while self.next().is_some() {
            n += 1;
        }
        return n;
    }

    func fold<A>(initial: A, f: func(A, T): A): A {
        var result = initial;
        while true {
            match self.next() {
                Option::Some(value) => { result = f(result, value); },
                Option::None => { return result; },
            }
        }
        return result;
    }

    func any(test: func(T): bool): bool {
        while true {
            match self.next() {
                Option::Some(value) => {
                    if test(value) {
                        return true;
                    }
                },
                Option::None => { return false; },
            }
        }
        return false;
    }

    func all(test: func(T): bool): bool {
        while true {
            match self.next() {
                Option::Some(value) => {
                    if !test(value) {
                        return false;
                    }
                },
                Option::None => { return true; },
            }
        }
        return true;
    }

    func each(f: func(T)) {
        while true {
            match self.next() {
                Option::Some(value) => { f(value); },
                Option::None => { return; },
            }
        }
    }
}
