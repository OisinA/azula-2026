// Prelude functions whose implementation differs between platforms (macOS).
// The compilers load platform_linux.azl or platform_macos.azl to match the
// host.

extern func _NSGetArgc(): &i32;
extern func _NSGetArgv(): &&str;
extern func _NSGetExecutablePath(str, &u32): i32;

// The program's command-line arguments
func platform_args(): Vec<str> {
    var out: Vec<str> = Vec::new();
    var argc = _NSGetArgc()[0];
    var argv = _NSGetArgv()[0];
    var i = 0;
    while i < argc {
        out.push(argv[i]);
        i += 1;
    }
    return out;
}

// The path of the running executable, or null if it can't be found
func platform_executable_path(): str {
    var size: u32 = 4096;
    var path: str = malloc(4096 * sizeof(u8));
    if _NSGetExecutablePath(path, &size) != 0 {
        free(path);
        return null;
    }
    return path;
}
