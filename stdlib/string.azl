struct String {
    data: str;
    len: int;

    static func new(s: str): String {
        return String { data: s, len: strlen(s) };
    }

    func length(): int {
        return self.len;
    }

    func equals(other: String): bool {
        return strcmp(self.data, other.data) == 0;
    }

    func charAt(index: int): int {
        return self.data[index];
    }

    func print() {
        printf("%s\n", self.data);
    }

    func substr(start: int, len: int): String {
        var buf = malloc((len + 1) * sizeof(u8));
        memcpy(buf, ptr_add(self.data, start), len);
        buf[len] = 0;
        return String { data: buf, len: len };
    }
}

func read_file(path: str): String {
    var f = fopen(path, "r");
    fseek(f, 0, 2);
    var size = ftell(f);
    fseek(f, 0, 0);
    var buf = malloc((size + 1) * sizeof(u8));
    fread(buf, 1, size, f);
    buf[size] = 0;
    fclose(f);
    return String { data: buf, len: size };
}

// Builds up a string piece by piece.
struct StringBuilder {
    data: str;
    len: int;
    cap: int;

    static func new(): StringBuilder {
        var data: str = malloc(64 * sizeof(u8));
        data[0] = 0;
        return StringBuilder { data: data, len: 0, cap: 64 };
    }

    func reserve(extra: int) {
        if self.len + extra + 1 > self.cap {
            while self.len + extra + 1 > self.cap {
                self.cap *= 2;
            }
            self.data = realloc(self.data, self.cap);
        }
    }

    func append(s: str) {
        var n = strlen(s);
        self.reserve(n);
        memcpy(ptr_add(self.data, self.len), s, n + 1);
        self.len += n;
    }

    func append_char(c: int) {
        self.reserve(1);
        self.data[self.len] = c as i8;
        self.len += 1;
        self.data[self.len] = 0;
    }

    func append_int(n: int) {
        self.reserve(24);
        var written = snprintf(ptr_add(self.data, self.len), 24, "%ld", n);
        self.len += written;
    }

    // The contents so far (shares the builder's buffer)
    func to_str(): str {
        return self.data;
    }

    // A copy of the contents that later appends won't change
    func build(): str {
        var copy: str = malloc((self.len + 1) * sizeof(u8));
        memcpy(copy, self.data, self.len + 1);
        return copy;
    }
}


// ---------------------------------------------------------------------------
// Support for string operators: the compilers turn `a == b` on strings into
// str_equals(a, b), `a < b` into str_compare(a, b) < 0, `a + b` into
// str_concat(a, b), and "x = ${x}" into concatenations using str_from_*.
// ---------------------------------------------------------------------------

func str_equals(a: str, b: str): bool {
    if a as int == b as int {
        return true;
    }
    if a as int == 0 || b as int == 0 {
        return false;
    }
    return strcmp(a, b) == 0;
}

func str_compare(a: str, b: str): int {
    return strcmp(a, b) as int;
}

func str_concat(a: str, b: str): str {
    var n = strlen(a);
    var m = strlen(b);
    var result: str = malloc((n + m + 1) * sizeof(u8));
    memcpy(result, a, n);
    memcpy(ptr_add(result, n), b, m + 1);
    return result;
}

func str_from_int(n: int): str {
    var buf: str = malloc(24 * sizeof(u8));
    snprintf(buf, 24, "%ld", n);
    return buf;
}

func str_from_float(f: float): str {
    var buf: str = malloc(32 * sizeof(u8));
    snprintf(buf, 32, "%g", f);
    return buf;
}

func str_from_char(c: char): str {
    var buf: str = malloc(2 * sizeof(u8));
    buf[0] = c;
    buf[1] = 0;
    return buf;
}

func str_from_bool(b: bool): str {
    if b {
        return "true";
    }
    return "false";
}

// ---------------------------------------------------------------------------
// Characters
// ---------------------------------------------------------------------------

extend char {
    func is_digit(): bool {
        return self >= '0' && self <= '9';
    }

    func is_alpha(): bool {
        return (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z');
    }

    func is_alnum(): bool {
        return self.is_alpha() || self.is_digit();
    }

    func is_space(): bool {
        return self == ' ' || self == '\t' || self == '\n' || self == '\r';
    }

    func is_upper(): bool {
        return self >= 'A' && self <= 'Z';
    }

    func is_lower(): bool {
        return self >= 'a' && self <= 'z';
    }

    func to_upper(): char {
        if self.is_lower() {
            return self - 32;
        }
        return self;
    }

    func to_lower(): char {
        if self.is_upper() {
            return self + 32;
        }
        return self;
    }
}

// ---------------------------------------------------------------------------
// String methods. Strings are C strings: methods that make a new string
// allocate it, and never change the original.
// ---------------------------------------------------------------------------

extend str {
    func len(): int {
        return strlen(self);
    }

    func is_empty(): bool {
        return self[0] == 0;
    }

    // The index of the first `needle`, if there is one
    func find(needle: str): Option<int> {
        var found = strstr(self, needle);
        if found == null {
            return Option::None;
        }
        return Option::Some(found as int - self as int);
    }

    func contains(needle: str): bool {
        return strstr(self, needle) != null;
    }

    func starts_with(prefix: str): bool {
        return strncmp(self, prefix, strlen(prefix)) == 0;
    }

    func ends_with(suffix: str): bool {
        var n = strlen(self);
        var m = strlen(suffix);
        return m <= n && strcmp(ptr_add(self, n - m), suffix) == 0;
    }

    // The characters from `start` up to (not including) `end`, which are
    // clamped to the string
    func slice(start: int, end: int): str {
        var n = strlen(self);
        var from = start;
        var to = end;
        if from < 0 {
            from = 0;
        }
        if to > n {
            to = n;
        }
        if to < from {
            to = from;
        }
        var out: str = malloc((to - from + 1) * sizeof(u8));
        memcpy(out, ptr_add(self, from), to - from);
        out[to - from] = 0;
        return out;
    }

    func trim_start(): str {
        var i = 0;
        while self[i] != 0 && self[i].is_space() {
            i += 1;
        }
        return self.slice(i, strlen(self));
    }

    func trim_end(): str {
        var n = strlen(self);
        while n > 0 && self[n - 1].is_space() {
            n -= 1;
        }
        return self.slice(0, n);
    }

    func trim(): str {
        return self.trim_start().trim_end();
    }

    // The pieces between occurrences of `separator` (which must not be empty)
    func split(separator: str): Vec<str> {
        var parts: Vec<str> = Vec::new();
        var sep_len = strlen(separator);
        var rest = self;
        while true {
            var found = strstr(rest, separator);
            if found == null {
                parts.push(rest.slice(0, strlen(rest)));
                return parts;
            }
            parts.push(rest.slice(0, found as int - rest as int));
            rest = ptr_add(found, sep_len);
        }
        return parts;
    }

    func lines(): Vec<str> {
        var parts = self.split("\n");
        // A final newline doesn't start another line
        if parts.len > 0 && parts.get(parts.len - 1) == "" {
            parts.pop();
        }
        return parts;
    }

    // A copy with each `from` replaced by `to`
    func replace(from: str, to: str): str {
        if from == "" {
            return self.slice(0, strlen(self));
        }
        var out = StringBuilder::new();
        var from_len = strlen(from);
        var rest = self;
        while true {
            var found = strstr(rest, from);
            if found == null {
                out.append(rest);
                return out.to_str();
            }
            out.append(rest.slice(0, found as int - rest as int));
            out.append(to);
            rest = ptr_add(found, from_len);
        }
        return out.to_str();
    }

    func repeat(count: int): str {
        var out = StringBuilder::new();
        var i = 0;
        while i < count {
            out.append(self);
            i += 1;
        }
        return out.to_str();
    }

    func to_upper(): str {
        var out = self.slice(0, strlen(self));
        var i = 0;
        while out[i] != 0 {
            out[i] = out[i].to_upper();
            i += 1;
        }
        return out;
    }

    func to_lower(): str {
        var out = self.slice(0, strlen(self));
        var i = 0;
        while out[i] != 0 {
            out[i] = out[i].to_lower();
            i += 1;
        }
        return out;
    }

    // The parts joined with this string between them: ", ".join(names)
    func join(parts: Vec<str>): str {
        var out = StringBuilder::new();
        var i = 0;
        while i < parts.len {
            if i > 0 {
                out.append(self);
            }
            out.append(parts.get(i));
            i += 1;
        }
        return out.to_str();
    }

    // The whole string as a decimal integer (optionally signed)
    func parse_int(): Result<int, str> {
        var i = 0;
        var negative = false;
        if self[0] == '-' || self[0] == '+' {
            negative = self[0] == '-';
            i = 1;
        }
        if !self[i].is_digit() {
            return Result::Err("not a number: \"${self}\"");
        }
        var value = 0;
        while self[i].is_digit() {
            value = value * 10 + (self[i] - '0');
            i += 1;
        }
        if self[i] != 0 {
            return Result::Err("not a number: \"${self}\"");
        }
        if negative {
            return Result::Ok(-value);
        }
        return Result::Ok(value);
    }

    func parse_float(): Result<float, str> {
        var end: str = null;
        var value = strtod(self, &end);
        if end as int == self as int || end[0] != 0 {
            return Result::Err("not a number: \"${self}\"");
        }
        return Result::Ok(value);
    }
}
