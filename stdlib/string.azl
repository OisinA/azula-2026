struct String {
    data: str;
    len: int;

    static func new(s: str): String {
        return String { data: s, len: strlen(s) };
    }

    func length(): int {
        return self.len;
    }

    func equals(other: String): bool {
        return strcmp(self.data, other.data) == 0;
    }

    func charAt(index: int): int {
        return self.data[index];
    }

    func print() {
        printf("%s\n", self.data);
    }

    func substr(start: int, len: int): String {
        var buf = malloc((len + 1) * sizeof(u8));
        memcpy(buf, ptr_add(self.data, start), len);
        buf[len] = 0;
        return String { data: buf, len: len };
    }
}

func read_file(path: str): String {
    var f = fopen(path, "r");
    fseek(f, 0, 2);
    var size = ftell(f);
    fseek(f, 0, 0);
    var buf = malloc((size + 1) * sizeof(u8));
    fread(buf, 1, size, f);
    buf[size] = 0;
    fclose(f);
    return String { data: buf, len: size };
}

// Builds up a string piece by piece.
struct StringBuilder {
    data: str;
    len: int;
    cap: int;

    static func new(): StringBuilder {
        var data: str = malloc(64 * sizeof(u8));
        data[0] = 0;
        return StringBuilder { data: data, len: 0, cap: 64 };
    }

    func reserve(extra: int) {
        if self.len + extra + 1 > self.cap {
            while self.len + extra + 1 > self.cap {
                self.cap *= 2;
            }
            self.data = realloc(self.data, self.cap);
        }
    }

    func append(s: str) {
        var n = strlen(s);
        self.reserve(n);
        memcpy(ptr_add(self.data, self.len), s, n + 1);
        self.len += n;
    }

    func append_char(c: int) {
        self.reserve(1);
        self.data[self.len] = c as i8;
        self.len += 1;
        self.data[self.len] = 0;
    }

    func append_int(n: int) {
        self.reserve(24);
        var written = snprintf(ptr_add(self.data, self.len), 24, "%ld", n);
        self.len += written;
    }

    // The contents so far (shares the builder's buffer)
    func to_str(): str {
        return self.data;
    }

    // A copy of the contents that later appends won't change
    func build(): str {
        var copy: str = malloc((self.len + 1) * sizeof(u8));
        memcpy(copy, self.data, self.len + 1);
        return copy;
    }
}


// ---------------------------------------------------------------------------
// Support for string operators: the compilers turn `a == b` on strings into
// str_equals(a, b), `a < b` into str_compare(a, b) < 0, `a + b` into
// str_concat(a, b), and "x = ${x}" into concatenations using str_from_*.
// ---------------------------------------------------------------------------

func str_equals(a: str, b: str): bool {
    if a as int == b as int {
        return true;
    }
    if a as int == 0 || b as int == 0 {
        return false;
    }
    return strcmp(a, b) == 0;
}

func str_compare(a: str, b: str): int {
    return strcmp(a, b) as int;
}

func str_concat(a: str, b: str): str {
    var n = strlen(a);
    var m = strlen(b);
    var result: str = malloc((n + m + 1) * sizeof(u8));
    memcpy(result, a, n);
    memcpy(ptr_add(result, n), b, m + 1);
    return result;
}

func str_from_int(n: int): str {
    var buf: str = malloc(24 * sizeof(u8));
    snprintf(buf, 24, "%ld", n);
    return buf;
}

func str_from_float(f: float): str {
    var buf: str = malloc(32 * sizeof(u8));
    snprintf(buf, 32, "%g", f);
    return buf;
}

func str_from_bool(b: bool): str {
    if b {
        return "true";
    }
    return "false";
}
