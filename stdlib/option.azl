enum Option<T> {
    Some(T);
    None;

    func is_some(): bool {
        return match self {
            Option::Some(_) => true,
            Option::None => false,
        };
    }

    func is_none(): bool {
        return !self.is_some();
    }

    func unwrap(): T {
        match self {
            Option::Some(value) => { return value; },
            Option::None => {
                printf("called unwrap on None\n");
                exit(1);
            },
        }
    }

    func unwrap_or(default: T): T {
        match self {
            Option::Some(value) => { return value; },
            Option::None => { return default; },
        }
    }
}

