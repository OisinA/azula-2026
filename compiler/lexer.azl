// Turns source text into tokens.

enum Tok {
    Ident;
    Int;
    Float;
    Str;
    Char;
    LParen;
    RParen;
    LBracket;
    RBracket;
    LBrace;
    RBrace;
    Dot;
    Comma;
    Semi;
    Colon;
    ColonColon;
    Plus;
    Minus;
    Star;
    StarStar;
    Slash;
    Percent;
    Assign;
    EqEq;
    NotEq;
    Lt;
    Le;
    Gt;
    Ge;
    Shl;
    Shr;
    Amp;
    AmpAmp;
    Pipe;
    PipePipe;
    Caret;
    Tilde;
    Bang;
    FatArrow;
    KwFunc;
    KwReturn;
    KwVar;
    KwConst;
    KwTrue;
    KwFalse;
    KwIf;
    KwElse;
    KwBreak;
    KwContinue;
    KwExtern;
    KwVarargs;
    KwWhile;
    KwStruct;
    KwImpl;
    KwFor;
    KwEnum;
    KwMatch;
    KwAs;
    KwNull;
    KwType;
    KwImport;
    KwSizeof;
    KwExtend;
    KwIn;
    DotDot;
    DotDotEq;
    // `+=`, `<<=`, ...: the token's text is the operator (`+`, `<<`, ...)
    OpAssign;
    Eof;
}

struct Token {
    kind: Tok;
    // Identifier name, or the raw (still escaped) contents of a string/char literal
    text: str;
    // Value of an integer literal
    value: int;
    pos: int;
}

func is_digit(c: int): bool {
    return c >= '0' && c <= '9';
}

func is_hex_digit(c: int): bool {
    return is_digit(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

func is_ident_start(c: int): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
}

func is_ident_char(c: int): bool {
    return is_ident_start(c) || is_digit(c);
}

func hex_value(c: int): int {
    if is_digit(c) {
        return c - '0';
    }
    if c >= 'a' && c <= 'f' {
        return c - 'a' + 10;
    }
    return c - 'A' + 10;
}

func keyword_kind(word: str): Tok {
    if word == "func" { return Tok::KwFunc; }
    if word == "return" { return Tok::KwReturn; }
    if word == "var" { return Tok::KwVar; }
    if word == "const" { return Tok::KwConst; }
    if word == "true" { return Tok::KwTrue; }
    if word == "false" { return Tok::KwFalse; }
    if word == "if" { return Tok::KwIf; }
    if word == "else" { return Tok::KwElse; }
    if word == "break" { return Tok::KwBreak; }
    if word == "continue" { return Tok::KwContinue; }
    if word == "extern" { return Tok::KwExtern; }
    if word == "varargs" { return Tok::KwVarargs; }
    if word == "while" { return Tok::KwWhile; }
    if word == "struct" { return Tok::KwStruct; }
    if word == "impl" { return Tok::KwImpl; }
    if word == "for" { return Tok::KwFor; }
    if word == "enum" { return Tok::KwEnum; }
    if word == "match" { return Tok::KwMatch; }
    if word == "as" { return Tok::KwAs; }
    if word == "null" { return Tok::KwNull; }
    if word == "type" { return Tok::KwType; }
    if word == "import" { return Tok::KwImport; }
    if word == "sizeof" { return Tok::KwSizeof; }
    if word == "extend" { return Tok::KwExtend; }
    if word == "in" { return Tok::KwIn; }
    return Tok::Ident;
}

func make_token(kind: Tok, pos: int): Token {
    return Token { kind: kind, text: "", value: 0, pos: pos };
}

// The index just past the `}` closing the `${` at text[i]
func skip_interpolation(src: &Source, text: str, start: int): int {
    var i = start + 2;
    var depth = 1;
    while depth > 0 {
        var c: int = text[i];
        if c == 0 || c == '\n' {
            src.fail(start, "unterminated interpolation");
        }
        if c == '{' {
            depth += 1;
        } else if c == '}' {
            depth -= 1;
        } else if c == '"' {
            i += 1;
            while text[i] != '"' && text[i] != 0 && text[i] != '\n' {
                if text[i] == '\\' {
                    i += 1;
                }
                i += 1;
            }
        }
        i += 1;
    }
    return i;
}

func lex(src: &Source): Vec<Token> {
    return lex_range(src, 0, -1);
}

// Tokens from text[start] up to text[stop] (or the end when stop is -1)
func lex_range(src: &Source, start_at: int, stop: int): Vec<Token> {
    var text = src.text.to_str();
    var tokens: Vec<Token> = Vec::new();
    var i = start_at;
    while true {
        var c: int = text[i];
        if c == 0 || i == stop {
            tokens.push(make_token(Tok::Eof, i));
            return tokens;
        }
        if c == ' ' || c == '\n' || c == '\t' || c == '\r' {
            i += 1;
            continue;
        }
        var start = i;
        var next: int = text[i + 1];

        // Comments
        if c == '/' && next == '/' {
            while text[i] != '\n' && text[i] != 0 {
                i += 1;
            }
            continue;
        }

        if is_ident_start(c) {
            while is_ident_char(text[i] as int) {
                i += 1;
            }
            var word = substring(text, start, i - start);
            var tok = make_token(keyword_kind(word), start);
            tok.text = word;
            tokens.push(tok);
            continue;
        }

        if is_digit(c) {
            var tok = make_token(Tok::Int, start);
            if c == '0' && next == 'x' {
                i += 2;
                var value = 0;
                while is_hex_digit(text[i] as int) || text[i] == '_' {
                    if text[i] != '_' {
                        value = value * 16 + hex_value(text[i] as int);
                    }
                    i += 1;
                }
                tok.value = value;
            } else {
                var value = 0;
                while is_digit(text[i] as int) {
                    value = value * 10 + (text[i] as int - '0');
                    i += 1;
                }
                tok.value = value;
                // A float literal like 1.5 (but not `t.0.1`, which accesses tuple elements)
                var after_dot = tokens.len > 0 && tokens.get(tokens.len - 1).kind == Tok::Dot;
                if text[i] == '.' && is_digit(text[i + 1] as int) && !after_dot {
                    i += 1;
                    while is_digit(text[i] as int) {
                        i += 1;
                    }
                    tok.kind = Tok::Float;
                }
            }
            tok.text = substring(text, start, i - start);
            tokens.push(tok);
            continue;
        }

        if c == '"' || c == '\'' {
            i += 1;
            while text[i] != c {
                if text[i] == 0 || text[i] == '\n' {
                    src.fail(start, "unterminated literal");
                }
                if text[i] == '\\' {
                    i += 1;
                } else if c == '"' && text[i] == '$' && text[i + 1] == '{' {
                    i = skip_interpolation(src, text, i);
                    continue;
                }
                i += 1;
            }
            var tok = make_token(Tok::Str, start);
            if c == '\'' {
                tok.kind = Tok::Char;
            }
            tok.text = substring(text, start + 1, i - start - 1);
            i += 1;
            tokens.push(tok);
            continue;
        }

        // Compound assignment: an operator followed by `=`
        var op_len = 0;
        var third: int = 0;
        if next != 0 {
            third = text[i + 2];
        }
        if (c == '<' && next == '<') || (c == '>' && next == '>') {
            if third == '=' {
                op_len = 2;
            }
        } else if next == '=' && (c == '+' || c == '-' || c == '*' || c == '/' || c == '%' || c == '&' || c == '|' || c == '^') {
            op_len = 1;
        }
        if op_len > 0 {
            var tok = make_token(Tok::OpAssign, start);
            tok.text = substring(text, start, op_len);
            tokens.push(tok);
            i = i + op_len + 1;
            continue;
        }
        if c == '.' && next == '.' {
            if third == '=' {
                tokens.push(make_token(Tok::DotDotEq, start));
                i += 3;
            } else {
                tokens.push(make_token(Tok::DotDot, start));
                i += 2;
            }
            continue;
        }

        // Operators and punctuation: try two-character tokens first
        var kind = Tok::Eof;
        var len = 2;
        if c == ':' && next == ':' { kind = Tok::ColonColon; }
        else if c == '*' && next == '*' { kind = Tok::StarStar; }
        else if c == '=' && next == '=' { kind = Tok::EqEq; }
        else if c == '=' && next == '>' { kind = Tok::FatArrow; }
        else if c == '!' && next == '=' { kind = Tok::NotEq; }
        else if c == '<' && next == '=' { kind = Tok::Le; }
        else if c == '<' && next == '<' { kind = Tok::Shl; }
        else if c == '>' && next == '=' { kind = Tok::Ge; }
        else if c == '>' && next == '>' { kind = Tok::Shr; }
        else if c == '&' && next == '&' { kind = Tok::AmpAmp; }
        else if c == '|' && next == '|' { kind = Tok::PipePipe; }
        else {
            len = 1;
            kind = match c {
                '(' => Tok::LParen,
                ')' => Tok::RParen,
                '[' => Tok::LBracket,
                ']' => Tok::RBracket,
                '{' => Tok::LBrace,
                '}' => Tok::RBrace,
                '.' => Tok::Dot,
                ',' => Tok::Comma,
                ';' => Tok::Semi,
                ':' => Tok::Colon,
                '+' => Tok::Plus,
                '-' => Tok::Minus,
                '*' => Tok::Star,
                '/' => Tok::Slash,
                '%' => Tok::Percent,
                '=' => Tok::Assign,
                '<' => Tok::Lt,
                '>' => Tok::Gt,
                '&' => Tok::Amp,
                '|' => Tok::Pipe,
                '^' => Tok::Caret,
                '~' => Tok::Tilde,
                '!' => Tok::Bang,
                _ => Tok::Eof,
            };
            if kind == Tok::Eof {
                src.fail(start, "unexpected character");
            }
        }
        tokens.push(make_token(kind, start));
        i += len;
    }
    return tokens;
}

// Names of token kinds for error messages
func tok_name(kind: Tok): str {
    return match kind {
        Tok::Ident => "identifier",
        Tok::Int => "integer",
        Tok::Float => "float",
        Tok::Str => "string",
        Tok::Char => "character",
        Tok::LParen => "`(`",
        Tok::RParen => "`)`",
        Tok::LBracket => "`[`",
        Tok::RBracket => "`]`",
        Tok::LBrace => "`{`",
        Tok::RBrace => "`}`",
        Tok::Dot => "`.`",
        Tok::Comma => "`,`",
        Tok::Semi => "`;`",
        Tok::Colon => "`:`",
        Tok::ColonColon => "`::`",
        Tok::Assign => "`=`",
        Tok::Lt => "`<`",
        Tok::Gt => "`>`",
        Tok::FatArrow => "`=>`",
        Tok::Eof => "end of file",
        _ => "operator or keyword",
    };
}
