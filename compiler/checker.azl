// Type checking, generic instantiation and lowering.
//
// The checker annotates every expression with its type and rewrites the tree
// into resolved forms (Local, CallFn, FieldAt, EnumValue, ...), so the code
// generator never needs to look names up. Generic structs, enums, functions and
// methods are instantiated on demand for each set of type arguments used.

struct VarInfo {
    typ: Type;
    mutable: bool;
    ir: str;
    // Whether the variable lives in a heap cell (because closures capture
    // it): its slot then holds a pointer to the cell
    boxed: bool;
}

struct StructInfo {
    name: str;
    fields: Vec<Param>;
}

struct EnumInfo {
    name: str;
    variants: Vec<str>;
    payloads: Vec<Vec<Type>>;
    // Enums with any payload are boxed: values are pointers to heap cells
    boxed: bool;
}

struct FuncSig {
    symbol: str;
    params: Vec<Type>;
    ret: Type;
    is_varargs: bool;
    is_extern: bool;
    // Whether the first parameter is `self`
    is_method: bool;
}

struct Instance {
    generic: str;
    args: Vec<Type>;
}

// A type's claim to implement an interface
struct Claim {
    iface: str;
    pos: int;
}

// A method of a generic type, with the names the impl gave the type's parameters
struct GenericMethod {
    params: Vec<str>;
    decl: &FuncDecl;
}

struct Checker {
    src: &Source;
    structs: Map<str, &StructInfo>;
    enums: Map<str, &EnumInfo>;
    // Signatures by symbol: functions by name, methods as `Type.method`
    funcs: Map<str, &FuncSig>;
    generic_structs: Map<str, &StructDecl>;
    generic_enums: Map<str, &EnumDecl>;
    generic_funcs: Map<str, &FuncDecl>;
    generic_methods: Map<str, Vec<GenericMethod>>;
    instances: Map<str, Instance>;
    instantiated: Map<str, bool>;
    aliases: Map<str, Type>;
    globals: Map<str, Type>;
    interfaces: Map<str, &InterfaceDecl>;
    // The interfaces each type (or generic type) implements
    claims: Map<str, Vec<Claim>>;
    // Bounds on the type parameters of generic functions and types
    bounds: Map<str, Vec<Bound>>;

    // Results, in a deterministic order
    out_structs: Vec<&StructInfo>;
    out_enums: Vec<&EnumInfo>;
    out_funcs: Vec<&FuncDecl>;
    out_globals: Vec<&GlobalDecl>;
    extern_symbols: Vec<str>;
    pending: Vec<&FuncDecl>;

    // State for the function being checked
    scopes: Vec<Map<str, VarInfo>>;
    var_counter: int;
    current_return: Type;
    loop_depth: int;
    // Names closures in the function may capture: mutable variables with
    // these names live in heap cells
    captured: Map<str, bool>;
    // For naming the functions closures are lifted into
    closure_count: int;
    // Whether the program includes the garbage collector (stdlib/gc.azl)
    has_gc: bool;

    func fail(pos: int, message: str): ! {
        self.src.fail(pos, message);
    }

    func add_builtin(name: str, params: Vec<Type>, ret: Type, is_varargs: bool) {
        self.funcs.insert(name, new FuncSig {
            symbol: name,
            params: params,
            ret: ret,
            is_varargs: is_varargs,
            is_extern: true,
            is_method: false,
        });
    }

    func add_builtins() {
        var i32t = Type::SInt(32);
        self.add_builtin("printf", types1(Type::Str), i32t, true);
        self.add_builtin("strlen", types1(Type::Str), Type::Int, false);
        self.add_builtin("strcmp", types2(Type::Str, Type::Str), i32t, false);
        self.add_builtin("malloc", types1(Type::Int), Type::Str, false);
        self.add_builtin("memcpy", types3(Type::Str, Type::Str, Type::Int), Type::Str, false);
        self.add_builtin("free", types1(Type::Str), Type::Void, false);
        self.add_builtin("realloc", types2(Type::Str, Type::Int), Type::Str, false);
        self.add_builtin("fopen", types2(Type::Str, Type::Str), Type::Str, false);
        self.add_builtin("fclose", types1(Type::Str), i32t, false);
        self.add_builtin("fseek", types3(Type::Str, Type::Int, i32t), i32t, false);
        self.add_builtin("ftell", types1(Type::Str), Type::Int, false);
        self.add_builtin("fread", types4(Type::Str, Type::Int, Type::Int, Type::Str), Type::Int, false);
        // Compiler intrinsic: byte offset from a pointer
        self.add_builtin("ptr_add", types2(Type::Str, Type::Int), Type::Str, false);
        // Intrinsics for the garbage collector runtime
        self.add_builtin("gc_state", Vec::new(), Type::Str, false);
        self.add_builtin("gc_stack_pointer", Vec::new(), Type::Str, false);
        self.add_builtin("gc_spill_registers", Vec::new(), Type::Void, false);
        // C's allocator, which malloc & co. don't reach when the GC is in use
        self.add_builtin("c_malloc", types1(Type::Int), Type::Str, false);
        self.add_builtin("c_calloc", types2(Type::Int, Type::Int), Type::Str, false);
        self.add_builtin("c_realloc", types2(Type::Str, Type::Int), Type::Str, false);
        self.add_builtin("c_free", types1(Type::Str), Type::Void, false);
    }

    // -----------------------------------------------------------------------
    // Program
    // -----------------------------------------------------------------------

    func check_program(program: &Program) {
        self.collect_interfaces(program);
        Checker::resolve_receivers(program);

        // Pass 0: names of everything declared, so order doesn't matter
        var i = 0;
        while i < program.aliases.len {
            var a = program.aliases.get(i);
            self.aliases.insert(a.name, a.typ);
            i += 1;
        }
        var type_names: Map<str, bool> = Map::new();
        i = 0;
        while i < program.structs.len {
            var s = program.structs.get(i);
            self.check_unique(&type_names, s.name, s.pos);
            if s.type_params.len > 0 {
                self.generic_structs.insert(s.name, s);
            } else {
                var info = new StructInfo { name: s.name, fields: s.fields };
                self.structs.insert(s.name, info);
                self.out_structs.push(info);
            }
            i += 1;
        }
        i = 0;
        while i < program.enums.len {
            var e = program.enums.get(i);
            self.check_unique(&type_names, e.name, e.pos);
            if e.type_params.len > 0 {
                self.generic_enums.insert(e.name, e);
            } else {
                var names: Vec<str> = Vec::new();
                var payloads: Vec<Vec<Type>> = Vec::new();
                var boxed = false;
                var j = 0;
                while j < e.variants.len {
                    var v = e.variants.get(j);
                    names.push(v.name);
                    payloads.push(v.payload);
                    if v.payload.len > 0 {
                        boxed = true;
                    }
                    j += 1;
                }
                var info = new EnumInfo { name: e.name, variants: names, payloads: payloads, boxed: boxed };
                self.enums.insert(e.name, info);
                self.out_enums.push(info);
            }
            i += 1;
        }
        i = 0;
        while i < program.funcs.len {
            var f = program.funcs.get(i);
            if f.type_params.len > 0 {
                if self.generic_funcs.contains(f.name) {
                    self.fail(f.pos, concat3("`", f.name, "` is defined more than once"));
                }
                self.generic_funcs.insert(f.name, f);
            }
            i += 1;
        }
        i = 0;
        while i < program.impls.len {
            var imp = program.impls.get(i);
            match imp.target {
                Type::Generic(name, args) => {
                    var params: Vec<str> = Vec::new();
                    var j = 0;
                    while j < args.len {
                        params.push(named_of(args.get(j)));
                        j += 1;
                    }
                    var methods = self.generic_methods.get(name).unwrap_or(Vec::new());
                    j = 0;
                    while j < imp.methods.len {
                        methods.push(GenericMethod { params: params, decl: imp.methods.get(j) });
                        j += 1;
                    }
                    self.generic_methods.insert(name, methods);
                },
                _ => {
                    // Generic methods of a plain type are instantiated when called
                    var name = type_key(imp.target);
                    var methods = self.generic_methods.get(name).unwrap_or(Vec::new());
                    var j = 0;
                    while j < imp.methods.len {
                        if imp.methods.get(j).type_params.len > 0 {
                            methods.push(GenericMethod { params: Vec::new(), decl: imp.methods.get(j) });
                        }
                        j += 1;
                    }
                    self.generic_methods.insert(name, methods);
                },
            }
            i += 1;
        }

        // Pass 1: resolve the types in declarations and record signatures
        i = 0;
        while i < self.out_structs.len {
            var info = self.out_structs.get(i);
            info.fields = self.resolve_params(info.fields, 0);
            i += 1;
        }
        i = 0;
        while i < self.out_enums.len {
            var info = self.out_enums.get(i);
            info.payloads = self.resolve_payloads(info.payloads, 0);
            i += 1;
        }
        i = 0;
        while i < program.funcs.len {
            var f = program.funcs.get(i);
            if f.type_params.len == 0 {
                self.declare_func(f, f.name);
                if f.is_extern {
                    self.extern_symbols.push(f.name);
                }
            }
            i += 1;
        }
        i = 0;
        while i < program.impls.len {
            var imp = program.impls.get(i);
            if imp.type_params.len == 0 {
                var target = mangle(self.resolve_type(imp.target, imp.pos));
                var j = 0;
                while j < imp.methods.len {
                    var m = imp.methods.get(j);
                    if m.type_params.len == 0 {
                        self.declare_func(m, concat3(target, ".", m.name));
                    }
                    j += 1;
                }
            }
            i += 1;
        }
        i = 0;
        while i < program.globals.len {
            self.check_global(program.globals.get(i));
            i += 1;
        }
        self.has_gc = self.funcs.contains("gc_malloc");

        // Check that types implement the interfaces they claim to (generic
        // types are checked as they are instantiated)
        i = 0;
        while i < program.conformances.len {
            var claim = program.conformances.get(i);
            var key = type_key(claim.target);
            if !self.generic_structs.contains(key) && !self.generic_enums.contains(key) {
                var j = 0;
                while j < claim.interfaces.len {
                    self.verify_conformance(key, self.resolve_type(claim.target, claim.pos), claim.interfaces.get(j), claim.pos);
                    j += 1;
                }
            }
            i += 1;
        }

        // Pass 2: function bodies
        i = 0;
        while i < program.funcs.len {
            var f = program.funcs.get(i);
            if f.type_params.len == 0 && !f.is_extern {
                self.check_function(f);
            }
            i += 1;
        }
        i = 0;
        while i < program.impls.len {
            var imp = program.impls.get(i);
            if imp.type_params.len == 0 {
                var j = 0;
                while j < imp.methods.len {
                    if imp.methods.get(j).type_params.len == 0 {
                        self.check_function(imp.methods.get(j));
                    }
                    j += 1;
                }
            }
            i += 1;
        }

        // Pass 3: generic instances requested along the way
        while self.pending.len > 0 {
            self.check_function(self.pending.pop());
        }

        if !self.funcs.contains("main") {
            fatal("no `main` function");
        }
    }

    // Record interfaces and which types implement them, and give types the
    // default methods of their interfaces they don't define themselves
    func collect_interfaces(program: &Program) {
        self.bounds = program.bounds;
        var i = 0;
        while i < program.interfaces.len {
            var decl = program.interfaces.get(i);
            if self.interfaces.contains(decl.name) {
                self.fail(decl.pos, concat3("`", decl.name, "` is defined more than once"));
            }
            self.interfaces.insert(decl.name, decl);
            i += 1;
        }
        var owners = self.bounds.key_list();
        i = 0;
        while i < owners.len {
            var list = self.bounds.get(owners.get(i)).unwrap();
            var j = 0;
            while j < list.len {
                if !self.interfaces.contains(list.get(j).iface) {
                    fatal(concat3("unknown interface `", list.get(j).iface, concat3("` in the bounds of `", owners.get(i), "`")));
                }
                j += 1;
            }
            i += 1;
        }
        i = 0;
        while i < program.conformances.len {
            var claim = program.conformances.get(i);
            var key = type_key(claim.target);
            var j = 0;
            while j < claim.interfaces.len {
                var name = claim.interfaces.get(j);
                if !self.interfaces.contains(name) {
                    self.fail(claim.pos, concat3("unknown interface `", name, "`"));
                }
                var iface = self.interfaces.get(name).unwrap();
                var list = self.claims.get(key).unwrap_or(Vec::new());
                list.push(Claim { iface: name, pos: claim.pos });
                self.claims.insert(key, list);
                // Default methods the type doesn't define
                var k = 0;
                while k < iface.methods.len {
                    var m = iface.methods.get(k);
                    if iface.has_body.get(k) && !type_defines(program, key, m.name) {
                        var copier = Copier { params: Vec::new(), args: Vec::new() };
                        var copy = copier.copy_func(m, m.name);
                        var methods: Vec<&FuncDecl> = Vec::new();
                        methods.push(copy);
                        var type_params: Vec<str> = Vec::new();
                        match claim.target {
                            Type::Generic(_, args) => {
                                var a = 0;
                                while a < args.len {
                                    type_params.push(named_of(args.get(a)));
                                    a += 1;
                                }
                            },
                            _ => {},
                        }
                        program.impls.push(new ImplDecl { target: claim.target, type_params: type_params, methods: methods, pos: claim.pos });
                    }
                    // Methods implementing interface methods that take `self`
                    // take it too, even if they don't use it
                    if m.params.len > 0 && m.params.get(0).name == "self" {
                        add_self_param(program, key, m.name);
                    }
                    k += 1;
                }
                j += 1;
            }
            i += 1;
        }
    }

    // Check that `type_name` has the methods of interface `name`, with matching signatures
    func verify_conformance(type_name: str, self_type: Type, name: str, pos: int) {
        var iface = self.interfaces.get(name).unwrap();
        var receiver = self_type;
        if self.structs.contains(type_name) {
            receiver = Type::Ptr(self_type);
        }
        var params: Vec<str> = Vec::new();
        params.push("Self");
        params.push("__self");
        var args: Vec<Type> = Vec::new();
        args.push(self_type);
        args.push(receiver);
        var i = 0;
        while i < iface.methods.len {
            var m = iface.methods.get(i);
            var found = self.funcs.get(concat3(type_name, ".", m.name));
            if found.is_none() {
                self.fail(pos, concat3("`", mangle(self_type), concat3("` doesn't implement `", name, concat3("`: it has no method `", m.name, "`"))));
            }
            var sig = found.unwrap();
            var takes_self = m.params.len > 0 && m.params.get(0).name == "self";
            var what = concat3("`", mangle(self_type), concat3(".", m.name, "` "));
            if takes_self && !sig.is_method {
                self.fail(pos, concat3(what, "doesn't use `self`, but interface `", concat(name, "` needs it to be a method")));
            }
            if !takes_self && sig.is_method {
                self.fail(pos, concat3(what, "uses `self`, but interface `", concat(name, "` needs it to be static")));
            }
            var expected: Vec<Type> = Vec::new();
            var j = 0;
            if takes_self {
                j = 1;
            }
            while j < m.params.len {
                expected.push(self.resolve_type(subst_type(m.params.get(j).typ, params, args), pos));
                j += 1;
            }
            var expected_ret = self.resolve_type(subst_type(m.ret, params, args), pos);
            var same = type_eq(expected_ret, sig.ret);
            var skip = 0;
            if takes_self {
                skip = 1;
            }
            if sig.params.len - skip != expected.len {
                same = false;
            } else {
                j = 0;
                while j < expected.len {
                    if !type_eq(expected.get(j), sig.params.get(j + skip)) {
                        same = false;
                    }
                    j += 1;
                }
            }
            if !same {
                self.fail(pos, concat3(what, "doesn't match interface `", concat3(name, "`, which expects ", mangle(Type::Func(expected, expected_ret)))));
            }
            i += 1;
        }
    }

    // Does `t` implement interface `name`?
    func implements(t: Type, name: str): bool {
        var key = type_key(t);
        if self.claims_include(key, name) {
            return true;
        }
        return match self.instances.get(key) {
            Option::Some(inst) => self.claims_include(inst.generic, name),
            Option::None => false,
        };
    }

    func claims_include(key: str, name: str): bool {
        var list = self.claims.get(key).unwrap_or(Vec::new());
        var i = 0;
        while i < list.len {
            if list.get(i).iface == name {
                return true;
            }
            i += 1;
        }
        return false;
    }

    // Check the bounds generic `name` puts on its type parameters `params` against `args`
    func check_bounds(name: str, params: Vec<str>, args: Vec<Type>, pos: int) {
        var list = self.bounds.get(name).unwrap_or(Vec::new());
        var i = 0;
        while i < list.len {
            var b = list.get(i);
            var j = 0;
            while j < params.len && j < args.len {
                if params.get(j) == b.param && !self.implements(args.get(j), b.iface) {
                    self.fail(pos, concat3("`", mangle(args.get(j)), concat3("` doesn't implement `", b.iface, concat3("`, which `", name, concat3("` requires of ", b.param, "")))));
                }
                j += 1;
            }
            i += 1;
        }
    }

    // Give methods their receiver type and resolve `Self`: in a type's methods,
    // `self` is a reference (`&T`) for structs and a value for other types
    func resolve_receivers(program: &Program) {
        var structs: Map<str, bool> = Map::new();
        var i = 0;
        while i < program.structs.len {
            structs.insert(program.structs.get(i).name, true);
            i += 1;
        }
        i = 0;
        while i < program.impls.len {
            var imp = program.impls.get(i);
            var base = named_of(imp.target);
            match imp.target {
                Type::Generic(name, _) => { base = name; },
                _ => {},
            }
            var receiver = imp.target;
            if structs.contains(base) {
                receiver = Type::Ptr(imp.target);
            }
            var params: Vec<str> = Vec::new();
            params.push("Self");
            params.push("__self");
            var args: Vec<Type> = Vec::new();
            args.push(imp.target);
            args.push(receiver);
            var copier = Copier { params: params, args: args };
            var methods: Vec<&FuncDecl> = Vec::new();
            var j = 0;
            while j < imp.methods.len {
                var m = imp.methods.get(j);
                var copy = copier.copy_func(m, m.symbol);
                copy.type_params = m.type_params;
                copy.is_extern = m.is_extern;
                copy.is_varargs = m.is_varargs;
                methods.push(copy);
                j += 1;
            }
            imp.methods = methods;
            i += 1;
        }
    }

    func resolve_params(params: Vec<Param>, pos: int): Vec<Param> {
        var out: Vec<Param> = Vec::new();
        var i = 0;
        while i < params.len {
            var p = params.get(i);
            out.push(Param { name: p.name, typ: self.resolve_type(p.typ, pos) });
            i += 1;
        }
        return out;
    }

    func resolve_payloads(payloads: Vec<Vec<Type>>, pos: int): Vec<Vec<Type>> {
        var out: Vec<Vec<Type>> = Vec::new();
        var i = 0;
        while i < payloads.len {
            var payload = payloads.get(i);
            var resolved: Vec<Type> = Vec::new();
            var j = 0;
            while j < payload.len {
                resolved.push(self.resolve_type(payload.get(j), pos));
                j += 1;
            }
            out.push(resolved);
            i += 1;
        }
        return out;
    }

    func check_unique(names: &Map<str, bool>, name: str, pos: int) {
        if names.contains(name) {
            self.fail(pos, concat3("`", name, "` is defined more than once"));
        }
        names.insert(name, true);
    }

    // Record the signature of a (non-generic) function under `symbol`
    func declare_func(f: &FuncDecl, symbol: str) {
        // Externs may redeclare the compiler's built-in C functions
        var existing = self.funcs.get(symbol);
        if existing.is_some() && (!f.is_extern || !existing.unwrap().is_extern) {
            self.fail(f.pos, concat3("`", symbol, "` is defined more than once"));
        }
        f.symbol = symbol;
        f.params = self.resolve_params(f.params, f.pos);
        f.ret = self.resolve_type(f.ret, f.pos);
        var params: Vec<Type> = Vec::new();
        var i = 0;
        while i < f.params.len {
            params.push(f.params.get(i).typ);
            i += 1;
        }
        self.funcs.insert(symbol, new FuncSig {
            symbol: symbol,
            params: params,
            ret: f.ret,
            is_varargs: f.is_varargs,
            is_extern: f.is_extern,
            is_method: f.params.len > 0 && f.params.get(0).name == "self",
        });
    }

    func check_global(g: &GlobalDecl) {
        var expected = self.resolve_type(g.typ, g.pos);
        var valid = match g.value.kind {
            ExprKind::IntLit(_) => true,
            ExprKind::FloatLit(_) => true,
            ExprKind::BoolLit(_) => true,
            ExprKind::StrLit(_) => true,
            ExprKind::Unary(op, inner) => op == UnOp::Neg && is_int_literal(inner),
            _ => false,
        };
        if !valid {
            self.fail(g.pos, "constants must be literals");
        }
        self.scopes = Vec::new();
        var t = self.check_expr(g.value, expected);
        if !is_infer(expected) {
            if !assignable(expected, t, g.value) {
                self.fail(g.pos, concat3("constant has type ", mangle(t), concat(", expected ", mangle(expected))));
            }
            t = expected;
        }
        g.typ = t;
        self.globals.insert(g.name, t);
        self.out_globals.push(g);
    }

    // -----------------------------------------------------------------------
    // Types and generics
    // -----------------------------------------------------------------------

    func resolve_type(t: Type, pos: int): Type {
        return match t {
            Type::Named(name) => {
                var alias = self.aliases.get(name);
                match alias {
                    Option::Some(target) => { return self.resolve_type(target, pos); },
                    Option::None => {},
                }
                if !self.structs.contains(name) && !self.enums.contains(name) {
                    if self.generic_structs.contains(name) || self.generic_enums.contains(name) {
                        self.fail(pos, concat3("`", name, "` needs type arguments"));
                    }
                    self.fail(pos, concat3("unknown type `", name, "`"));
                }
                t
            },
            Type::Ptr(inner) => Type::Ptr(self.resolve_type(inner, pos)),
            Type::Array(inner, size) => Type::Array(self.resolve_type(inner, pos), size),
            Type::Generic(name, args) => {
                var resolved: Vec<Type> = Vec::new();
                var i = 0;
                while i < args.len {
                    resolved.push(self.resolve_type(args.get(i), pos));
                    i += 1;
                }
                self.instantiate_type(name, resolved, pos)
            },
            Type::Tuple(items) => {
                var resolved: Vec<Type> = Vec::new();
                var i = 0;
                while i < items.len {
                    resolved.push(self.resolve_type(items.get(i), pos));
                    i += 1;
                }
                self.instantiate_tuple(resolved)
            },
            Type::Func(params, ret) => {
                var resolved: Vec<Type> = Vec::new();
                var i = 0;
                while i < params.len {
                    resolved.push(self.resolve_type(params.get(i), pos));
                    i += 1;
                }
                Type::Func(resolved, self.resolve_type(ret, pos))
            },
            Type::Infer => t,
            _ => t,
        };
    }

    // The struct standing for tuple type `(items)`, with fields named `0`, `1`, ...
    func instantiate_tuple(items: Vec<Type>): Type {
        var name = mangle(Type::Tuple(items));
        if !self.structs.contains(name) {
            var fields: Vec<Param> = Vec::new();
            var i = 0;
            while i < items.len {
                fields.push(Param { name: int_to_str(i), typ: items.get(i) });
                i += 1;
            }
            var info = new StructInfo { name: name, fields: fields };
            self.structs.insert(name, info);
            self.out_structs.push(info);
            self.instances.insert(name, Instance { generic: "()", args: items });
        }
        return Type::Named(name);
    }

    // The element types of `t` if it's a tuple
    func tuple_items(t: Type): Option<Vec<Type>> {
        return match self.instances.get(named_of(t)) {
            Option::Some(inst) => {
                if inst.generic == "()" {
                    return Option::Some(inst.args);
                }
                Option::None
            },
            Option::None => Option::None,
        };
    }

    func type_params_of(name: str): Vec<str> {
        match self.generic_structs.get(name) {
            Option::Some(s) => { return s.type_params; },
            Option::None => {},
        }
        match self.generic_enums.get(name) {
            Option::Some(e) => { return e.type_params; },
            Option::None => {},
        }
        return Vec::new();
    }

    // The concrete type for generic `name` applied to `args`, creating it if needed
    func instantiate_type(name: str, args: Vec<Type>, pos: int): Type {
        var inst = mangle(Type::Generic(name, args));
        if self.instances.contains(inst) {
            return Type::Named(inst);
        }
        if !self.generic_structs.contains(name) && !self.generic_enums.contains(name) {
            self.fail(pos, concat3("unknown generic type `", name, "`"));
        }
        var params = self.type_params_of(name);
        if params.len != args.len {
            self.fail(pos, concat3("wrong number of type arguments for `", name, "`"));
        }
        self.instances.insert(inst, Instance { generic: name, args: args });
        self.check_bounds(name, params, args, pos);

        match self.generic_structs.get(name) {
            Option::Some(decl) => {
                var info = new StructInfo { name: inst, fields: Vec::new() };
                self.structs.insert(inst, info);
                self.out_structs.push(info);
                var fields: Vec<Param> = Vec::new();
                var i = 0;
                while i < decl.fields.len {
                    var f = decl.fields.get(i);
                    fields.push(Param { name: f.name, typ: self.resolve_type(subst_type(f.typ, params, args), pos) });
                    i += 1;
                }
                info.fields = fields;
            },
            Option::None => {},
        }
        match self.generic_enums.get(name) {
            Option::Some(decl) => {
                var info = new EnumInfo { name: inst, variants: Vec::new(), payloads: Vec::new(), boxed: false };
                self.enums.insert(inst, info);
                self.out_enums.push(info);
                var i = 0;
                while i < decl.variants.len {
                    var v = decl.variants.get(i);
                    info.variants.push(v.name);
                    var payload: Vec<Type> = Vec::new();
                    var j = 0;
                    while j < v.payload.len {
                        payload.push(self.resolve_type(subst_type(v.payload.get(j), params, args), pos));
                        j += 1;
                    }
                    if payload.len > 0 {
                        info.boxed = true;
                    }
                    info.payloads.push(payload);
                    i += 1;
                }
            },
            Option::None => {},
        }

        // Method signatures (bodies are instantiated when first used)
        var methods = self.generic_methods.get(name).unwrap_or(Vec::new());
        var i = 0;
        while i < methods.len {
            var m = methods.get(i);
            if m.decl.type_params.len > 0 {
                // Generic methods are instantiated when called
                i += 1;
                continue;
            }
            var sig_params: Vec<Type> = Vec::new();
            var j = 0;
            while j < m.decl.params.len {
                sig_params.push(self.resolve_type(subst_type(m.decl.params.get(j).typ, m.params, args), m.decl.pos));
                j += 1;
            }
            var symbol = concat3(inst, ".", m.decl.name);
            self.funcs.insert(symbol, new FuncSig {
                symbol: symbol,
                params: sig_params,
                ret: self.resolve_type(subst_type(m.decl.ret, m.params, args), m.decl.pos),
                is_varargs: false,
                is_extern: false,
                is_method: m.decl.params.len > 0 && m.decl.params.get(0).name == "self",
            });
            i += 1;
        }
        // Generic types implementing interfaces are checked per instance
        var claims = self.claims.get(name).unwrap_or(Vec::new());
        i = 0;
        while i < claims.len {
            self.verify_conformance(inst, Type::Named(inst), claims.get(i).iface, claims.get(i).pos);
            i += 1;
        }
        return Type::Named(inst);
    }

    // Make sure the body of `type_name.method` exists if it's a generic method
    func instantiate_method(type_name: str, method: str) {
        var symbol = concat3(type_name, ".", method);
        if self.instantiated.contains(symbol) {
            return;
        }
        var instance = match self.instances.get(type_name) {
            Option::Some(inst) => inst,
            Option::None => { return; },
        };
        var methods = self.generic_methods.get(instance.generic).unwrap_or(Vec::new());
        var i = 0;
        while i < methods.len {
            var m = methods.get(i);
            if m.decl.name == method && m.decl.type_params.len == 0 {
                self.instantiated.insert(symbol, true);
                var copier = Copier { params: m.params, args: instance.args };
                self.pending.push(copier.copy_func(m.decl, symbol));
                return;
            }
            i += 1;
        }
    }

    // If `method` is a generic method of `type_name`, the symbol of its instance
    // for `targs` (or type arguments inferred from `args` when not `explicit`),
    // instantiating it if needed; "" if it isn't a generic method
    func generic_method(type_name: str, method: str, targs: Vec<Type>, explicit: bool, on_value: bool, args: Vec<&Expr>, pos: int): str {
        var base = type_name;
        var base_args: Vec<Type> = Vec::new();
        match self.instances.get(type_name) {
            Option::Some(inst) => {
                if inst.generic != "()" {
                    base = inst.generic;
                    base_args = inst.args;
                }
            },
            Option::None => {},
        }
        var methods = self.generic_methods.get(base).unwrap_or(Vec::new());
        var found = false;
        var m = GenericMethod { params: Vec::new(), decl: null };
        var i = 0;
        while i < methods.len {
            if methods.get(i).decl.name == method && methods.get(i).decl.type_params.len > 0 {
                m = methods.get(i);
                found = true;
            }
            i += 1;
        }
        if !found {
            if explicit {
                self.fail(pos, concat3(type_name, " has no generic method ", method));
            }
            return "";
        }
        var decl = m.decl;
        var resolved: Vec<Type> = Vec::new();
        if explicit {
            i = 0;
            while i < targs.len {
                resolved.push(self.resolve_type(targs.get(i), pos));
                i += 1;
            }
        } else {
            var patterns: Vec<Type> = Vec::new();
            i = 0;
            if on_value && decl.params.len > 0 && decl.params.get(0).name == "self" {
                i = 1;
            }
            while i < decl.params.len {
                patterns.push(subst_type(decl.params.get(i).typ, m.params, base_args));
                i += 1;
            }
            resolved = self.infer_type_args(method, decl.type_params, Type::Infer, patterns, args, pos);
        }
        if resolved.len != decl.type_params.len {
            self.fail(pos, concat3("wrong number of type arguments for `", method, "`"));
        }
        var symbol = concat3(type_name, ".", mangle(Type::Generic(method, resolved)));
        if !self.instantiated.contains(symbol) {
            self.instantiated.insert(symbol, true);
            var params: Vec<str> = Vec::new();
            var all_args: Vec<Type> = Vec::new();
            i = 0;
            while i < m.params.len {
                params.push(m.params.get(i));
                all_args.push(base_args.get(i));
                i += 1;
            }
            i = 0;
            while i < decl.type_params.len {
                params.push(decl.type_params.get(i));
                all_args.push(resolved.get(i));
                i += 1;
            }
            var copier = Copier { params: params, args: all_args };
            var copy = copier.copy_func(decl, symbol);
            self.declare_func(copy, symbol);
            self.pending.push(copy);
        }
        return symbol;
    }

    // The symbol of generic function `name` instantiated with `args`
    func instantiate_function(name: str, args: Vec<Type>, pos: int): str {
        var symbol = mangle(Type::Generic(name, args));
        if self.instantiated.contains(symbol) {
            return symbol;
        }
        self.instantiated.insert(symbol, true);
        var decl = self.generic_funcs.get(name).unwrap();
        if decl.type_params.len != args.len {
            self.fail(pos, concat3("wrong number of type arguments for `", name, "`"));
        }
        self.check_bounds(name, decl.type_params, args, pos);
        var copier = Copier { params: decl.type_params, args: args };
        var copy = copier.copy_func(decl, symbol);
        self.declare_func(copy, symbol);
        self.pending.push(copy);
        return symbol;
    }

    // Match a generic `pattern` type against a `concrete` one, binding type parameters
    func unify(pattern: Type, concrete: Type, params: Vec<str>, bindings: &Map<str, Type>) {
        match pattern {
            Type::Named(name) => {
                if contains_str(params, name) && !bindings.contains(name) && !is_infer(concrete) {
                    bindings.insert(name, concrete);
                }
            },
            Type::Ptr(p) => {
                match concrete {
                    Type::Ptr(c) => { self.unify(p, c, params, bindings); },
                    _ => {},
                }
            },
            Type::Array(p, _) => {
                match concrete {
                    Type::Array(c, _) => { self.unify(p, c, params, bindings); },
                    _ => {},
                }
            },
            Type::Func(pparams, pret) => {
                match concrete {
                    Type::Func(cparams, cret) => {
                        var i = 0;
                        while i < pparams.len && i < cparams.len {
                            self.unify(pparams.get(i), cparams.get(i), params, bindings);
                            i += 1;
                        }
                        self.unify(pret, cret, params, bindings);
                    },
                    _ => {},
                }
            },
            Type::Tuple(pargs) => {
                match self.tuple_items(concrete) {
                    Option::Some(items) => {
                        var i = 0;
                        while i < pargs.len && i < items.len {
                            self.unify(pargs.get(i), items.get(i), params, bindings);
                            i += 1;
                        }
                    },
                    Option::None => {},
                }
            },
            Type::Generic(name, pargs) => {
                match self.instances.get(named_of(concrete)) {
                    Option::Some(inst) => {
                        if inst.generic == name {
                            var i = 0;
                            while i < pargs.len && i < inst.args.len {
                                self.unify(pargs.get(i), inst.args.get(i), params, bindings);
                                i += 1;
                            }
                        }
                    },
                    Option::None => {},
                }
            },
            _ => {},
        }
    }

    // Work out the type arguments for generic `name`: from the expected type if
    // that is an instance of the same generic, otherwise by matching `patterns`
    // against the types of `args`.
    func infer_type_args(name: str, params: Vec<str>, expected: Type, patterns: Vec<Type>, args: Vec<&Expr>, pos: int): Vec<Type> {
        match self.instances.get(named_of(expected)) {
            Option::Some(inst) => {
                if inst.generic == name {
                    return inst.args;
                }
            },
            Option::None => {},
        }
        var bindings = self.bind_params(params, patterns, args);
        self.bind_from_closures(params, patterns, args, &bindings);
        var result: Vec<Type> = Vec::new();
        var i = 0;
        while i < params.len {
            match bindings.get(params.get(i)) {
                Option::Some(t) => { result.push(t); },
                Option::None => {
                    self.fail(pos, concat3("cannot infer type parameter ", params.get(i), concat3(" of `", name, "`; give it explicitly like Name::<Type>")));
                },
            }
            i += 1;
        }
        return result;
    }

    // Closures whose parameter types aren't given can't be typed on their own.
    // Once the type parameters their parameters use are bound, check a copy of
    // each to learn its return type, and bind what that tells us.
    func bind_from_closures(params: Vec<str>, patterns: Vec<Type>, args: Vec<&Expr>, bindings: &Map<str, Type>) {
        var i = 0;
        while i < patterns.len && i < args.len {
            var arg = args.get(i);
            // Closures whose type isn't known from their annotations alone
            var cparams: Vec<Param> = Vec::new();
            var untyped = match arg.kind {
                ExprKind::Closure(ps, _, _) => {
                    cparams = ps;
                    is_infer(self.peek_type(arg))
                },
                _ => false,
            };
            if untyped {
                match patterns.get(i) {
                    Type::Func(ps, _) => {
                        var bound_params: Vec<str> = Vec::new();
                        var bound_args: Vec<Type> = Vec::new();
                        var j = 0;
                        while j < params.len {
                            match bindings.get(params.get(j)) {
                                Option::Some(t) => {
                                    bound_params.push(params.get(j));
                                    bound_args.push(t);
                                },
                                Option::None => {},
                            }
                            j += 1;
                        }
                        var closure_params: Vec<Type> = Vec::new();
                        var known = true;
                        j = 0;
                        while j < ps.len {
                            var t = subst_type(ps.get(j), bound_params, bound_args);
                            if j < cparams.len && !is_infer(cparams.get(j).typ) {
                                t = self.resolve_type(cparams.get(j).typ, arg.pos);
                            }
                            if mentions_params(t, params) {
                                known = false;
                            }
                            closure_params.push(t);
                            j += 1;
                        }
                        if known {
                            var copier = Copier { params: Vec::new(), args: Vec::new() };
                            var t = self.check_expr(copier.expr(arg), Type::Func(closure_params, Type::Infer));
                            self.unify(patterns.get(i), t, params, bindings);
                        }
                    },
                    _ => {},
                }
            }
            i += 1;
        }
    }

    // Bind type parameters by matching `patterns` against the types of `args`
    func bind_params(params: Vec<str>, patterns: Vec<Type>, args: Vec<&Expr>): Map<str, Type> {
        var bindings: Map<str, Type> = Map::new();
        var i = 0;
        while i < patterns.len && i < args.len {
            self.unify(patterns.get(i), self.peek_type(args.get(i)), params, &bindings);
            i += 1;
        }
        return bindings;
    }

    // The return type of a call to generic function `name`, if its type
    // arguments can be inferred from `args` (Infer otherwise)
    func peek_generic_call(name: str, args: Vec<&Expr>, pos: int): Type {
        var decl = self.generic_funcs.get(name).unwrap();
        var patterns: Vec<Type> = Vec::new();
        var i = 0;
        while i < decl.params.len {
            patterns.push(decl.params.get(i).typ);
            i += 1;
        }
        var bindings = self.bind_params(decl.type_params, patterns, args);
        var targs: Vec<Type> = Vec::new();
        i = 0;
        while i < decl.type_params.len {
            var bound = bindings.get(decl.type_params.get(i));
            if bound.is_none() {
                return Type::Infer;
            }
            targs.push(bound.unwrap());
            i += 1;
        }
        return self.resolve_type(subst_type(decl.ret, decl.type_params, targs), pos);
    }

    // The type of an expression if it can be known without checking it (used for
    // inferring type arguments; Infer when unknown)
    func peek_type(e: &Expr): Type {
        return match e.kind {
            ExprKind::IntLit(_) => Type::Int,
            ExprKind::FloatLit(_) => Type::Float,
            ExprKind::BoolLit(_) => Type::Bool,
            ExprKind::StrLit(_) => Type::Str,
            ExprKind::Ident(name) => {
                match self.lookup_var(name) {
                    Option::Some(v) => { return v.typ; },
                    Option::None => {},
                }
                self.globals.get(name).unwrap_or(Type::Infer)
            },
            ExprKind::AddrOf(x) => {
                var inner = self.peek_type(x);
                if is_infer(inner) {
                    return inner;
                }
                Type::Ptr(inner)
            },
            ExprKind::Field(x, name) => {
                var info = self.struct_of(self.peek_type(x));
                if info == null {
                    return Type::Infer;
                }
                var i = 0;
                while i < info.fields.len {
                    if info.fields.get(i).name == name {
                        return info.fields.get(i).typ;
                    }
                    i += 1;
                }
                Type::Infer
            },
            ExprKind::Index(a, _) => match self.peek_type(a) {
                Type::Ptr(inner) => inner,
                Type::Array(inner, _) => inner,
                Type::Str => Type::SInt(8),
                _ => Type::Infer,
            },
            ExprKind::Cast(_, t) => self.resolve_type(t, e.pos),
            ExprKind::Closure(params, ret, _) => {
                if is_infer(ret) {
                    return Type::Infer;
                }
                var types: Vec<Type> = Vec::new();
                var i = 0;
                while i < params.len {
                    if is_infer(params.get(i).typ) {
                        return Type::Infer;
                    }
                    types.push(self.resolve_type(params.get(i).typ, e.pos));
                    i += 1;
                }
                Type::Func(types, self.resolve_type(ret, e.pos))
            },
            ExprKind::SizeOf(_) => Type::Int,
            ExprKind::StructLit(name, _) => match name.kind {
                ExprKind::Ident(n) => {
                    if self.structs.contains(n) {
                        return Type::Named(n);
                    }
                    Type::Infer
                },
                _ => Type::Infer,
            },
            ExprKind::Call(f, call_args) => match f.kind {
                ExprKind::Ident(name) => {
                    if self.generic_funcs.contains(name) {
                        return self.peek_generic_call(name, call_args, e.pos);
                    }
                    match self.funcs.get(name) {
                        Option::Some(sig) => sig.ret,
                        Option::None => Type::Infer,
                    }
                },
                ExprKind::Field(obj, method) => {
                    var t = self.peek_type(obj);
                    var type_name = named_of(t);
                    match t {
                        Type::Ptr(inner) => { type_name = named_of(inner); },
                        _ => {},
                    }
                    match self.funcs.get(concat3(type_name, ".", method)) {
                        Option::Some(sig) => sig.ret,
                        Option::None => Type::Infer,
                    }
                },
                ExprKind::Path(ns, member) => match ns.kind {
                    ExprKind::Ident(type_name) => {
                        if self.enums.contains(type_name) {
                            return Type::Named(type_name);
                        }
                        match self.funcs.get(concat3(type_name, ".", member)) {
                            Option::Some(sig) => sig.ret,
                            Option::None => Type::Infer,
                        }
                    },
                    _ => Type::Infer,
                },
                _ => Type::Infer,
            },
            ExprKind::Path(ns, _) => match ns.kind {
                ExprKind::Ident(type_name) => {
                    if self.enums.contains(type_name) {
                        return Type::Named(type_name);
                    }
                    Type::Infer
                },
                _ => Type::Infer,
            },
            _ => Type::Infer,
        };
    }

    // The struct a value of type `t` (or a pointer to it) is, or null
    func struct_of(t: Type): &StructInfo {
        var name = named_of(t);
        match t {
            Type::Ptr(inner) => { name = named_of(inner); },
            _ => {},
        }
        var found = self.structs.get(name);
        if found.is_none() {
            return null;
        }
        return found.unwrap();
    }

    // Resolve the `ns` of `ns::member` to a concrete type name, instantiating
    // generics (explicitly or by inference from `args` and `expected`)
    func resolve_namespace(ns: &Expr, member: str, args: Vec<&Expr>, expected: Type): str {
        return match ns.kind {
            ExprKind::Turbofish(name, targs) => {
                var resolved: Vec<Type> = Vec::new();
                var i = 0;
                while i < targs.len {
                    resolved.push(self.resolve_type(targs.get(i), ns.pos));
                    i += 1;
                }
                named_of(self.instantiate_type(name, resolved, ns.pos))
            },
            ExprKind::Ident(name) => {
                match self.aliases.get(name) {
                    Option::Some(target) => { return named_of(self.resolve_type(target, ns.pos)); },
                    Option::None => {},
                }
                if !self.generic_structs.contains(name) && !self.generic_enums.contains(name) {
                    return name;
                }
                var params = self.type_params_of(name);
                var patterns: Vec<Type> = Vec::new();
                match self.generic_enums.get(name) {
                    Option::Some(decl) => {
                        var i = 0;
                        while i < decl.variants.len {
                            if decl.variants.get(i).name == member {
                                patterns = decl.variants.get(i).payload;
                            }
                            i += 1;
                        }
                    },
                    Option::None => {},
                }
                var methods = self.generic_methods.get(name).unwrap_or(Vec::new());
                var i = 0;
                while i < methods.len {
                    var m = methods.get(i);
                    if m.decl.name == member {
                        // Rename the impl's type parameters to the type's own
                        var own: Vec<Type> = Vec::new();
                        var j = 0;
                        while j < params.len {
                            own.push(Type::Named(params.get(j)));
                            j += 1;
                        }
                        j = 0;
                        while j < m.decl.params.len {
                            patterns.push(subst_type(m.decl.params.get(j).typ, m.params, own));
                            j += 1;
                        }
                    }
                    i += 1;
                }
                var targs = self.infer_type_args(name, params, expected, patterns, args, ns.pos);
                named_of(self.instantiate_type(name, targs, ns.pos))
            },
            _ => {
                self.fail(ns.pos, "expected a type name before `::`");
                ""
            },
        };
    }

    // -----------------------------------------------------------------------
    // Variables
    // -----------------------------------------------------------------------

    func push_scope() {
        self.scopes.push(Map::new());
    }

    func pop_scope() {
        self.scopes.pop();
    }

    func declare_var(name: str, typ: Type, mutable: bool): str {
        self.var_counter += 1;
        var ir = concat3(name, ".", int_to_str(self.var_counter));
        self.scopes.data[self.scopes.len - 1].insert(name, VarInfo { typ: typ, mutable: mutable, ir: ir, boxed: false });
        return ir;
    }

    // Declare a variable kept in a heap cell holding a `typ`
    func declare_boxed(name: str, typ: Type, mutable: bool): str {
        var ir = self.declare_var(name, typ, mutable);
        self.scopes.data[self.scopes.len - 1].insert(name, VarInfo { typ: typ, mutable: mutable, ir: ir, boxed: true });
        return ir;
    }

    func lookup_var(name: str): Option<VarInfo> {
        var i = self.scopes.len - 1;
        while i >= 0 {
            var found = self.scopes.get(i).get(name);
            if found.is_some() {
                return found;
            }
            i -= 1;
        }
        return Option::None;
    }

    // -----------------------------------------------------------------------
    // Functions and statements
    // -----------------------------------------------------------------------

    func check_function(f: &FuncDecl) {
        self.scopes = Vec::new();
        self.push_scope();
        self.var_counter = 0;
        self.loop_depth = 0;
        f.params = self.resolve_params(f.params, f.pos);
        f.ret = self.resolve_type(f.ret, f.pos);
        self.current_return = f.ret;
        self.captured = captured_names(f.body);
        var i = 0;
        while i < f.params.len {
            var p = f.params.get(i);
            self.scopes.data[self.scopes.len - 1].insert(p.name, VarInfo { typ: p.typ, mutable: false, ir: concat("p.", p.name), boxed: false });
            i += 1;
        }
        self.check_block(f.body);
        if is_never(f.ret) && !always_returns(f.body) {
            self.fail(f.pos, concat3("function `", f.name, "` returns `!` but can reach the end of its body"));
        }
        if !is_void(f.ret) && !always_returns(f.body) {
            self.fail(f.pos, concat3("function `", f.name, "` might not return a value"));
        }
        self.out_funcs.push(f);
    }

    func check_block(body: Vec<&Stmt>) {
        self.push_scope();
        var i = 0;
        while i < body.len {
            self.check_stmt(body.get(i));
            i += 1;
        }
        self.pop_scope();
    }

    func check_stmt(s: &Stmt) {
        match s.kind {
            StmtKind::VarDecl(name, mutable, annotation, value) => {
                var declared = self.resolve_type(annotation, s.pos);
                var t = self.check_expr(value, declared);
                if is_void(t) {
                    self.fail(value.pos, "this expression has no value");
                }
                if !is_infer(declared) {
                    self.expect_assignable(declared, t, value);
                    t = declared;
                }
                if mutable && self.captured.contains(name) {
                    // A closure may capture this variable, so it lives in a heap cell
                    var cell = new_expr(ExprKind::NewCell(value), value.pos);
                    cell.typ = Type::Ptr(t);
                    value.typ = t;
                    s.kind = StmtKind::VarDecl(name, mutable, annotation, cell);
                    s.typ = Type::Ptr(t);
                    s.ir_name = self.declare_boxed(name, t, mutable);
                } else {
                    s.typ = t;
                    s.ir_name = self.declare_var(name, t, mutable);
                }
            },
            StmtKind::Assign(target, value) => {
                match target.kind {
                    ExprKind::Ident(name) => {
                        match self.lookup_var(name) {
                            Option::Some(info) => {
                                if !info.mutable {
                                    self.fail(target.pos, "cannot assign to a constant or parameter");
                                }
                            },
                            Option::None => {},
                        }
                    },
                    _ => {},
                }
                var t = self.check_expr(target, Type::Infer);
                match target.kind {
                    ExprKind::Local(_) => {},
                    ExprKind::FieldAt(_, _) => {},
                    ExprKind::Index(_, _) => {},
                    ExprKind::Deref(_) => {},
                    _ => { self.fail(target.pos, "cannot assign to this expression"); },
                }
                var vt = self.check_expr(value, t);
                self.expect_assignable(t, vt, value);
            },
            StmtKind::ExprStmt(e) => { self.check_expr(e, Type::Infer); },
            StmtKind::Return(value) => {
                if is_infer(self.current_return) {
                    // A closure without a declared return type returns what its first `return` does
                    match value {
                        Option::None => { self.current_return = Type::Void; },
                        Option::Some(v) => {
                            var t = self.check_expr(v, Type::Infer);
                            if is_void(t) {
                                self.fail(v.pos, "this expression has no value to return");
                            }
                            self.current_return = t;
                        },
                    }
                    return;
                }
                if is_never(self.current_return) {
                    self.fail(s.pos, "a function returning `!` can't return");
                }
                match value {
                    Option::None => {
                        if !is_void(self.current_return) {
                            self.fail(s.pos, concat("missing return value of type ", mangle(self.current_return)));
                        }
                    },
                    Option::Some(v) => {
                        if is_void(self.current_return) {
                            self.fail(s.pos, "this function doesn't return a value");
                        }
                        var t = self.check_expr(v, self.current_return);
                        self.expect_assignable(self.current_return, t, v);
                    },
                }
            },
            StmtKind::If(cond, then_body, else_body) => {
                self.check_condition(cond);
                self.check_block(then_body);
                self.check_block(else_body);
            },
            StmtKind::Loop(cond, body) => {
                match cond {
                    Option::Some(c) => { self.check_condition(c); },
                    Option::None => {},
                }
                self.loop_depth += 1;
                self.check_block(body);
                self.loop_depth -= 1;
            },
            StmtKind::ForIn(name, iterable, end, inclusive, body) => {
                var block = self.desugar_for_in(s.pos, name, iterable, end, inclusive, body);
                self.check_expr(block, Type::Infer);
                s.kind = StmtKind::ExprStmt(block);
            },
            StmtKind::CompoundAssign(op, target, value) => {
                match target.kind {
                    ExprKind::Ident(name) => {
                        match self.lookup_var(name) {
                            Option::Some(info) => {
                                if !info.mutable {
                                    self.fail(target.pos, "cannot assign to a constant or parameter");
                                }
                            },
                            Option::None => {},
                        }
                    },
                    _ => {},
                }
                // Checked as `target op value`, which must fit back into the target
                var combined = new_expr(ExprKind::Binary(op, target, value), s.pos);
                var t = self.check_binary(combined, op, target, value, Type::Infer);
                match combined.kind {
                    // `s += t` on strings became a call
                    ExprKind::CallFn(_, _) => {
                        combined.typ = t;
                        s.kind = StmtKind::Assign(target, combined);
                    },
                    _ => {},
                }
                match target.kind {
                    ExprKind::Local(_) => {},
                    ExprKind::FieldAt(_, _) => {},
                    ExprKind::Index(_, _) => {},
                    ExprKind::Deref(_) => {},
                    _ => { self.fail(target.pos, "cannot assign to this expression"); },
                }
                self.expect_assignable(target.typ, t, value);
            },
            StmtKind::Destructure(names, mutable, value) => {
                // `var (a, b) = value;` becomes `const $tuple = value; var a = $tuple.0; var b = $tuple.1;`
                var stmts: Vec<&Stmt> = Vec::new();
                var temp = new_stmt(StmtKind::VarDecl("$tuple", false, Type::Infer, value), s.pos);
                self.check_stmt(temp);
                stmts.push(temp);
                var items: Vec<Type> = match self.tuple_items(temp.typ) {
                    Option::Some(items) => items,
                    Option::None => {
                        self.fail(value.pos, concat3("can't destructure a value of type ", mangle(temp.typ), "; it isn't a tuple"));
                        Vec::new()
                    },
                };
                if items.len != names.len {
                    self.fail(s.pos, concat3("this tuple has ", int_to_str(items.len), concat3(" elements, but ", int_to_str(names.len), " names are given")));
                }
                var i = 0;
                while i < names.len {
                    if names.get(i) != "_" {
                        var element = new_expr(ExprKind::Field(new_expr(ExprKind::Ident("$tuple"), s.pos), int_to_str(i)), s.pos);
                        var decl = new_stmt(StmtKind::VarDecl(names.get(i), mutable, Type::Infer, element), s.pos);
                        self.check_stmt(decl);
                        stmts.push(decl);
                    }
                    i += 1;
                }
                s.kind = StmtKind::Group(stmts);
            },
            StmtKind::Group(stmts) => {
                var i = 0;
                while i < stmts.len {
                    self.check_stmt(stmts.get(i));
                    i += 1;
                }
            },
            StmtKind::Break => {
                if self.loop_depth == 0 {
                    self.fail(s.pos, "`break` outside a loop");
                }
            },
            StmtKind::Continue => {
                if self.loop_depth == 0 {
                    self.fail(s.pos, "`continue` outside a loop");
                }
            },
        }
    }

    // `for name in ...` becomes a loop over an index:
    //
    //   var $items = iterable; const $length = ...; var $index = 0;
    //   while $index < $length { var name = $items.get($index); $index += 1; body }
    //
    // (the index advances before the body, so `continue` works). Ranges count
    // from start to end directly.
    func desugar_for_in(pos: int, name: str, iterable: &Expr, end: Option<&Expr>, inclusive: bool, body: Vec<&Stmt>): &Expr {
        var stmts: Vec<&Stmt> = Vec::new();
        var condition: &Expr = null;
        var element: &Expr = null;
        var index = new_expr(ExprKind::Ident("$index"), pos);
        match end {
            Option::Some(limit) => {
                stmts.push(new_stmt(StmtKind::VarDecl("$index", true, Type::Infer, iterable), pos));
                stmts.push(new_stmt(StmtKind::VarDecl("$end", false, Type::Infer, limit), pos));
                var op = BinOp::Lt;
                if inclusive {
                    op = BinOp::Le;
                }
                condition = new_expr(ExprKind::Binary(op, index, new_expr(ExprKind::Ident("$end"), pos)), pos);
                element = new_expr(ExprKind::Ident("$index"), pos);
            },
            Option::None => {
                // Work out how to iterate from the type (checking a copy of the expression)
                var copier = Copier { params: Vec::new(), args: Vec::new() };
                var t = self.check_expr(copier.expr(iterable), Type::Infer);
                var items = new_expr(ExprKind::Ident("$items"), pos);
                var length: &Expr = null;
                var is_array = false;
                match t {
                    Type::Array(_, size) => {
                        if size < 0 {
                            self.fail(iterable.pos, "can't iterate over an array of unknown size");
                        }
                        length = new_expr(ExprKind::IntLit(size), pos);
                        is_array = true;
                    },
                    Type::Str => {
                        var args: Vec<&Expr> = Vec::new();
                        args.push(items);
                        length = new_expr(ExprKind::Call(new_expr(ExprKind::Ident("strlen"), pos), args), pos);
                        is_array = true;
                    },
                    _ => {
                        var type_name = named_of(t);
                        match t {
                            Type::Ptr(inner) => { type_name = named_of(inner); },
                            _ => {},
                        }
                        if !self.funcs.contains(concat(type_name, ".length")) || !self.funcs.contains(concat(type_name, ".get")) {
                            self.fail(iterable.pos, concat3("can't iterate over ", mangle(t), ": it needs length() and get() methods"));
                        }
                        length = new_expr(ExprKind::Call(new_expr(ExprKind::Field(items, "length"), pos), Vec::new()), pos);
                    },
                }
                if is_array {
                    element = new_expr(ExprKind::Index(new_expr(ExprKind::Ident("$items"), pos), index), pos);
                } else {
                    var args: Vec<&Expr> = Vec::new();
                    args.push(index);
                    element = new_expr(ExprKind::Call(new_expr(ExprKind::Field(new_expr(ExprKind::Ident("$items"), pos), "get"), pos), args), pos);
                }
                stmts.push(new_stmt(StmtKind::VarDecl("$items", false, Type::Infer, iterable), pos));
                stmts.push(new_stmt(StmtKind::VarDecl("$length", false, Type::Infer, length), pos));
                stmts.push(new_stmt(StmtKind::VarDecl("$index", true, Type::Infer, new_expr(ExprKind::IntLit(0), pos)), pos));
                condition = new_expr(ExprKind::Binary(BinOp::Lt, new_expr(ExprKind::Ident("$index"), pos), new_expr(ExprKind::Ident("$length"), pos)), pos);
            },
        }
        var loop_body: Vec<&Stmt> = Vec::new();
        loop_body.push(new_stmt(StmtKind::VarDecl(name, true, Type::Infer, element), pos));
        var one = new_expr(ExprKind::IntLit(1), pos);
        loop_body.push(new_stmt(StmtKind::CompoundAssign(BinOp::Add, new_expr(ExprKind::Ident("$index"), pos), one), pos));
        var i = 0;
        while i < body.len {
            loop_body.push(body.get(i));
            i += 1;
        }
        stmts.push(new_stmt(StmtKind::Loop(Option::Some(condition), loop_body), pos));
        return new_expr(ExprKind::Block(stmts, Option::None), pos);
    }

    func check_condition(cond: &Expr) {
        var t = self.check_expr(cond, Type::Bool);
        if !is_bool(t) {
            self.fail(cond.pos, concat("condition must be a bool, found ", mangle(t)));
        }
    }

    func expect_assignable(expected: Type, got: Type, e: &Expr) {
        if !assignable(expected, got, e) {
            self.fail(e.pos, concat3("expected ", mangle(expected), concat(", found ", mangle(got))));
        }
    }

    // -----------------------------------------------------------------------
    // Expressions
    // -----------------------------------------------------------------------

    // Check `e`, which should have type `expected` if that isn't Infer, and
    // return its type
    func check_expr(e: &Expr, expected: Type): Type {
        var t = self.check_expr_kind(e, expected);
        e.typ = t;
        return t;
    }

    func check_expr_kind(e: &Expr, expected: Type): Type {
        match e.kind {
            ExprKind::IntLit(_) => {
                if is_integer(expected) {
                    return expected;
                }
                return Type::Int;
            },
            ExprKind::FloatLit(_) => {
                if is_float(expected) {
                    return expected;
                }
                return Type::Float;
            },
            ExprKind::BoolLit(_) => { return Type::Bool; },
            ExprKind::StrLit(_) => { return Type::Str; },
            ExprKind::Interpolate(parts) => { return self.check_interpolation(e, parts); },
            ExprKind::Tuple(items) => { return self.check_tuple(e, items, expected); },
            ExprKind::Try(inner) => { return self.check_try(e, inner); },
            ExprKind::MethodTurbofish(_, _, _) => {
                self.fail(e.pos, "type arguments on a method must be followed by a call");
                return Type::Infer;
            },
            ExprKind::Null => { return Type::Str; },
            ExprKind::Ident(name) => {
                match self.lookup_var(name) {
                    Option::Some(v) => {
                        if v.boxed {
                            // Read through the variable's cell
                            var cell = new_expr(ExprKind::Local(v.ir), e.pos);
                            cell.typ = Type::Ptr(v.typ);
                            e.kind = ExprKind::Deref(cell);
                            return v.typ;
                        }
                        e.kind = ExprKind::Local(v.ir);
                        return v.typ;
                    },
                    Option::None => {},
                }
                match self.globals.get(name) {
                    Option::Some(t) => {
                        e.kind = ExprKind::Global(name);
                        return t;
                    },
                    Option::None => {},
                }
                match self.funcs.get(name) {
                    Option::Some(sig) => {
                        if !sig.is_varargs && !is_intrinsic(name) {
                            return self.function_value(e, sig);
                        }
                    },
                    Option::None => {},
                }
                self.fail(e.pos, concat3("unknown variable `", name, "`"));
                return Type::Infer;
            },
            ExprKind::Binary(op, l, r) => { return self.check_binary(e, op, l, r, expected); },
            ExprKind::Unary(op, x) => {
                if op == UnOp::Not {
                    var t = self.check_expr(x, Type::Bool);
                    if !is_bool(t) {
                        self.fail(x.pos, "`!` needs a bool");
                    }
                    return Type::Bool;
                }
                var t = self.check_expr(x, expected);
                if op == UnOp::Neg && !is_integer(t) && !is_float(t) {
                    self.fail(x.pos, "`-` needs a number");
                }
                if op == UnOp::BitNot && !is_integer(t) {
                    self.fail(x.pos, "`~` needs an integer");
                }
                return t;
            },
            ExprKind::Deref(x) => {
                if !is_infer(e.typ) {
                    // Created by the checker (a method receiver), already checked
                    return e.typ;
                }
                var t = self.check_expr(x, Type::Infer);
                return match t {
                    Type::Ptr(inner) => inner,
                    Type::Str => Type::SInt(8),
                    _ => {
                        self.fail(e.pos, concat("cannot dereference a value of type ", mangle(t)));
                        Type::Infer
                    },
                };
            },
            ExprKind::AddrOf(x) => {
                var inner_expected = match expected {
                    Type::Ptr(inner) => inner,
                    _ => Type::Infer,
                };
                return Type::Ptr(self.check_expr(x, inner_expected));
            },
            ExprKind::Call(callee, args) => { return self.check_call(e, callee, args, expected); },
            ExprKind::Index(a, i) => {
                var at = self.check_expr(a, Type::Infer);
                var it = self.check_expr(i, Type::Int);
                if !is_integer(it) {
                    self.fail(i.pos, "index must be an integer");
                }
                return match at {
                    Type::Ptr(inner) => inner,
                    Type::Array(inner, _) => inner,
                    Type::Str => Type::SInt(8),
                    _ => {
                        self.fail(a.pos, concat("cannot index a value of type ", mangle(at)));
                        Type::Infer
                    },
                };
            },
            ExprKind::Field(obj, name) => {
                var t = self.check_expr(obj, Type::Infer);
                var info = self.struct_of(t);
                if info == null {
                    self.fail(e.pos, concat3("type ", mangle(t), concat3(" has no field `", name, "`")));
                }
                var i = 0;
                while i < info.fields.len {
                    if info.fields.get(i).name == name {
                        e.kind = ExprKind::FieldAt(obj, i);
                        return info.fields.get(i).typ;
                    }
                    i += 1;
                }
                self.fail(e.pos, concat3(info.name, " has no field ", name));
                return Type::Infer;
            },
            ExprKind::Path(ns, member) => {
                var type_name = self.resolve_namespace(ns, member, Vec::new(), expected);
                var info = self.enum_named(type_name);
                if info == null {
                    self.fail(e.pos, concat3("`", type_name, "` is not an enum"));
                }
                var tag = self.variant_tag(info, member, e.pos);
                if info.payloads.get(tag).len > 0 {
                    self.fail(e.pos, concat3("variant `", member, "` needs a payload"));
                }
                e.kind = ExprKind::EnumValue(type_name, tag, Vec::new());
                return Type::Named(type_name);
            },
            ExprKind::Turbofish(name, targs) => {
                if self.generic_funcs.contains(name) {
                    // A generic function instance used as a value: `max::<int>`
                    var resolved: Vec<Type> = Vec::new();
                    var i = 0;
                    while i < targs.len {
                        resolved.push(self.resolve_type(targs.get(i), e.pos));
                        i += 1;
                    }
                    var symbol = self.instantiate_function(name, resolved, e.pos);
                    return self.function_value(e, self.funcs.get(symbol).unwrap());
                }
                self.fail(e.pos, "type arguments must be followed by a call, `::` or `{`");
                return Type::Infer;
            },
            ExprKind::Closure(params, ret, body) => { return self.check_closure(e, params, ret, body, expected); },
            ExprKind::StructLit(name, fields) => { return self.check_struct_lit(e, name, fields, expected); },
            ExprKind::ArrayLit(items) => {
                if items.len == 0 {
                    self.fail(e.pos, "empty array literals are not supported");
                }
                var elem_expected = match expected {
                    Type::Array(inner, _) => inner,
                    _ => Type::Infer,
                };
                var first = self.check_expr(items.get(0), elem_expected);
                var i = 1;
                while i < items.len {
                    var t = self.check_expr(items.get(i), first);
                    self.expect_assignable(first, t, items.get(i));
                    i += 1;
                }
                return Type::Array(first, items.len);
            },
            ExprKind::Cast(x, t) => {
                self.check_expr(x, Type::Infer);
                var target = self.resolve_type(t, e.pos);
                e.kind = ExprKind::Cast(x, target);
                return target;
            },
            ExprKind::SizeOf(t) => {
                var target = self.resolve_type(t, e.pos);
                e.kind = ExprKind::SizeOf(target);
                return Type::Int;
            },
            ExprKind::Alloc(x) => {
                if !is_struct_lit(x) {
                    self.fail(e.pos, "alloc needs a struct literal");
                }
                var inner_expected = match expected {
                    Type::Ptr(inner) => inner,
                    _ => Type::Infer,
                };
                return Type::Ptr(self.check_expr(x, inner_expected));
            },
            ExprKind::AllocIn(x, arena) => {
                if !is_struct_lit(x) {
                    self.fail(e.pos, "alloc needs a struct literal");
                }
                var arena_type = self.check_expr(arena, Type::Infer);
                var is_arena = named_of(arena_type) == "Arena";
                match arena_type {
                    Type::Ptr(inner) => { is_arena = named_of(inner) == "Arena"; },
                    _ => {
                        // Pass the arena by pointer so allocation updates it
                        if is_arena {
                            var address = new_expr(ExprKind::AddrOf(arena), arena.pos);
                            address.typ = Type::Ptr(arena_type);
                            e.kind = ExprKind::AllocIn(x, address);
                        }
                    },
                }
                if !is_arena {
                    self.fail(arena.pos, concat("expected an Arena, found ", mangle(arena_type)));
                }
                self.instantiate_method("Arena", "allocate");
                var inner_expected = match expected {
                    Type::Ptr(inner) => inner,
                    _ => Type::Infer,
                };
                return Type::Ptr(self.check_expr(x, inner_expected));
            },
            ExprKind::Match(scrutinee, arms) => { return self.check_match(e, scrutinee, arms, expected); },
            ExprKind::Block(stmts, value) => {
                self.push_scope();
                var i = 0;
                while i < stmts.len {
                    self.check_stmt(stmts.get(i));
                    i += 1;
                }
                var t = match value {
                    Option::Some(v) => self.check_expr(v, expected),
                    Option::None => Type::Void,
                };
                self.pop_scope();
                return t;
            },
            _ => {
                // Already resolved (shared nodes such as `[x; n]` elements)
                return e.typ;
            },
        }
    }

    // `value?` on an Option or Result becomes
    //
    //   match value { Option::Some(v) => v, Option::None => { return Option::None; } }
    //   match value { Result::Ok(v) => v, Result::Err(e) => { return Result::Err(e); } }
    //
    // which needs the function to return an Option, or a Result with the same error type
    func check_try(e: &Expr, inner: &Expr): Type {
        var copier = Copier { params: Vec::new(), args: Vec::new() };
        var t = self.check_expr(copier.expr(inner), Type::Infer);
        var kind = "";
        var args: Vec<Type> = Vec::new();
        match self.instances.get(named_of(t)) {
            Option::Some(inst) => {
                if inst.generic == "Option" || inst.generic == "Result" {
                    kind = inst.generic;
                    args = inst.args;
                }
            },
            Option::None => {},
        }
        if kind == "" {
            self.fail(inner.pos, concat("`?` needs an Option or a Result, not ", mangle(t)));
        }
        var returns_kind = "";
        var return_args: Vec<Type> = Vec::new();
        match self.instances.get(named_of(self.current_return)) {
            Option::Some(inst) => {
                returns_kind = inst.generic;
                return_args = inst.args;
            },
            Option::None => {},
        }
        if returns_kind != kind {
            var wanted = "an Option";
            if kind == "Result" {
                wanted = "a Result";
            }
            self.fail(e.pos, concat3("`?` on ", mangle(t), concat(" can only be used in a function returning ", wanted)));
        }
        if kind == "Result" && !type_eq(args.get(1), return_args.get(1)) {
            self.fail(e.pos, concat3("`?` would return an error of type ", mangle(args.get(1)), concat(", but this function's errors are ", mangle(return_args.get(1)))));
        }

        var value_bindings: Vec<str> = Vec::new();
        value_bindings.push("$try");
        var arms: Vec<&MatchArm> = Vec::new();
        var failure: &Expr = null;
        if kind == "Option" {
            arms.push(new_arm(Pattern::Variant("Option", "Some", value_bindings), new_expr(ExprKind::Ident("$try"), e.pos), e.pos));
            failure = new_expr(ExprKind::Path(new_expr(ExprKind::Ident("Option"), e.pos), "None"), e.pos);
            arms.push(new_arm(Pattern::Variant("Option", "None", Vec::new()), early_return(failure, e.pos), e.pos));
        } else {
            arms.push(new_arm(Pattern::Variant("Result", "Ok", value_bindings), new_expr(ExprKind::Ident("$try"), e.pos), e.pos));
            var error_bindings: Vec<str> = Vec::new();
            error_bindings.push("$error");
            var call_args: Vec<&Expr> = Vec::new();
            call_args.push(new_expr(ExprKind::Ident("$error"), e.pos));
            failure = new_expr(ExprKind::Call(new_expr(ExprKind::Path(new_expr(ExprKind::Ident("Result"), e.pos), "Err"), e.pos), call_args), e.pos);
            arms.push(new_arm(Pattern::Variant("Result", "Err", error_bindings), early_return(failure, e.pos), e.pos));
        }
        var m = new_expr(ExprKind::Match(inner, arms), e.pos);
        var result = self.check_expr(m, Type::Infer);
        e.kind = m.kind;
        return result;
    }

    // `(a, b)` becomes a value of the tuple's struct
    func check_tuple(e: &Expr, items: Vec<&Expr>, expected: Type): Type {
        var expected_items: Vec<Type> = Vec::new();
        match self.tuple_items(expected) {
            Option::Some(types) => {
                if types.len == items.len {
                    expected_items = types;
                }
            },
            Option::None => {},
        }
        var types: Vec<Type> = Vec::new();
        var i = 0;
        while i < items.len {
            var hint = Type::Infer;
            if expected_items.len > 0 {
                hint = expected_items.get(i);
            }
            var t = self.check_expr(items.get(i), hint);
            if is_void(t) {
                self.fail(items.get(i).pos, "this expression has no value");
            }
            types.push(t);
            i += 1;
        }
        var t = self.instantiate_tuple(types);
        e.kind = ExprKind::StructValue(named_of(t), items);
        return t;
    }

    // `"a ${x} b"` joins its parts with str_concat, converting each
    // interpolated value to a string first
    func check_interpolation(e: &Expr, parts: Vec<&Expr>): Type {
        var joined: &Expr = null;
        var i = 0;
        while i < parts.len {
            var part = parts.get(i);
            // Work out the conversion from the type (checking a copy of the part)
            var copier = Copier { params: Vec::new(), args: Vec::new() };
            var t = self.check_expr(copier.expr(part), Type::Infer);
            var converted = part;
            if type_eq(t, Type::Str) {
                converted = part;
            } else if is_bool(t) {
                converted = call_named("str_from_bool", part, part.pos);
            } else if is_integer(t) {
                converted = call_named("str_from_int", part, part.pos);
            } else if is_float(t) {
                converted = call_named("str_from_float", part, part.pos);
            } else {
                var type_name = named_of(t);
                match t {
                    Type::Ptr(inner) => { type_name = named_of(inner); },
                    _ => {},
                }
                if !self.funcs.contains(concat(type_name, ".to_str")) {
                    self.fail(part.pos, concat3("can't interpolate a value of type ", mangle(t), "; it needs a `to_str()` method"));
                }
                converted = new_expr(ExprKind::Call(new_expr(ExprKind::Field(part, "to_str"), part.pos), Vec::new()), part.pos);
            }
            if joined == null {
                joined = converted;
            } else {
                var args: Vec<&Expr> = Vec::new();
                args.push(joined);
                args.push(converted);
                joined = new_expr(ExprKind::Call(new_expr(ExprKind::Ident("str_concat"), e.pos), args), e.pos);
            }
            i += 1;
        }
        var t = self.check_expr(joined, Type::Infer);
        if !type_eq(t, Type::Str) {
            self.fail(e.pos, concat("`to_str()` must return str, not ", mangle(t)));
        }
        e.kind = joined.kind;
        return t;
    }

    func check_binary(e: &Expr, op: BinOp, l: &Expr, r: &Expr, expected: Type): Type {
        if op == BinOp::And || op == BinOp::Or {
            var lt = self.check_expr(l, Type::Bool);
            var rt = self.check_expr(r, Type::Bool);
            if !is_bool(lt) || !is_bool(rt) {
                self.fail(e.pos, "`&&` and `||` need bools");
            }
            return Type::Bool;
        }
        var arithmetic = op == BinOp::Add || op == BinOp::Sub || op == BinOp::Mul || op == BinOp::Div || op == BinOp::Mod;
        var bitwise = op == BinOp::BitAnd || op == BinOp::BitOr || op == BinOp::BitXor || op == BinOp::Shl || op == BinOp::Shr;

        // Integer literals take the type of the other operand
        var lt = Type::Infer;
        var rt = Type::Infer;
        var hint = Type::Infer;
        if arithmetic || bitwise {
            hint = expected;
        }
        if is_int_literal(l) && !is_int_literal(r) {
            rt = self.check_expr(r, hint);
            lt = self.check_expr(l, rt);
        } else {
            lt = self.check_expr(l, hint);
            rt = self.check_expr(r, lt);
        }

        // `==` and `<` on types implementing Eq and Ord call their methods
        var plain_enum = self.enum_named(named_of(lt)) != null && !self.enum_named(named_of(lt)).boxed;
        if type_eq(lt, rt) && named_of(lt) != "" && !plain_enum {
            var eq = (op == BinOp::Eq || op == BinOp::Ne) && self.implements(lt, "Eq");
            var ord = (op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge) && self.implements(lt, "Ord");
            if eq || ord {
                var method = "equals";
                if ord {
                    method = "compare";
                }
                var method_args: Vec<&Expr> = Vec::new();
                method_args.push(r);
                var call = new_expr(ExprKind::Call(new_expr(ExprKind::Field(l, method), e.pos), method_args), e.pos);
                self.check_expr(call, Type::Infer);
                if op == BinOp::Eq {
                    e.kind = call.kind;
                } else if op == BinOp::Ne {
                    e.kind = ExprKind::Unary(UnOp::Not, call);
                } else {
                    var zero = new_expr(ExprKind::IntLit(0), e.pos);
                    zero.typ = Type::Int;
                    e.kind = ExprKind::Binary(op, call, zero);
                }
                return Type::Bool;
            }
        }

        // Operators on strings compare and join contents, via stdlib helpers
        if type_eq(lt, Type::Str) && type_eq(rt, Type::Str) && !is_null_expr(l) && !is_null_expr(r) {
            if op == BinOp::Add || op == BinOp::Eq || op == BinOp::Ne || op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge {
                return string_op(e, op, l, r);
            }
        }

        if arithmetic || bitwise {
            var ok = is_integer(lt) || (arithmetic && is_float(lt));
            if !ok {
                self.fail(e.pos, concat("cannot use this operator on ", mangle(lt)));
            }
            if !type_eq(lt, rt) {
                self.fail(e.pos, concat3("mismatched types ", mangle(lt), concat(" and ", mangle(rt))));
            }
            return lt;
        }

        // Comparisons
        var comparable = is_integer(lt) || is_float(lt) || is_pointer_like(lt);
        if op == BinOp::Eq || op == BinOp::Ne {
            if is_bool(lt) {
                comparable = true;
            }
            var info = self.enum_named(named_of(lt));
            if info != null && !info.boxed {
                comparable = true;
            }
        }
        if !comparable {
            self.fail(e.pos, concat("cannot compare values of type ", mangle(lt)));
        }
        var same = type_eq(lt, rt) || (is_pointer_like(lt) && is_pointer_like(rt)) || (is_integer(lt) && is_integer(rt));
        if !same {
            self.fail(e.pos, concat3("mismatched types ", mangle(lt), concat(" and ", mangle(rt))));
        }
        return Type::Bool;
    }

    func enum_named(name: str): &EnumInfo {
        var found = self.enums.get(name);
        if found.is_none() {
            return null;
        }
        return found.unwrap();
    }

    // The signature for `symbol`, or an error mentioning `what`
    func sig_for(symbol: str, what: str, pos: int): &FuncSig {
        var found = self.funcs.get(symbol);
        if found.is_none() {
            self.fail(pos, what);
        }
        return found.unwrap();
    }

    func variant_tag(info: &EnumInfo, variant: str, pos: int): int {
        var i = 0;
        while i < info.variants.len {
            if info.variants.get(i) == variant {
                return i;
            }
            i += 1;
        }
        self.fail(pos, concat3(info.name, " has no variant ", variant));
        return 0;
    }

    func check_args(sig: &FuncSig, args: Vec<&Expr>, first_param: int, pos: int) {
        var expected_count = sig.params.len - first_param;
        if args.len < expected_count || (!sig.is_varargs && args.len != expected_count) {
            self.fail(pos, concat3("`", sig.symbol, concat3("` takes ", int_to_str(expected_count), concat(" arguments, got ", int_to_str(args.len)))));
        }
        var i = 0;
        while i < args.len {
            var arg = args.get(i);
            if first_param + i < sig.params.len {
                var param = sig.params.get(first_param + i);
                var t = self.check_expr(arg, param);
                self.expect_assignable(param, t, arg);
            } else {
                var t = self.check_expr(arg, Type::Infer);
                if is_void(t) {
                    self.fail(arg.pos, "this expression has no value");
                }
            }
            i += 1;
        }
    }

    func check_call(e: &Expr, callee: &Expr, args: Vec<&Expr>, expected: Type): Type {
        match callee.kind {
            ExprKind::Ident(name) => {
                if self.lookup_var(name).is_some() {
                    // A variable holding a function
                    return self.check_closure_call(e, callee, args);
                }
                var symbol = name;
                if self.generic_funcs.contains(name) && self.lookup_var(name).is_none() {
                    var decl = self.generic_funcs.get(name).unwrap();
                    var patterns: Vec<Type> = Vec::new();
                    var i = 0;
                    while i < decl.params.len {
                        patterns.push(decl.params.get(i).typ);
                        i += 1;
                    }
                    var targs = self.infer_type_args(name, decl.type_params, Type::Infer, patterns, args, e.pos);
                    symbol = self.instantiate_function(name, targs, e.pos);
                }
                var sig = self.sig_for(symbol, concat3("unknown function `", name, "`"), callee.pos);
                self.check_args(sig, args, 0, e.pos);
                e.kind = ExprKind::CallFn(self.managed_allocator(sig.symbol, args), args);
                return sig.ret;
            },
            ExprKind::Turbofish(name, targs) => {
                if !self.generic_funcs.contains(name) {
                    self.fail(callee.pos, concat3("`", name, "` is not a generic function"));
                }
                var resolved: Vec<Type> = Vec::new();
                var i = 0;
                while i < targs.len {
                    resolved.push(self.resolve_type(targs.get(i), callee.pos));
                    i += 1;
                }
                var sig = self.funcs.get(self.instantiate_function(name, resolved, e.pos)).unwrap();
                self.check_args(sig, args, 0, e.pos);
                e.kind = ExprKind::CallFn(sig.symbol, args);
                return sig.ret;
            },
            ExprKind::Path(ns, member) => {
                var type_name = self.resolve_namespace(ns, member, args, expected);
                var info = self.enum_named(type_name);
                if info != null && contains_str(info.variants, member) {
                    // Constructing an enum variant with a payload
                    var tag = self.variant_tag(info, member, e.pos);
                    var payload = info.payloads.get(tag);
                    if payload.len != args.len {
                        self.fail(e.pos, concat3("variant `", member, concat3("` takes ", int_to_str(payload.len), " values")));
                    }
                    var i = 0;
                    while i < args.len {
                        var t = self.check_expr(args.get(i), payload.get(i));
                        self.expect_assignable(payload.get(i), t, args.get(i));
                        i += 1;
                    }
                    e.kind = ExprKind::EnumValue(type_name, tag, args);
                    return Type::Named(type_name);
                }
                self.instantiate_method(type_name, member);
                var symbol = concat3(type_name, ".", member);
                var generic_symbol = self.generic_method(type_name, member, Vec::new(), false, false, args, callee.pos);
                if generic_symbol != "" {
                    symbol = generic_symbol;
                }
                var sig = self.sig_for(symbol, concat3("unknown function `", concat3(type_name, "::", member), "`"), callee.pos);
                self.check_args(sig, args, 0, e.pos);
                e.kind = ExprKind::CallFn(symbol, args);
                return sig.ret;
            },
            ExprKind::Field(obj, method) => { return self.check_method_call(e, callee, obj, method, Vec::new(), false, args); },
            ExprKind::MethodTurbofish(obj, method, targs) => { return self.check_method_call(e, callee, obj, method, targs, true, args); },
            // Any other expression must give a function value
            _ => { return self.check_closure_call(e, callee, args); },
        }
    }

    // `obj.method(args)`, or `obj.method::<targs>(args)` when `explicit`
    func check_method_call(e: &Expr, callee: &Expr, obj: &Expr, method: str, targs: Vec<Type>, explicit: bool, args: Vec<&Expr>): Type {
        var t = self.check_expr(obj, Type::Infer);
        var receiver_is_ptr = false;
        var type_name = named_of(t);
        match t {
            Type::Ptr(inner) => {
                receiver_is_ptr = true;
                type_name = named_of(inner);
            },
            // Methods on built-in types, such as `extend int { ... }`
            _ => { type_name = type_key(t); },
        }
        self.instantiate_method(type_name, method);
        var symbol = concat3(type_name, ".", method);
        if !explicit && !self.funcs.contains(symbol) && self.has_func_field(t, method) {
            // A field holding a function
            return self.check_closure_call(e, new_expr(ExprKind::Field(obj, method), callee.pos), args);
        }
        var generic_symbol = self.generic_method(type_name, method, targs, explicit, true, args, callee.pos);
        if generic_symbol != "" {
            symbol = generic_symbol;
        }
        var sig = self.sig_for(symbol, concat3("no method `", method, concat("` on ", mangle(t))), callee.pos);
        if !sig.is_method {
            self.fail(callee.pos, concat3("`", method, concat3("` doesn't use `self`, so it's a static function: call it as ", type_name, concat3("::", method, "()"))));
        }
        // Pass the receiver by pointer or by value, as the method wants
        var receiver = obj;
        var self_is_ptr = match sig.params.get(0) {
            Type::Ptr(_) => true,
            _ => false,
        };
        if self_is_ptr && !receiver_is_ptr {
            receiver = new_expr(ExprKind::AddrOf(obj), obj.pos);
            receiver.typ = Type::Ptr(t);
        } else if !self_is_ptr && receiver_is_ptr {
            receiver = new_expr(ExprKind::Deref(obj), obj.pos);
            receiver.typ = Type::Named(type_name);
        }
        self.check_args(sig, args, 1, e.pos);
        var all_args: Vec<&Expr> = Vec::new();
        all_args.push(receiver);
        var i = 0;
        while i < args.len {
            all_args.push(args.get(i));
            i += 1;
        }
        e.kind = ExprKind::CallFn(symbol, all_args);
        return sig.ret;
    }

    // Is `name` a field of `t`'s struct holding a function?
    func has_func_field(t: Type, name: str): bool {
        var info = self.struct_of(t);
        if info == null {
            return false;
        }
        var i = 0;
        while i < info.fields.len {
            if info.fields.get(i).name == name {
                return match info.fields.get(i).typ {
                    Type::Func(_, _) => true,
                    _ => false,
                };
            }
            i += 1;
        }
        return false;
    }

    // A call of the function value `callee`
    func check_closure_call(e: &Expr, callee: &Expr, args: Vec<&Expr>): Type {
        var t = self.check_expr(callee, Type::Infer);
        return match t {
            Type::Func(params, ret) => {
                if params.len != args.len {
                    self.fail(e.pos, concat3("this function takes ", int_to_str(params.len), concat(" arguments, got ", int_to_str(args.len))));
                }
                var i = 0;
                while i < args.len {
                    var at = self.check_expr(args.get(i), params.get(i));
                    self.expect_assignable(params.get(i), at, args.get(i));
                    i += 1;
                }
                e.kind = ExprKind::CallClosure(callee, args);
                ret
            },
            _ => {
                self.fail(callee.pos, concat3("a value of type ", mangle(t), " can't be called"));
                Type::Infer
            },
        };
    }

    // A closure: its body becomes a function taking the closure object
    // (`$env`) first, and its value is a closure object holding the cells of
    // the variables it captures
    func check_closure(e: &Expr, params: Vec<Param>, ret: Type, body: Vec<&Stmt>, expected: Type): Type {
        var expected_params: Vec<Type> = Vec::new();
        var expected_ret = Type::Infer;
        var has_expected = false;
        match expected {
            Type::Func(ps, r) => {
                if ps.len == params.len {
                    expected_params = ps;
                    expected_ret = r;
                    has_expected = true;
                }
            },
            _ => {},
        }
        var resolved: Vec<Param> = Vec::new();
        var types: Vec<Type> = Vec::new();
        var i = 0;
        while i < params.len {
            var p = params.get(i);
            var t = p.typ;
            if !is_infer(t) {
                t = self.resolve_type(t, e.pos);
            } else if has_expected && !is_infer(expected_params.get(i)) {
                t = expected_params.get(i);
            } else {
                self.fail(e.pos, concat3("can't infer the type of parameter `", p.name, concat3("`; give it a type like `", p.name, ": int`")));
            }
            resolved.push(Param { name: p.name, typ: t });
            types.push(t);
            i += 1;
        }
        var declared_ret = expected_ret;
        if !is_infer(ret) {
            declared_ret = self.resolve_type(ret, e.pos);
        }

        // Cells for the variables it captures
        var names = closure_free_names(params, body);
        var captures: Vec<&Expr> = Vec::new();
        var captured_vars: Vec<VarInfo> = Vec::new();
        var captured_names_list: Vec<str> = Vec::new();
        i = 0;
        while i < names.len {
            match self.lookup_var(names.get(i)) {
                Option::Some(v) => {
                    var variable = new_expr(ExprKind::Local(v.ir), e.pos);
                    if v.boxed {
                        // Share the variable's cell
                        variable.typ = Type::Ptr(v.typ);
                        captures.push(variable);
                    } else {
                        // Immutable variables can't change, so a copy is as good as the original
                        variable.typ = v.typ;
                        var cell = new_expr(ExprKind::NewCell(variable), e.pos);
                        cell.typ = Type::Ptr(v.typ);
                        captures.push(cell);
                    }
                    captured_vars.push(v);
                    captured_names_list.push(names.get(i));
                },
                Option::None => {},
            }
            i += 1;
        }

        // Check the body as a function of its own
        var saved_scopes = self.scopes;
        var saved_counter = self.var_counter;
        var saved_return = self.current_return;
        var saved_depth = self.loop_depth;
        var saved_captured = self.captured;
        self.scopes = Vec::new();
        self.push_scope();
        self.var_counter = 0;
        self.loop_depth = 0;
        self.current_return = declared_ret;
        self.captured = captured_names(body);
        self.scopes.data[0].insert("$env", VarInfo { typ: Type::Str, mutable: false, ir: "p.$env", boxed: false });
        i = 0;
        while i < resolved.len {
            var p = resolved.get(i);
            self.scopes.data[0].insert(p.name, VarInfo { typ: p.typ, mutable: false, ir: concat("p.", p.name), boxed: false });
            i += 1;
        }
        var full_body: Vec<&Stmt> = Vec::new();
        i = 0;
        while i < captured_vars.len {
            var v = captured_vars.get(i);
            var cell = new_expr(ExprKind::EnvCell(i), e.pos);
            cell.typ = Type::Ptr(v.typ);
            var decl = new_stmt(StmtKind::VarDecl(captured_names_list.get(i), v.mutable, Type::Infer, cell), e.pos);
            decl.typ = Type::Ptr(v.typ);
            decl.ir_name = self.declare_boxed(captured_names_list.get(i), v.typ, v.mutable);
            full_body.push(decl);
            i += 1;
        }
        self.check_block(body);
        var result = self.current_return;
        if is_infer(result) {
            result = Type::Void;
        }
        if !is_void(result) && !always_returns(body) {
            self.fail(e.pos, "this closure might not return a value");
        }
        self.scopes = saved_scopes;
        self.var_counter = saved_counter;
        self.current_return = saved_return;
        self.loop_depth = saved_depth;
        self.captured = saved_captured;

        i = 0;
        while i < body.len {
            full_body.push(body.get(i));
            i += 1;
        }
        var symbol = concat("closure.", int_to_str(self.closure_count));
        self.closure_count += 1;
        var all_params: Vec<Param> = Vec::new();
        all_params.push(Param { name: "$env", typ: Type::Str });
        i = 0;
        while i < resolved.len {
            all_params.push(resolved.get(i));
            i += 1;
        }
        self.out_funcs.push(new FuncDecl {
            name: symbol,
            type_params: Vec::new(),
            params: all_params,
            ret: result,
            body: full_body,
            pos: e.pos,
            is_extern: false,
            is_varargs: false,
            symbol: symbol,
        });
        e.kind = ExprKind::MakeClosure(symbol, captures);
        return Type::Func(types, result);
    }

    // The function `sig` used as a value: a closure object for a wrapper that
    // takes the (unused) environment and calls it
    func function_value(e: &Expr, sig: &FuncSig): Type {
        var wrapper = concat("fn.", sig.symbol);
        if !self.instantiated.contains(wrapper) {
            self.instantiated.insert(wrapper, true);
            var params: Vec<Param> = Vec::new();
            params.push(Param { name: "$env", typ: Type::Str });
            var args: Vec<&Expr> = Vec::new();
            var i = 0;
            while i < sig.params.len {
                var name = concat("a", int_to_str(i));
                params.push(Param { name: name, typ: sig.params.get(i) });
                args.push(new_expr(ExprKind::Ident(name), e.pos));
                i += 1;
            }
            var call = new_expr(ExprKind::Call(new_expr(ExprKind::Ident(sig.symbol), e.pos), args), e.pos);
            var body: Vec<&Stmt> = Vec::new();
            if is_void(sig.ret) || is_never(sig.ret) {
                body.push(new_stmt(StmtKind::ExprStmt(call), e.pos));
            } else {
                body.push(new_stmt(StmtKind::Return(Option::Some(call)), e.pos));
            }
            var decl = new FuncDecl {
                name: wrapper,
                type_params: Vec::new(),
                params: params,
                ret: sig.ret,
                body: body,
                pos: e.pos,
                is_extern: false,
                is_varargs: false,
                symbol: wrapper,
            };
            var saved_scopes = self.scopes;
            var saved_counter = self.var_counter;
            var saved_return = self.current_return;
            var saved_depth = self.loop_depth;
            var saved_captured = self.captured;
            self.check_function(decl);
            self.scopes = saved_scopes;
            self.var_counter = saved_counter;
            self.current_return = saved_return;
            self.loop_depth = saved_depth;
            self.captured = saved_captured;
        }
        e.kind = ExprKind::MakeClosure(wrapper, Vec::new());
        return Type::Func(sig.params, sig.ret);
    }

    func check_struct_lit(e: &Expr, name_expr: &Expr, fields: Vec<FieldInit>, expected: Type): Type {
        var name = match name_expr.kind {
            ExprKind::Ident(n) => n,
            ExprKind::Turbofish(n, _) => n,
            _ => "",
        };
        match name_expr.kind {
            ExprKind::Turbofish(_, targs) => {
                var resolved: Vec<Type> = Vec::new();
                var i = 0;
                while i < targs.len {
                    resolved.push(self.resolve_type(targs.get(i), name_expr.pos));
                    i += 1;
                }
                name = named_of(self.instantiate_type(name, resolved, name_expr.pos));
            },
            _ => {
                match self.generic_structs.get(name) {
                    Option::Some(decl) => {
                        var patterns: Vec<Type> = Vec::new();
                        var values: Vec<&Expr> = Vec::new();
                        var i = 0;
                        while i < fields.len {
                            var f = fields.get(i);
                            var j = 0;
                            while j < decl.fields.len {
                                if decl.fields.get(j).name == f.name {
                                    patterns.push(decl.fields.get(j).typ);
                                    values.push(f.value);
                                }
                                j += 1;
                            }
                            i += 1;
                        }
                        var targs = self.infer_type_args(name, decl.type_params, expected, patterns, values, e.pos);
                        name = named_of(self.instantiate_type(name, targs, e.pos));
                    },
                    Option::None => {
                        match self.aliases.get(name) {
                            Option::Some(target) => { name = named_of(self.resolve_type(target, e.pos)); },
                            Option::None => {},
                        }
                    },
                }
            },
        }
        var found = self.structs.get(name);
        if found.is_none() {
            self.fail(e.pos, concat3("unknown struct `", name, "`"));
        }
        var info = found.unwrap();
        var i = 0;
        while i < fields.len {
            var f = fields.get(i);
            var known = false;
            var j = 0;
            while j < info.fields.len {
                if info.fields.get(j).name == f.name {
                    known = true;
                }
                j += 1;
            }
            if !known {
                self.fail(f.pos, concat3(name, " has no field ", f.name));
            }
            i += 1;
        }
        // Fields are evaluated in declaration order
        var values: Vec<&Expr> = Vec::new();
        i = 0;
        while i < info.fields.len {
            var field = info.fields.get(i);
            var value: &Expr = null;
            var j = 0;
            while j < fields.len {
                if fields.get(j).name == field.name {
                    value = fields.get(j).value;
                }
                j += 1;
            }
            if value == null {
                self.fail(e.pos, concat3("missing field `", field.name, concat3("` in ", name, "")));
            }
            var t = self.check_expr(value, field.typ);
            self.expect_assignable(field.typ, t, value);
            values.push(value);
            i += 1;
        }
        e.kind = ExprKind::StructValue(name, values);
        return Type::Named(name);
    }

    func check_match(e: &Expr, scrutinee: &Expr, arms: Vec<&MatchArm>, expected: Type): Type {
        var st = self.check_expr(scrutinee, Type::Infer);
        match self.tuple_items(st) {
            Option::Some(types) => { return self.check_tuple_match(e, st, types, arms, expected); },
            Option::None => {},
        }
        var enum_name = named_of(st);
        var info = self.enum_named(enum_name);
        var is_int = is_integer(st);
        if !is_int && info == null {
            self.fail(scrutinee.pos, concat("cannot match on a value of type ", mangle(st)));
        }
        var generic_name = match self.instances.get(enum_name) {
            Option::Some(inst) => inst.generic,
            Option::None => "",
        };

        var result = Type::Infer;
        var has_wildcard = false;
        var covered: Map<str, bool> = Map::new();
        var i = 0;
        while i < arms.len {
            var arm = arms.get(i);
            self.push_scope();
            match arm.pattern {
                Pattern::Wildcard => { has_wildcard = true; },
                Pattern::IntValue(value) => {
                    if !is_int {
                        self.fail(arm.pos, "integer pattern on a non-integer value");
                    }
                    arm.tag = value;
                },
                Pattern::Variant(pat_enum, variant, bindings) => {
                    if info == null || (pat_enum != enum_name && pat_enum != generic_name) {
                        self.fail(arm.pos, concat3("pattern doesn't match a value of type ", mangle(st), ""));
                    }
                    var tag = self.variant_tag(info, variant, arm.pos);
                    covered.insert(variant, true);
                    arm.enum_name = enum_name;
                    arm.tag = tag;
                    var payload = info.payloads.get(tag);
                    if bindings.len > 0 && bindings.len != payload.len {
                        self.fail(arm.pos, concat3("variant `", variant, concat3("` has ", int_to_str(payload.len), " values")));
                    }
                    var names: Vec<str> = Vec::new();
                    var j = 0;
                    while j < bindings.len {
                        var b = bindings.get(j);
                        if b == "_" {
                            names.push("_");
                        } else {
                            names.push(self.declare_var(b, payload.get(j), false));
                        }
                        j += 1;
                    }
                    arm.bindings = names;
                },
                _ => { self.fail(arm.pos, concat("a tuple pattern can't match a value of type ", mangle(st))); },
            }
            var t = self.check_expr(arm.body, expected);
            self.pop_scope();
            // Arms that always return don't produce a value; arms of different
            // types make the match a statement
            if !arm_diverges(arm) {
                if is_infer(result) {
                    result = t;
                } else if !type_eq(result, t) {
                    result = Type::Void;
                }
            }
            i += 1;
        }
        if info != null && !has_wildcard {
            i = 0;
            while i < info.variants.len {
                if !covered.contains(info.variants.get(i)) {
                    self.fail(e.pos, concat3("match doesn't cover variant `", info.variants.get(i), "`"));
                }
                i += 1;
            }
        }
        if is_infer(result) {
            result = Type::Void;
        }
        return result;
    }

    // A match on a tuple: each arm is `_` or a tuple pattern, which becomes
    // tests of the elements and variables bound to them
    func check_tuple_match(e: &Expr, st: Type, types: Vec<Type>, arms: Vec<&MatchArm>, expected: Type): Type {
        var result = Type::Infer;
        var rows: Vec<Vec<Pattern>> = Vec::new();
        var i = 0;
        while i < arms.len {
            var arm = arms.get(i);
            self.push_scope();
            match arm.pattern {
                Pattern::Wildcard => {},
                Pattern::Tuple(items) => { self.check_tuple_pattern(arm, items, types, Vec::new()); },
                _ => { self.fail(arm.pos, concat3("patterns matching the tuple ", mangle(st), " must be tuples like (a, _)")); },
            }
            var row: Vec<Pattern> = Vec::new();
            row.push(arm.pattern);
            rows.push(row);
            var t = self.check_expr(arm.body, expected);
            self.pop_scope();
            if !arm_diverges(arm) {
                if is_infer(result) {
                    result = t;
                } else if !type_eq(result, t) {
                    result = Type::Void;
                }
            }
            i += 1;
        }
        if !self.patterns_exhaustive(rows, types1(st)) {
            self.fail(e.pos, "this match isn't exhaustive: some tuples match none of the arms (add a `_` arm?)");
        }
        if is_infer(result) {
            result = Type::Void;
        }
        return result;
    }

    // Check tuple pattern `items` against the element `types` of the tuple at
    // `path`, recording the arm's tests and bindings
    func check_tuple_pattern(arm: &MatchArm, items: Vec<Pattern>, types: Vec<Type>, path: Vec<int>) {
        if items.len != types.len {
            self.fail(arm.pos, concat3("this pattern has ", int_to_str(items.len), concat3(" elements, but the tuple has ", int_to_str(types.len), "")));
        }
        var i = 0;
        while i < items.len {
            var t = types.get(i);
            var sub = extend_path(path, i);
            match items.get(i) {
                Pattern::Wildcard => {},
                Pattern::Binding(name) => {
                    arm.binds.push(PatBind { path: sub, ir: self.declare_var(name, t, false), typ: t });
                },
                Pattern::IntValue(value) => {
                    if !is_integer(t) {
                        self.fail(arm.pos, concat("an integer pattern can't match a value of type ", mangle(t)));
                    }
                    arm.tests.push(PatTest { path: sub, value: value, typ: t, boxed: false });
                },
                Pattern::Variant(pat_enum, variant, bindings) => {
                    var name = named_of(t);
                    var info = self.enum_named(name);
                    var generic_name = match self.instances.get(name) {
                        Option::Some(inst) => inst.generic,
                        Option::None => "",
                    };
                    if info == null || (pat_enum != name && pat_enum != generic_name) {
                        self.fail(arm.pos, concat3("the pattern ", pat_enum, concat3("::", variant, concat(" can't match a value of type ", mangle(t)))));
                    }
                    if bindings.len > 0 {
                        self.fail(arm.pos, "variant payloads can't be destructured inside a tuple pattern; match on the element instead");
                    }
                    var tag = self.variant_tag(info, variant, arm.pos);
                    arm.tests.push(PatTest { path: sub, value: tag, typ: Type::Int, boxed: info.boxed });
                },
                Pattern::Tuple(inner) => {
                    match self.tuple_items(t) {
                        Option::Some(inner_types) => { self.check_tuple_pattern(arm, inner, inner_types, sub); },
                        Option::None => { self.fail(arm.pos, concat("a tuple pattern can't match a value of type ", mangle(t))); },
                    }
                },
            }
            i += 1;
        }
    }

    // Do the pattern `rows` (each matching values of `types`) together match every value?
    func patterns_exhaustive(rows: Vec<Vec<Pattern>>, types: Vec<Type>): bool {
        if types.len == 0 {
            return rows.len > 0;
        }
        var first = types.get(0);
        var rest: Vec<Type> = Vec::new();
        var i = 1;
        while i < types.len {
            rest.push(types.get(i));
            i += 1;
        }
        match self.tuple_items(first) {
            Option::Some(items) => {
                // Expand the tuple's elements into columns
                var expanded: Vec<Vec<Pattern>> = Vec::new();
                i = 0;
                while i < rows.len {
                    var row = rows.get(i);
                    var new_row: Vec<Pattern> = Vec::new();
                    match row.get(0) {
                        Pattern::Tuple(inner) => {
                            var j = 0;
                            while j < inner.len {
                                new_row.push(inner.get(j));
                                j += 1;
                            }
                        },
                        _ => {
                            var j = 0;
                            while j < items.len {
                                new_row.push(Pattern::Wildcard);
                                j += 1;
                            }
                        },
                    }
                    var j = 1;
                    while j < row.len {
                        new_row.push(row.get(j));
                        j += 1;
                    }
                    expanded.push(new_row);
                    i += 1;
                }
                var new_types: Vec<Type> = Vec::new();
                i = 0;
                while i < items.len {
                    new_types.push(items.get(i));
                    i += 1;
                }
                i = 0;
                while i < rest.len {
                    new_types.push(rest.get(i));
                    i += 1;
                }
                return self.patterns_exhaustive(expanded, new_types);
            },
            Option::None => {},
        }
        var info = self.enum_named(named_of(first));
        if info != null {
            // Every variant must be matched by the rows that allow it
            var v = 0;
            while v < info.variants.len {
                var remaining: Vec<Vec<Pattern>> = Vec::new();
                i = 0;
                while i < rows.len {
                    var row = rows.get(i);
                    var keep = match row.get(0) {
                        Pattern::Variant(_, variant, _) => variant == info.variants.get(v),
                        Pattern::Wildcard => true,
                        Pattern::Binding(_) => true,
                        _ => false,
                    };
                    if keep {
                        remaining.push(drop_first(row));
                    }
                    i += 1;
                }
                if !self.patterns_exhaustive(remaining, rest) {
                    return false;
                }
                v += 1;
            }
            return true;
        }
        // Integers and other values are only covered by wildcards
        var remaining: Vec<Vec<Pattern>> = Vec::new();
        i = 0;
        while i < rows.len {
            var row = rows.get(i);
            var wild = match row.get(0) {
                Pattern::Wildcard => true,
                Pattern::Binding(_) => true,
                _ => false,
            };
            if wild {
                remaining.push(drop_first(row));
            }
            i += 1;
        }
        return self.patterns_exhaustive(remaining, rest);
    }

    // With the GC, malloc & co. allocate from the collected heap. Allocations
    // sized by a pointer-free type (`n * sizeof(int)`) aren't scanned.
    func managed_allocator(symbol: str, args: Vec<&Expr>): str {
        if !self.has_gc {
            return symbol;
        }
        if symbol == "malloc" {
            if self.pointer_free_size(args.get(0)) {
                return "gc_malloc_atomic";
            }
            return "gc_malloc";
        }
        if symbol == "calloc" {
            if self.pointer_free_size(args.get(0)) || self.pointer_free_size(args.get(1)) {
                return "gc_calloc_atomic";
            }
            return "gc_calloc";
        }
        if symbol == "realloc" {
            return "gc_realloc";
        }
        if symbol == "free" {
            return "gc_free";
        }
        return symbol;
    }

    // Is `size` a multiple of the size of a type that holds no pointers?
    func pointer_free_size(size: &Expr): bool {
        return match size.kind {
            ExprKind::SizeOf(t) => !self.has_pointers(t),
            ExprKind::Binary(op, l, r) => op == BinOp::Mul && (self.pointer_free_size(l) || self.pointer_free_size(r)),
            _ => false,
        };
    }

    // Can a value of type `t` hold a pointer to the heap?
    func has_pointers(t: Type): bool {
        return match t {
            Type::Int => false,
            Type::SInt(_) => false,
            Type::UInt(_) => false,
            Type::Float => false,
            Type::SFloat(_) => false,
            Type::Bool => false,
            Type::Named(name) => {
                var info = self.enum_named(name);
                if info != null {
                    return info.boxed;
                }
                var s = self.struct_of(t);
                if s == null {
                    return true;
                }
                var i = 0;
                while i < s.fields.len {
                    if self.has_pointers(s.fields.get(i).typ) {
                        return true;
                    }
                    i += 1;
                }
                false
            },
            _ => true,
        };
    }
}

func new_checker(src: &Source): &Checker {
    var c = new Checker {
        src: src,
        structs: Map::new(),
        enums: Map::new(),
        funcs: Map::new(),
        generic_structs: Map::new(),
        generic_enums: Map::new(),
        generic_funcs: Map::new(),
        generic_methods: Map::new(),
        instances: Map::new(),
        instantiated: Map::new(),
        aliases: Map::new(),
        globals: Map::new(),
        interfaces: Map::new(),
        claims: Map::new(),
        bounds: Map::new(),
        out_structs: Vec::new(),
        out_enums: Vec::new(),
        out_funcs: Vec::new(),
        out_globals: Vec::new(),
        extern_symbols: Vec::new(),
        pending: Vec::new(),
        scopes: Vec::new(),
        var_counter: 0,
        current_return: Type::Void,
        loop_depth: 0,
        captured: Map::new(),
        closure_count: 0,
        has_gc: false,
    };
    c.add_builtins();
    return c;
}

func types1(a: Type): Vec<Type> {
    var v: Vec<Type> = Vec::new();
    v.push(a);
    return v;
}

func types2(a: Type, b: Type): Vec<Type> {
    var v = types1(a);
    v.push(b);
    return v;
}

func types3(a: Type, b: Type, c: Type): Vec<Type> {
    var v = types2(a, b);
    v.push(c);
    return v;
}

func types4(a: Type, b: Type, c: Type, d: Type): Vec<Type> {
    var v = types3(a, b, c);
    v.push(d);
    return v;
}

// Substitute type arguments for type parameters
func subst_type(t: Type, params: Vec<str>, args: Vec<Type>): Type {
    return match t {
        Type::Named(name) => {
            var i = 0;
            while i < params.len {
                if params.get(i) == name {
                    return args.get(i);
                }
                i += 1;
            }
            t
        },
        Type::Ptr(inner) => Type::Ptr(subst_type(inner, params, args)),
        Type::Array(inner, size) => Type::Array(subst_type(inner, params, args), size),
        Type::Generic(name, targs) => {
            var out: Vec<Type> = Vec::new();
            var i = 0;
            while i < targs.len {
                out.push(subst_type(targs.get(i), params, args));
                i += 1;
            }
            Type::Generic(name, out)
        },
        Type::Tuple(items) => {
            var out: Vec<Type> = Vec::new();
            var i = 0;
            while i < items.len {
                out.push(subst_type(items.get(i), params, args));
                i += 1;
            }
            Type::Tuple(out)
        },
        Type::Func(ps, ret) => {
            var out: Vec<Type> = Vec::new();
            var i = 0;
            while i < ps.len {
                out.push(subst_type(ps.get(i), params, args));
                i += 1;
            }
            Type::Func(out, subst_type(ret, params, args))
        },
        _ => t,
    };
}

// Does `t` refer to any of the type parameters `params`?
func mentions_params(t: Type, params: Vec<str>): bool {
    return match t {
        Type::Named(name) => contains_str(params, name),
        Type::Ptr(inner) => mentions_params(inner, params),
        Type::Array(inner, _) => mentions_params(inner, params),
        Type::Generic(_, args) => any_mentions_params(args, params),
        Type::Tuple(items) => any_mentions_params(items, params),
        Type::Func(ps, ret) => any_mentions_params(ps, params) || mentions_params(ret, params),
        _ => false,
    };
}

func any_mentions_params(types: Vec<Type>, params: Vec<str>): bool {
    var i = 0;
    while i < types.len {
        if mentions_params(types.get(i), params) {
            return true;
        }
        i += 1;
    }
    return false;
}

// ---------------------------------------------------------------------------
// Which variables closures use from their surroundings. Closures capture
// variables by reference, so mutable variables a closure uses live in heap
// cells.
// ---------------------------------------------------------------------------

struct NameWalk {
    // Identifiers used, in order of first use
    used: Vec<str>;
    used_set: Map<str, bool>;
    // Names declared (variables, loop variables, pattern bindings, parameters)
    declared: Map<str, bool>;
    // Names closures use without declaring them
    closure_free: Map<str, bool>;

    func use_name(name: str) {
        if !self.used_set.contains(name) {
            self.used_set.insert(name, true);
            self.used.push(name);
        }
    }

    func declare(name: str) {
        self.declared.insert(name, true);
    }

    func stmts(list: Vec<&Stmt>) {
        var i = 0;
        while i < list.len {
            self.stmt(list.get(i));
            i += 1;
        }
    }

    func exprs(list: Vec<&Expr>) {
        var i = 0;
        while i < list.len {
            self.expr(list.get(i));
            i += 1;
        }
    }

    func opt_expr(e: Option<&Expr>) {
        match e {
            Option::Some(x) => { self.expr(x); },
            Option::None => {},
        }
    }

    func stmt(s: &Stmt) {
        match s.kind {
            StmtKind::VarDecl(name, _, _, value) => {
                self.declare(name);
                self.expr(value);
            },
            StmtKind::Assign(target, value) => {
                self.expr(target);
                self.expr(value);
            },
            StmtKind::ExprStmt(e) => { self.expr(e); },
            StmtKind::Return(value) => { self.opt_expr(value); },
            StmtKind::If(cond, then_body, else_body) => {
                self.expr(cond);
                self.stmts(then_body);
                self.stmts(else_body);
            },
            StmtKind::Loop(cond, body) => {
                self.opt_expr(cond);
                self.stmts(body);
            },
            StmtKind::ForIn(name, iterable, end, _, body) => {
                self.declare(name);
                self.expr(iterable);
                self.opt_expr(end);
                self.stmts(body);
            },
            StmtKind::CompoundAssign(_, target, value) => {
                self.expr(target);
                self.expr(value);
            },
            StmtKind::Destructure(names, _, value) => {
                var i = 0;
                while i < names.len {
                    self.declare(names.get(i));
                    i += 1;
                }
                self.expr(value);
            },
            StmtKind::Group(list) => { self.stmts(list); },
            _ => {},
        }
    }

    func pattern(p: Pattern) {
        match p {
            Pattern::Variant(_, _, bindings) => {
                var i = 0;
                while i < bindings.len {
                    self.declare(bindings.get(i));
                    i += 1;
                }
            },
            Pattern::Binding(name) => { self.declare(name); },
            Pattern::Tuple(items) => {
                var i = 0;
                while i < items.len {
                    self.pattern(items.get(i));
                    i += 1;
                }
            },
            _ => {},
        }
    }

    func expr(e: &Expr) {
        match e.kind {
            ExprKind::Ident(name) => { self.use_name(name); },
            ExprKind::Binary(_, l, r) => {
                self.expr(l);
                self.expr(r);
            },
            ExprKind::Unary(_, x) => { self.expr(x); },
            ExprKind::AddrOf(x) => { self.expr(x); },
            ExprKind::Deref(x) => { self.expr(x); },
            ExprKind::Call(f, args) => {
                self.expr(f);
                self.exprs(args);
            },
            ExprKind::Index(a, i) => {
                self.expr(a);
                self.expr(i);
            },
            // The member is a field or method name, not a variable
            ExprKind::Field(x, _) => { self.expr(x); },
            ExprKind::MethodTurbofish(x, _, _) => { self.expr(x); },
            ExprKind::StructLit(_, fields) => {
                var i = 0;
                while i < fields.len {
                    self.expr(fields.get(i).value);
                    i += 1;
                }
            },
            ExprKind::ArrayLit(items) => { self.exprs(items); },
            ExprKind::Tuple(items) => { self.exprs(items); },
            ExprKind::Try(x) => { self.expr(x); },
            ExprKind::Interpolate(parts) => { self.exprs(parts); },
            ExprKind::Cast(x, _) => { self.expr(x); },
            ExprKind::Alloc(x) => { self.expr(x); },
            ExprKind::AllocIn(x, arena) => {
                self.expr(x);
                self.expr(arena);
            },
            ExprKind::Match(scrutinee, arms) => {
                self.expr(scrutinee);
                var i = 0;
                while i < arms.len {
                    self.pattern(arms.get(i).pattern);
                    self.expr(arms.get(i).body);
                    i += 1;
                }
            },
            ExprKind::Block(list, value) => {
                self.stmts(list);
                self.opt_expr(value);
            },
            ExprKind::Closure(params, _, body) => {
                var free = closure_free_names(params, body);
                var i = 0;
                while i < free.len {
                    self.use_name(free.get(i));
                    self.closure_free.insert(free.get(i), true);
                    i += 1;
                }
                // Names nested closures capture
                var nested = captured_names(body);
                var keys = nested.key_list();
                i = 0;
                while i < keys.len {
                    self.closure_free.insert(keys.get(i), true);
                    i += 1;
                }
            },
            _ => {},
        }
    }
}

func new_name_walk(): NameWalk {
    return NameWalk { used: Vec::new(), used_set: Map::new(), declared: Map::new(), closure_free: Map::new() };
}

// Names the body of a closure with `params` uses without declaring, in order of first use
func closure_free_names(params: Vec<Param>, body: Vec<&Stmt>): Vec<str> {
    var walk = new_name_walk();
    var i = 0;
    while i < params.len {
        walk.declare(params.get(i).name);
        i += 1;
    }
    walk.stmts(body);
    var out: Vec<str> = Vec::new();
    i = 0;
    while i < walk.used.len {
        if !walk.declared.contains(walk.used.get(i)) {
            out.push(walk.used.get(i));
        }
        i += 1;
    }
    return out;
}

// Names the closures in `body` use from outside them: variables with these
// names may be captured
func captured_names(body: Vec<&Stmt>): Map<str, bool> {
    var walk = new_name_walk();
    walk.stmts(body);
    return walk.closure_free;
}

// An unchecked match arm
func new_arm(pattern: Pattern, body: &Expr, pos: int): &MatchArm {
    return new MatchArm {
        pattern: pattern,
        body: body,
        pos: pos,
        enum_name: "",
        tag: 0,
        bindings: Vec::new(),
        tests: Vec::new(),
        binds: Vec::new(),
    };
}

// `{ return value; }`
func early_return(value: &Expr, pos: int): &Expr {
    var stmts: Vec<&Stmt> = Vec::new();
    stmts.push(new_stmt(StmtKind::Return(Option::Some(value)), pos));
    return new_expr(ExprKind::Block(stmts, Option::None), pos);
}

// The name a type's methods and interfaces are recorded under
func type_key(t: Type): str {
    return match t {
        Type::Named(name) => name,
        Type::Generic(name, _) => name,
        _ => mangle(t),
    };
}

// Make type `key`'s method `name` take `self` if it doesn't already
func add_self_param(program: &Program, key: str, name: str) {
    var i = 0;
    while i < program.impls.len {
        var imp = program.impls.get(i);
        if type_key(imp.target) == key {
            var j = 0;
            while j < imp.methods.len {
                var f = imp.methods.get(j);
                if f.name == name && (f.params.len == 0 || f.params.get(0).name != "self") {
                    var params: Vec<Param> = Vec::new();
                    params.push(Param { name: "self", typ: Type::Named("__self") });
                    var k = 0;
                    while k < f.params.len {
                        params.push(f.params.get(k));
                        k += 1;
                    }
                    f.params = params;
                }
                j += 1;
            }
        }
        i += 1;
    }
}

// Does `program` give the type `key` a method called `name`?
func type_defines(program: &Program, key: str, name: str): bool {
    var i = 0;
    while i < program.impls.len {
        var imp = program.impls.get(i);
        if type_key(imp.target) == key {
            var j = 0;
            while j < imp.methods.len {
                if imp.methods.get(j).name == name {
                    return true;
                }
                j += 1;
            }
        }
        i += 1;
    }
    return false;
}

// `path` followed by `index`
func extend_path(path: Vec<int>, index: int): Vec<int> {
    var out: Vec<int> = Vec::new();
    var i = 0;
    while i < path.len {
        out.push(path.get(i));
        i += 1;
    }
    out.push(index);
    return out;
}

// A pattern row without its first column
func drop_first(row: Vec<Pattern>): Vec<Pattern> {
    var out: Vec<Pattern> = Vec::new();
    var i = 1;
    while i < row.len {
        out.push(row.get(i));
        i += 1;
    }
    return out;
}

// ---------------------------------------------------------------------------
// Copying generic definitions (with their type parameters substituted)
// ---------------------------------------------------------------------------

struct Copier {
    params: Vec<str>;
    args: Vec<Type>;

    func typ(t: Type): Type {
        return subst_type(t, self.params, self.args);
    }

    func exprs(list: Vec<&Expr>): Vec<&Expr> {
        var out: Vec<&Expr> = Vec::new();
        var i = 0;
        while i < list.len {
            out.push(self.expr(list.get(i)));
            i += 1;
        }
        return out;
    }

    func stmts(list: Vec<&Stmt>): Vec<&Stmt> {
        var out: Vec<&Stmt> = Vec::new();
        var i = 0;
        while i < list.len {
            out.push(self.stmt(list.get(i)));
            i += 1;
        }
        return out;
    }

    func opt_expr(e: Option<&Expr>): Option<&Expr> {
        return match e {
            Option::Some(x) => Option::Some(self.expr(x)),
            Option::None => Option::None,
        };
    }

    func expr(e: &Expr): &Expr {
        var kind = match e.kind {
            ExprKind::Binary(op, l, r) => ExprKind::Binary(op, self.expr(l), self.expr(r)),
            ExprKind::Unary(op, x) => ExprKind::Unary(op, self.expr(x)),
            ExprKind::AddrOf(x) => ExprKind::AddrOf(self.expr(x)),
            ExprKind::Deref(x) => ExprKind::Deref(self.expr(x)),
            ExprKind::Call(f, args) => ExprKind::Call(self.expr(f), self.exprs(args)),
            ExprKind::Index(a, i) => ExprKind::Index(self.expr(a), self.expr(i)),
            ExprKind::Field(x, name) => ExprKind::Field(self.expr(x), name),
            ExprKind::Path(ns, member) => ExprKind::Path(self.expr(ns), member),
            ExprKind::Turbofish(name, targs) => {
                var out: Vec<Type> = Vec::new();
                var i = 0;
                while i < targs.len {
                    out.push(self.typ(targs.get(i)));
                    i += 1;
                }
                ExprKind::Turbofish(name, out)
            },
            ExprKind::StructLit(name, fields) => {
                var out: Vec<FieldInit> = Vec::new();
                var i = 0;
                while i < fields.len {
                    var f = fields.get(i);
                    out.push(FieldInit { name: f.name, value: self.expr(f.value), pos: f.pos });
                    i += 1;
                }
                ExprKind::StructLit(self.expr(name), out)
            },
            ExprKind::ArrayLit(items) => ExprKind::ArrayLit(self.exprs(items)),
            ExprKind::Cast(x, t) => ExprKind::Cast(self.expr(x), self.typ(t)),
            ExprKind::SizeOf(t) => ExprKind::SizeOf(self.typ(t)),
            ExprKind::Alloc(x) => ExprKind::Alloc(self.expr(x)),
            ExprKind::AllocIn(x, arena) => ExprKind::AllocIn(self.expr(x), self.expr(arena)),
            ExprKind::Match(scrutinee, arms) => {
                var out: Vec<&MatchArm> = Vec::new();
                var i = 0;
                while i < arms.len {
                    var arm = arms.get(i);
                    out.push(new MatchArm {
                        pattern: arm.pattern,
                        body: self.expr(arm.body),
                        pos: arm.pos,
                        enum_name: "",
                        tag: 0,
                        bindings: Vec::new(),
                        tests: Vec::new(),
                        binds: Vec::new(),
                    });
                    i += 1;
                }
                ExprKind::Match(self.expr(scrutinee), out)
            },
            ExprKind::Block(stmts, value) => ExprKind::Block(self.stmts(stmts), self.opt_expr(value)),
            ExprKind::Interpolate(parts) => ExprKind::Interpolate(self.exprs(parts)),
            ExprKind::Tuple(items) => ExprKind::Tuple(self.exprs(items)),
            ExprKind::Try(x) => ExprKind::Try(self.expr(x)),
            ExprKind::Closure(params, ret, body) => {
                var out: Vec<Param> = Vec::new();
                var i = 0;
                while i < params.len {
                    out.push(Param { name: params.get(i).name, typ: self.typ(params.get(i).typ) });
                    i += 1;
                }
                ExprKind::Closure(out, self.typ(ret), self.stmts(body))
            },
            ExprKind::MethodTurbofish(x, name, targs) => {
                var out: Vec<Type> = Vec::new();
                var i = 0;
                while i < targs.len {
                    out.push(self.typ(targs.get(i)));
                    i += 1;
                }
                ExprKind::MethodTurbofish(self.expr(x), name, out)
            },
            _ => e.kind,
        };
        return new_expr(kind, e.pos);
    }

    func stmt(s: &Stmt): &Stmt {
        var kind = match s.kind {
            StmtKind::VarDecl(name, mutable, t, value) => StmtKind::VarDecl(name, mutable, self.typ(t), self.expr(value)),
            StmtKind::Assign(target, value) => StmtKind::Assign(self.expr(target), self.expr(value)),
            StmtKind::ExprStmt(e) => StmtKind::ExprStmt(self.expr(e)),
            StmtKind::Return(value) => StmtKind::Return(self.opt_expr(value)),
            StmtKind::If(cond, then_body, else_body) => StmtKind::If(self.expr(cond), self.stmts(then_body), self.stmts(else_body)),
            StmtKind::Loop(cond, body) => StmtKind::Loop(self.opt_expr(cond), self.stmts(body)),
            StmtKind::ForIn(name, iterable, end, inclusive, body) => {
                StmtKind::ForIn(name, self.expr(iterable), self.opt_expr(end), inclusive, self.stmts(body))
            },
            StmtKind::CompoundAssign(op, target, value) => StmtKind::CompoundAssign(op, self.expr(target), self.expr(value)),
            StmtKind::Destructure(names, mutable, value) => StmtKind::Destructure(names, mutable, self.expr(value)),
            _ => s.kind,
        };
        return new_stmt(kind, s.pos);
    }

    func copy_func(decl: &FuncDecl, symbol: str): &FuncDecl {
        var params: Vec<Param> = Vec::new();
        var i = 0;
        while i < decl.params.len {
            var p = decl.params.get(i);
            params.push(Param { name: p.name, typ: self.typ(p.typ) });
            i += 1;
        }
        return new FuncDecl {
            name: decl.name,
            type_params: Vec::new(),
            params: params,
            ret: self.typ(decl.ret),
            body: self.stmts(decl.body),
            pos: decl.pos,
            is_extern: false,
            is_varargs: false,
            symbol: symbol,
        };
    }
}

// Does executing `body` always end in a return (or never finish)?
func always_returns(body: Vec<&Stmt>): bool {
    if body.len == 0 {
        return false;
    }
    var last = body.get(body.len - 1);
    return match last.kind {
        StmtKind::Return(_) => true,
        StmtKind::If(_, then_body, else_body) => always_returns(then_body) && always_returns(else_body),
        StmtKind::Loop(cond, loop_body) => {
            var infinite = match cond {
                Option::None => true,
                Option::Some(c) => match c.kind {
                    ExprKind::BoolLit(b) => b,
                    _ => false,
                },
            };
            infinite && !contains_break(loop_body)
        },
        // Calls of functions returning `!`
        StmtKind::ExprStmt(e) => is_never(e.typ) || match e.kind {
            ExprKind::Match(_, arms) => {
                var i = 0;
                var all = true;
                while i < arms.len {
                    if !arm_diverges(arms.get(i)) {
                        all = false;
                    }
                    i += 1;
                }
                all
            },
            _ => false,
        },
        StmtKind::Group(stmts) => always_returns(stmts),
        _ => false,
    };
}

// Does `body` contain a `break` for this loop (not a nested one)?
func contains_break(body: Vec<&Stmt>): bool {
    var i = 0;
    while i < body.len {
        var found = match body.get(i).kind {
            StmtKind::Break => true,
            StmtKind::If(_, then_body, else_body) => contains_break(then_body) || contains_break(else_body),
            StmtKind::ExprStmt(e) => match e.kind {
                ExprKind::Match(_, arms) => {
                    var j = 0;
                    var any = false;
                    while j < arms.len {
                        match arms.get(j).body.kind {
                            ExprKind::Block(stmts, _) => {
                                if contains_break(stmts) {
                                    any = true;
                                }
                            },
                            _ => {},
                        }
                        j += 1;
                    }
                    any
                },
                _ => false,
            },
            _ => false,
        };
        if found {
            return true;
        }
        i += 1;
    }
    return false;
}

func is_int_literal(e: &Expr): bool {
    return match e.kind {
        ExprKind::IntLit(_) => true,
        ExprKind::Unary(op, inner) => op == UnOp::Neg && is_int_literal(inner),
        _ => false,
    };
}

// Can a value of type `got` (from expression `e`) be stored where `expected` is wanted?
func assignable(expected: Type, got: Type, e: &Expr): bool {
    // `!` never produces a value, so it fits anywhere
    if type_eq(expected, got) || is_never(got) {
        return true;
    }
    if is_integer(expected) && is_integer(got) {
        return is_int_literal(e) || type_eq(got, Type::Int) || type_eq(expected, Type::Int);
    }
    if is_pointer_like(expected) && is_pointer_like(got) {
        return type_eq(expected, Type::Str) || type_eq(got, Type::Str);
    }
    return false;
}

func arm_diverges(arm: &MatchArm): bool {
    return is_never(arm.body.typ) || match arm.body.kind {
        ExprKind::Block(stmts, value) => value.is_none() && always_returns(stmts),
        _ => false,
    };
}

func is_struct_lit(e: &Expr): bool {
    return match e.kind {
        ExprKind::StructLit(_, _) => true,
        _ => false,
    };
}

func is_null_expr(e: &Expr): bool {
    return match e.kind {
        ExprKind::Null => true,
        _ => false,
    };
}

// An unchecked call of the function `name` with one argument
func call_named(name: str, arg: &Expr, pos: int): &Expr {
    var args: Vec<&Expr> = Vec::new();
    args.push(arg);
    return new_expr(ExprKind::Call(new_expr(ExprKind::Ident(name), pos), args), pos);
}

// Rewrite a (checked) operator on two strings into calls of the stdlib helpers
func string_op(e: &Expr, op: BinOp, l: &Expr, r: &Expr): Type {
    var args: Vec<&Expr> = Vec::new();
    args.push(l);
    args.push(r);
    if op == BinOp::Add {
        e.kind = ExprKind::CallFn("str_concat", args);
        return Type::Str;
    }
    var call = new_expr(ExprKind::CallFn("str_equals", args), e.pos);
    call.typ = Type::Bool;
    if op == BinOp::Eq {
        e.kind = call.kind;
    } else if op == BinOp::Ne {
        e.kind = ExprKind::Unary(UnOp::Not, call);
    } else {
        call.kind = ExprKind::CallFn("str_compare", args);
        call.typ = Type::Int;
        var zero = new_expr(ExprKind::IntLit(0), e.pos);
        zero.typ = Type::Int;
        e.kind = ExprKind::Binary(op, call, zero);
    }
    return Type::Bool;
}
