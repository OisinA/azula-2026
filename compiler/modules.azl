// Modules: `import "geometry.azl" as geo`.
//
// A file imported with a name is a module. Its top-level items are renamed
// `geo__Point` (throughout the file) so they don't clash with other files',
// and in the importing file `geo::Point` refers to them. Items are private to
// their module unless declared `pub`. Plain `import "file.azl"` shares one
// namespace, as before. (The Rust compiler does the same in modules.rs.)

struct ModuleInfo {
    // The prefix its items are renamed with (`geo__`)
    prefix: str;
    items: Map<str, bool>;
    public: Map<str, bool>;
    file: str;
}

const SCAN_IDENT: int = 0;
const SCAN_STR: int = 1;
const SCAN_CHAR: int = 2;
const SCAN_COMMENT: int = 3;
const SCAN_SPACE: int = 4;
const SCAN_COLONCOLON: int = 5;
const SCAN_PUNCT: int = 6;

struct ScanTok {
    kind: int;
    // The character, for SCAN_PUNCT
    ch: int;
    start: int;
    end: int;
}

// Where a `${` at `start` ends (just past its `}`)
func interpolation_end(b: str, n: int, start: int): int {
    var i = start + 2;
    var depth = 1;
    while i < n && depth > 0 {
        var c: int = b[i];
        if c == '{' {
            depth += 1;
        } else if c == '}' {
            depth -= 1;
        } else if c == '"' {
            i += 1;
            while i < n && b[i] != '"' {
                if b[i] == '\\' {
                    i += 1;
                }
                i += 1;
            }
        }
        i += 1;
    }
    return i;
}

func is_space_byte(c: int): bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}

func scan_text(b: str): Vec<ScanTok> {
    var n = strlen(b);
    var toks: Vec<ScanTok> = Vec::new();
    var i = 0;
    while i < n {
        var start = i;
        var c: int = b[i];
        var kind = SCAN_PUNCT;
        if c == '/' && i + 1 < n && b[i + 1] == '/' {
            while i < n && b[i] != '\n' {
                i += 1;
            }
            kind = SCAN_COMMENT;
        } else if is_space_byte(c) {
            while i < n && is_space_byte(b[i] as int) {
                i += 1;
            }
            kind = SCAN_SPACE;
        } else if is_ident_start(c) {
            while i < n && is_ident_char(b[i] as int) {
                i += 1;
            }
            kind = SCAN_IDENT;
        } else if is_digit(c) {
            while i < n && is_ident_char(b[i] as int) {
                i += 1;
            }
            c = '0';
        } else if c == '"' {
            i += 1;
            while i < n && b[i] != '"' {
                if b[i] == '\\' {
                    i += 2;
                } else if b[i] == '$' && i + 1 < n && b[i + 1] == '{' {
                    i = interpolation_end(b, n, i);
                } else {
                    i += 1;
                }
            }
            i += 1;
            kind = SCAN_STR;
        } else if c == '\'' {
            i += 1;
            while i < n && b[i] != '\'' {
                if b[i] == '\\' {
                    i += 1;
                }
                i += 1;
            }
            i += 1;
            kind = SCAN_CHAR;
        } else if c == ':' && i + 1 < n && b[i + 1] == ':' {
            i += 2;
            kind = SCAN_COLONCOLON;
        } else {
            i += 1;
        }
        if i > n {
            i = n;
        }
        toks.push(ScanTok { kind: kind, ch: c, start: start, end: i });
    }
    return toks;
}

func significant_tokens(toks: Vec<ScanTok>): Vec<int> {
    var out: Vec<int> = Vec::new();
    var i = 0;
    while i < toks.len {
        var k = toks.get(i).kind;
        if k != SCAN_SPACE && k != SCAN_COMMENT {
            out.push(i);
        }
        i += 1;
    }
    return out;
}

func token_text(text: str, t: ScanTok): str {
    return substring(text, t.start, t.end - t.start);
}

func is_punct(t: ScanTok, c: int): bool {
    return t.kind == SCAN_PUNCT && t.ch == c;
}

// Record the names of the top-level items `text` declares, and which are `pub`
func collect_items(text: str, info: &ModuleInfo) {
    var toks = scan_text(text);
    var sig = significant_tokens(toks);
    var depth = 0;
    var k = 0;
    while k < sig.len {
        var t = toks.get(sig.get(k));
        if is_punct(t, '{') {
            depth += 1;
        } else if is_punct(t, '}') {
            depth -= 1;
        } else if t.kind == SCAN_IDENT && depth == 0 && k + 1 < sig.len {
            var w = token_text(text, t);
            var next = toks.get(sig.get(k + 1));
            if (w == "func" || w == "struct" || w == "enum" || w == "interface" || w == "type" || w == "const") && next.kind == SCAN_IDENT {
                var name = token_text(text, next);
                var before = "";
                if k > 0 {
                    before = token_text(text, toks.get(sig.get(k - 1)));
                }
                // `extern` functions keep their C names: they aren't the
                // module's items and are never renamed
                if before != "extern" && before != "varargs" {
                    if before == "pub" {
                        info.public.insert(name, true);
                    }
                    info.items.insert(name, true);
                }
            }
        }
        k += 1;
    }
}

// Rewrite a file's text: rename its own items (if it's a module, `own` isn't
// null), and turn `alias::name` references to modules into their renamed
// items. Errors report positions in `file`, relative to `base`.
func rewrite_module_text(text: str, own: &ModuleInfo, aliases: &Map<str, &ModuleInfo>, file: str, whole: str, base: int): str {
    var toks = scan_text(text);
    var sig = significant_tokens(toks);
    var out = StringBuilder::new();
    var last = 0;
    var depth = 0;
    var parens = 0;
    var enum_pending = false;
    var enum_depths: Vec<int> = Vec::new();
    var k = 0;
    while k < sig.len {
        var t = toks.get(sig.get(k));
        if is_punct(t, '(') {
            parens += 1;
        } else if is_punct(t, ')') {
            parens -= 1;
        } else if is_punct(t, '{') {
            depth += 1;
            if enum_pending {
                enum_depths.push(depth);
                enum_pending = false;
            }
        } else if is_punct(t, '}') {
            if enum_depths.len > 0 && enum_depths.peek() == depth {
                enum_depths.pop();
            }
            depth -= 1;
        } else if t.kind == SCAN_STR {
            // Rewrite the code inside `${...}`
            var s = token_text(text, t);
            if s.contains("\${") {
                out.append(substring(text, last, t.start - last));
                out.append(rewrite_string_code(s, own, aliases, file, whole, base + t.start));
                last = t.end;
            }
        } else if t.kind == SCAN_IDENT {
            var w = token_text(text, t);
            if w == "enum" && depth == 0 {
                enum_pending = true;
            }
            var has_prev = k > 0;
            var prev = t;
            if has_prev {
                prev = toks.get(sig.get(k - 1));
            }
            var has_next = k + 1 < sig.len;
            var next = t;
            if has_next {
                next = toks.get(sig.get(k + 1));
            }
            var after_member = has_prev && (is_punct(prev, '.') || prev.kind == SCAN_COLONCOLON);
            var handled = false;
            // `alias::name`
            if aliases.contains(w) && has_next && next.kind == SCAN_COLONCOLON && !after_member && k + 2 < sig.len {
                var name_tok = toks.get(sig.get(k + 2));
                if name_tok.kind == SCAN_IDENT {
                    var module = aliases.get(w).unwrap();
                    var name = token_text(text, name_tok);
                    if !module.items.contains(name) {
                        module_error(file, whole, base + name_tok.start, concat3("`", name, concat3("` isn't declared in ", module.file, "")));
                    }
                    if !module.public.contains(name) {
                        module_error(file, whole, base + name_tok.start, concat3("`", name, concat3("` is private to ", module.file, " (declare it `pub`)")));
                    }
                    out.append(substring(text, last, t.start - last));
                    out.append(module.prefix);
                    out.append(name);
                    last = name_tok.end;
                    k += 3;
                    handled = true;
                }
            }
            if !handled {
                // The module's own items
                if own != null && own.items.contains(w) && !after_member {
                    var declares_member = has_prev && token_text(text, prev) == "func" && depth > 0;
                    var is_variant = enum_depths.len > 0 && enum_depths.peek() == depth && has_prev && (is_punct(prev, '{') || is_punct(prev, ';'));
                    // A field (`name: type` in a struct, or `name: value` in
                    // a struct literal) isn't renamed; parameters, constants
                    // and variables are
                    var prev_word = "";
                    if has_prev {
                        prev_word = token_text(text, prev);
                    }
                    var is_label = has_next && is_punct(next, ':') && parens == 0 && prev_word != "const" && prev_word != "var";
                    if !declares_member && !is_variant && !is_label {
                        out.append(substring(text, last, t.start - last));
                        out.append(own.prefix);
                        out.append(w);
                        last = t.end;
                    }
                }
                k += 1;
            }
            continue;
        }
        k += 1;
    }
    out.append(substring(text, last, strlen(text) - last));
    return out.to_str();
}

// Rewrite the `${...}` parts of a string literal
func rewrite_string_code(s: str, own: &ModuleInfo, aliases: &Map<str, &ModuleInfo>, file: str, whole: str, base: int): str {
    var n = strlen(s);
    var out = StringBuilder::new();
    var last = 0;
    var i = 0;
    while i < n {
        if s[i] == '\\' {
            i += 2;
            continue;
        }
        if s[i] == '$' && i + 1 < n && s[i + 1] == '{' {
            var end = interpolation_end(s, n, i);
            var code = substring(s, i + 2, end - 1 - (i + 2));
            out.append(substring(s, last, i + 2 - last));
            out.append(rewrite_module_text(code, own, aliases, file, whole, base + i + 2));
            last = end - 1;
            i = end;
            continue;
        }
        i += 1;
    }
    out.append(substring(s, last, n - last));
    return out.to_str();
}

func module_error(file: str, whole: str, offset: int, message: str): ! {
    var line = 1;
    var i = 0;
    while i < offset && whole[i] != 0 {
        if whole[i] == '\n' {
            line += 1;
        }
        i += 1;
    }
    printf("error: %s:%ld: %s\n", file, line, message);
    exit(1);
}

// `import "path"` or `import "path" as name` on a line
struct ImportLine {
    path: str;
    // "" for a plain import
    alias: str;
}

func parse_import_line(line: str): Option<ImportLine> {
    var i = 0;
    while line[i] == ' ' || line[i] == '\t' {
        i += 1;
    }
    if strncmp(ptr_add(line, i), "import \"", 8) != 0 {
        return Option::None;
    }
    var start = i + 8;
    var end = start;
    while line[end] != '"' {
        if line[end] == 0 {
            return Option::None;
        }
        end += 1;
    }
    var path = substring(line, start, end - start);
    var rest = substring(line, end + 1, strlen(line) - end - 1).trim();
    if rest.ends_with(";") {
        rest = rest.slice(0, rest.len() - 1).trim();
    }
    if rest == "" {
        return Option::Some(ImportLine { path: path, alias: "" });
    }
    if !rest.starts_with("as") {
        return Option::None;
    }
    var name = rest.slice(2, rest.len()).trim();
    if name == "" || !is_ident_start(name[0] as int) {
        return Option::None;
    }
    var j = 0;
    while name[j] != 0 {
        if !is_ident_char(name[j] as int) {
            return Option::None;
        }
        j += 1;
    }
    return Option::Some(ImportLine { path: path, alias: name });
}
