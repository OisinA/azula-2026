// The self-hosted Azula compiler.
//
//   azula build FILE [-o OUT] [--emit-llvm] [--release] [--stdlib DIR]
//   azula run FILE [--release] [--stdlib DIR]
//
// Source is compiled to LLVM IR, which clang turns into an executable.

import "util.azl"
import "lexer.azl"
import "ast.azl"
import "parser.azl"
import "checker.azl"
import "codegen.azl"
import "modules.azl"

extern func readlink(str, str, int): int;
extern func mkdir(str, i32): i32;

struct Options {
    command: str;
    file: str;
    output: str;
    emit_llvm: bool;
    release: bool;
    stdlib: str;
}

func usage() {
    printf("usage: azula build FILE [-o OUT] [--emit-llvm] [--release] [--stdlib DIR]\n");
    printf("       azula run FILE [--release] [--stdlib DIR]\n");
    exit(1);
}

func parse_options(argc: i32, argv: &str): Options {
    var options = Options {
        command: "",
        file: "",
        output: "",
        emit_llvm: false,
        release: false,
        stdlib: "",
    };
    if argc < 3 {
        usage();
    }
    options.command = argv[1];
    if options.command != "build" && options.command != "run" {
        usage();
    }
    var i = 2;
    while i < argc {
        var arg = argv[i];
        if arg == "-o" && i + 1 < argc {
            options.output = argv[i + 1];
            i += 1;
        } else if arg == "--stdlib" && i + 1 < argc {
            options.stdlib = argv[i + 1];
            i += 1;
        } else if arg == "--emit-llvm" {
            options.emit_llvm = true;
        } else if arg == "--release" {
            options.release = true;
        } else if arg[0] == '-' {
            printf("unknown option %s\n", arg);
            usage();
        } else {
            options.file = arg;
        }
        i += 1;
    }
    if options.file == "" {
        usage();
    }
    return options;
}

// The directory holding the standard library
func find_stdlib(options: Options): str {
    if options.stdlib != "" {
        return options.stdlib;
    }
    var from_env = getenv("AZULA_STDLIB");
    if from_env != null {
        return from_env;
    }
    // Next to the compiler: <dir of executable>/../stdlib
    var exe: str = malloc(4096 * sizeof(u8));
    var n = readlink("/proc/self/exe", exe, 4095);
    if n > 0 {
        exe[n] = 0;
        var candidate = join_path(dir_name(dir_name(exe)), "stdlib");
        if file_exists(join_path(candidate, "vec.azl")) {
            return candidate;
        }
        candidate = join_path(dir_name(exe), "stdlib");
        if file_exists(join_path(candidate, "vec.azl")) {
            return candidate;
        }
    }
    if file_exists("stdlib/vec.azl") {
        return "stdlib";
    }
    fatal("can't find the standard library; use --stdlib DIR or set AZULA_STDLIB");
    return "";
}

// Add `path` and (recursively) the files it imports. A file imported `as` a
// name is a module: see modules.azl.
func add_module(src: &Source, path: str, alias: str, modules: &Map<str, &ModuleInfo>): &ModuleInfo {
    var real: str = malloc(4096 * sizeof(u8));
    if realpath(path, real) == null {
        fatal(concat("can't read ", path));
    }
    match modules.get(real) {
        Option::Some(existing) => {
            return existing;
        }
        Option::None => {}
    }
    var text = read_text_file(path);
    if text == null {
        fatal(concat("can't read ", path));
    }
    var prefix = "";
    if alias != "" {
        prefix = concat(alias, "__");
    }
    var info = new ModuleInfo { prefix: prefix, items: Map::new(), public: Map::new(), file: path };
    collect_items(text, info);
    modules.insert(real, info);

    // Dependencies first, noting the names modules are imported as
    var aliases: Map<str, &ModuleInfo> = Map::new();
    for line in text.split("\n") {
        match parse_import_line(line) {
            Option::Some(imp) => {
                var module = add_module(src, join_path(dir_name(path), imp.path), imp.alias, modules);
                if imp.alias != "" {
                    aliases.insert(imp.alias, module);
                }
            }
            Option::None => {}
        }
    }

    var own: &ModuleInfo = null;
    if prefix != "" {
        own = info;
    }
    src.add_file(path, rewrite_module_text(text, own, &aliases, path, text, 0));
    return info;
}

func run_command(command: str): int {
    var status = system(command);
    if status < 0 {
        return 1;
    }
    return (status >> 8) & 255;
}

func main(argc: i32, argv: &str) {
    var options = parse_options(argc, argv);
    var stdlib = find_stdlib(options);

    var src = new_source();
    var modules: Map<str, &ModuleInfo> = Map::new();
    add_module(src, join_path(stdlib, "libc.azl"), "", &modules);
    add_module(src, join_path(stdlib, "option.azl"), "", &modules);
    add_module(src, join_path(stdlib, "string.azl"), "", &modules);
    add_module(src, join_path(stdlib, "vec.azl"), "", &modules);
    add_module(src, join_path(stdlib, "map.azl"), "", &modules);
    add_module(src, join_path(stdlib, "interfaces.azl"), "", &modules);
    add_module(src, join_path(stdlib, "result.azl"), "", &modules);
    add_module(src, join_path(stdlib, "io.azl"), "", &modules);
    add_module(src, join_path(stdlib, "iter.azl"), "", &modules);
    add_module(src, join_path(stdlib, "math.azl"), "", &modules);
    add_module(src, join_path(stdlib, "gc.azl"), "", &modules);
    add_module(src, join_path(stdlib, "arena.azl"), "", &modules);
    add_module(src, options.file, "", &modules);

    var program = parse_program(src, lex(src));
    var checker = new_checker(src);
    checker.check_program(program);

    var name = options.file;
    if ends_with(name, ".azl") {
        name = substring(name, 0, strlen(name) - 4);
    }
    var output = options.output;
    mkdir(".build", 493);
    if output == "" {
        if options.command == "run" {
            output = join_path(".build", base_name(name));
        } else {
            output = name;
        }
    }

    var ir = generate(checker, base_name(name));
    var ir_path = concat3(".build/", base_name(name), ".ll");
    if options.emit_llvm {
        ir_path = concat(output, ".ll");
    }
    if !write_text_file(ir_path, ir) {
        fatal(concat("can't write ", ir_path));
    }

    var cc = getenv("AZULA_CC");
    if cc == null {
        cc = "clang";
    }
    var opt = "-O0";
    if options.release {
        opt = "-O2";
    }
    var command = StringBuilder::new();
    command.append(cc);
    command.append(" ");
    command.append(opt);
    command.append(" -w -o '");
    command.append(output);
    command.append("' '");
    command.append(ir_path);
    command.append("' -lm");
    if run_command(command.to_str()) != 0 {
        fatal("linking failed");
    }

    if options.command == "run" {
        var run = concat3("'", output, "'");
        if output[0] != '/' {
            run = concat3("'./", output, "'");
        }
        exit(run_command(run) as i32);
    }
}
