// Recursive descent parser producing the syntax tree.

const PREC_LOWEST: int = 0;
const PREC_OR: int = 1;
const PREC_AND: int = 2;
const PREC_EQUALS: int = 3;
const PREC_COMPARE: int = 4;
const PREC_BIT_OR: int = 5;
const PREC_BIT_XOR: int = 6;
const PREC_BIT_AND: int = 7;
const PREC_SHIFT: int = 8;
const PREC_SUM: int = 9;
const PREC_PRODUCT: int = 10;
const PREC_PREFIX: int = 11;
const PREC_CAST: int = 12;
const PREC_STRUCT: int = 13;
const PREC_CALL: int = 14;
const PREC_ACCESS: int = 15;

struct Parser {
    tokens: Vec<Token>;
    index: int;
    src: &Source;
    // A `>>` closed two lists of type arguments; the outer `>` is already consumed
    pending_gt: bool;
    // Bounds (`T is Show`) of the type parameters just parsed
    bounds: Vec<Bound>;
    // Whether the function just parsed had a body (interface methods may not)
    last_had_body: bool;

    func peek(): Token {
        return self.tokens.get(self.index);
    }

    func peek_at(offset: int): Token {
        var i = self.index + offset;
        if i >= self.tokens.len {
            i = self.tokens.len - 1;
        }
        return self.tokens.get(i);
    }

    func at(kind: Tok): bool {
        return self.peek().kind == kind;
    }

    func advance(): Token {
        var tok = self.peek();
        if tok.kind != Tok::Eof {
            self.index += 1;
        }
        return tok;
    }

    func accept(kind: Tok): bool {
        if self.at(kind) {
            self.advance();
            return true;
        }
        return false;
    }

    func expect(kind: Tok, what: str): Token {
        var tok = self.peek();
        if tok.kind != kind {
            self.src.fail(tok.pos, concat3("expected ", what, concat(", found ", tok_name(tok.kind))));
        }
        return self.advance();
    }

    func expect_ident(what: str): str {
        return self.expect(Tok::Ident, what).text;
    }

    // -----------------------------------------------------------------------
    // Items
    // -----------------------------------------------------------------------

    func parse_item(program: &Program) {
        var tok = self.peek();
        match tok.kind {
            Tok::KwFunc => {
                var f = self.parse_func();
                self.record_bounds(program, f.name);
                program.funcs.push(f);
            },
            Tok::KwInterface => { program.interfaces.push(self.parse_interface()); },
            Tok::KwExtern => { program.funcs.push(self.parse_extern()); },
            Tok::KwStruct => { program.structs.push(self.parse_struct(program)); },
            Tok::KwEnum => { program.enums.push(self.parse_enum(program)); },
            Tok::KwExtend => { program.impls.push(self.parse_extend(program)); },
            Tok::KwImpl => {
                self.src.fail(tok.pos, "`impl` blocks are gone: put methods in the type's body, or use `extend`");
            },
            Tok::KwType => {
                self.advance();
                var name = self.expect_ident("type alias name");
                self.expect(Tok::Assign, "`=`");
                var typ = self.parse_type();
                self.expect(Tok::Semi, "`;`");
                program.aliases.push(new AliasDecl { name: name, typ: typ, pos: tok.pos });
            },
            Tok::KwConst => { program.globals.push(self.parse_global()); },
            Tok::KwVar => {
                self.src.fail(tok.pos, "only constants are allowed at the top level");
            },
            Tok::KwImport => {
                self.advance();
                self.expect(Tok::Str, "import path");
            },
            Tok::Semi => { self.advance(); },
            _ => {
                self.src.fail(tok.pos, concat("expected a declaration, found ", tok_name(tok.kind)));
            },
        }
    }

    func parse_global(): &GlobalDecl {
        var pos = self.advance().pos;
        var name = self.expect_ident("constant name");
        var typ = Type::Infer;
        if self.accept(Tok::Colon) {
            typ = self.parse_type();
        }
        self.expect(Tok::Assign, "`=`");
        var value = self.parse_expr(PREC_LOWEST, true);
        self.expect(Tok::Semi, "`;`");
        return new GlobalDecl { name: name, typ: typ, value: value, pos: pos };
    }

    // `<T, U>` after a declaration's name
    func parse_type_params(): Vec<str> {
        var params: Vec<str> = Vec::new();
        if !self.accept(Tok::Lt) {
            return params;
        }
        while !self.accept(Tok::Gt) {
            var param = self.expect_ident("type parameter");
            params.push(param);
            // `T is A + B`
            if self.at(Tok::Ident) && self.peek().text == "is" {
                self.advance();
                self.bounds.push(Bound { param: param, iface: self.expect_ident("interface name") });
                while self.accept(Tok::Plus) {
                    self.bounds.push(Bound { param: param, iface: self.expect_ident("interface name") });
                }
            }
            if !self.at(Tok::Gt) {
                self.expect(Tok::Comma, "`,` or `>`");
            }
        }
        return params;
    }

    // Keep the bounds just parsed as those of generic `name`
    func record_bounds(program: &Program, name: str) {
        if self.bounds.len > 0 {
            program.bounds.insert(name, self.bounds);
            self.bounds = Vec::new();
        }
    }

    // An optional `is A, B` list of interfaces a type implements
    func parse_is_list(): Vec<str> {
        var interfaces: Vec<str> = Vec::new();
        if !self.at(Tok::Ident) || self.peek().text != "is" {
            return interfaces;
        }
        self.advance();
        interfaces.push(self.expect_ident("interface name"));
        while self.accept(Tok::Comma) {
            interfaces.push(self.expect_ident("interface name"));
        }
        return interfaces;
    }

    // Record that the type `name<type_params>` implements `interfaces`
    static func add_conformance(program: &Program, name: str, type_params: Vec<str>, interfaces: Vec<str>, pos: int) {
        if interfaces.len == 0 {
            return;
        }
        var target = Type::Named(name);
        if type_params.len > 0 {
            var args: Vec<Type> = Vec::new();
            var i = 0;
            while i < type_params.len {
                args.push(Type::Named(type_params.get(i)));
                i += 1;
            }
            target = Type::Generic(name, args);
        }
        program.conformances.push(new Conformance { target: target, interfaces: interfaces, pos: pos });
    }

    // `interface Name { func m(args): R; func d(): R { default body } }`.
    // Methods without a body always take `self`.
    func parse_interface(): &InterfaceDecl {
        var pos = self.advance().pos;
        var name = self.expect_ident("interface name");
        var methods: Vec<&FuncDecl> = Vec::new();
        var has_body: Vec<bool> = Vec::new();
        self.expect(Tok::LBrace, "`{`");
        while !self.accept(Tok::RBrace) {
            if !self.at_method() {
                self.src.fail(self.peek().pos, "expected a method");
            }
            var f = self.parse_method_or_signature(true);
            methods.push(f);
            has_body.push(self.last_had_body);
        }
        return new InterfaceDecl { name: name, methods: methods, has_body: has_body, pos: pos };
    }

    func parse_func(): &FuncDecl {
        return self.parse_func_or_signature(false);
    }

    // A function; with `allow_signature`, `func name(args): R;` without a body too
    func parse_func_or_signature(allow_signature: bool): &FuncDecl {
        var pos = self.advance().pos;
        var name = self.expect_ident("function name");
        var type_params = self.parse_type_params();
        var params: Vec<Param> = Vec::new();
        if self.accept(Tok::LParen) {
            while !self.accept(Tok::RParen) {
                var pname = self.expect_ident("parameter name");
                self.expect(Tok::Colon, "`:`");
                params.push(Param { name: pname, typ: self.parse_type() });
                if !self.at(Tok::RParen) {
                    self.expect(Tok::Comma, "`,` or `)`");
                }
            }
        }
        var ret = Type::Void;
        if self.accept(Tok::Colon) {
            ret = self.parse_type();
        }
        var body: Vec<&Stmt> = Vec::new();
        self.last_had_body = true;
        if allow_signature && self.accept(Tok::Semi) {
            self.last_had_body = false;
        } else {
            self.expect(Tok::LBrace, "`{`");
            body = self.parse_block_body();
        }
        return new FuncDecl {
            name: name,
            type_params: type_params,
            params: params,
            ret: ret,
            body: body,
            pos: pos,
            is_extern: false,
            is_varargs: false,
            symbol: name,
        };
    }

    func parse_extern(): &FuncDecl {
        var pos = self.advance().pos;
        var is_varargs = self.accept(Tok::KwVarargs);
        self.expect(Tok::KwFunc, "`func`");
        var name = self.expect_ident("function name");
        var params: Vec<Param> = Vec::new();
        if self.accept(Tok::LParen) {
            while !self.accept(Tok::RParen) {
                params.push(Param { name: "_", typ: self.parse_type() });
                if !self.at(Tok::RParen) {
                    self.expect(Tok::Comma, "`,` or `)`");
                }
            }
        }
        var ret = Type::Void;
        if self.accept(Tok::Colon) {
            ret = self.parse_type();
        }
        self.expect(Tok::Semi, "`;`");
        return new FuncDecl {
            name: name,
            type_params: Vec::new(),
            params: params,
            ret: ret,
            body: Vec::new(),
            pos: pos,
            is_extern: true,
            is_varargs: is_varargs,
            symbol: name,
        };
    }

    // A struct: `name: Type;` fields and methods
    func parse_struct(program: &Program): &StructDecl {
        var pos = self.advance().pos;
        var name = self.expect_ident("struct name");
        var type_params = self.parse_type_params();
        self.record_bounds(program, name);
        var interfaces = self.parse_is_list();
        var fields: Vec<Param> = Vec::new();
        var methods: Vec<&FuncDecl> = Vec::new();
        self.expect(Tok::LBrace, "`{`");
        while !self.accept(Tok::RBrace) {
            if self.at_method() {
                methods.push(self.parse_method());
                continue;
            }
            var fname = self.expect_ident("field or method");
            self.expect(Tok::Colon, "`:`");
            fields.push(Param { name: fname, typ: self.parse_type() });
            self.expect(Tok::Semi, "`;`");
        }
        Parser::add_methods(program, name, type_params, methods, pos);
        Parser::add_conformance(program, name, type_params, interfaces, pos);
        return new StructDecl { name: name, type_params: type_params, fields: fields, pos: pos };
    }

    // A function in a type's body. It's a method, receiving `self`, if its body uses `self`.
    func parse_method(): &FuncDecl {
        return self.parse_method_or_signature(false);
    }

    // A method, or (with `allow_signature`) an interface method signature,
    // which always takes `self`
    func parse_method_or_signature(allow_signature: bool): &FuncDecl {
        var is_static = self.accept(Tok::KwStatic);
        var f = self.parse_func_or_signature(allow_signature);
        // Bounds on a method's own type parameters aren't checked
        self.bounds = Vec::new();
        if !is_static {
            var params: Vec<Param> = Vec::new();
            params.push(Param { name: "self", typ: Type::Named("__self") });
            var i = 0;
            while i < f.params.len {
                params.push(f.params.get(i));
                i += 1;
            }
            f.params = params;
        }
        return f;
    }

    // Does a method (`func` or `static func`) start here?
    func at_method(): bool {
        return self.at(Tok::KwFunc) || self.at(Tok::KwStatic);
    }

    // Record the methods declared in the body of type `name`
    static func add_methods(program: &Program, name: str, type_params: Vec<str>, methods: Vec<&FuncDecl>, pos: int) {
        if methods.len == 0 {
            return;
        }
        var target = Type::Named(name);
        if type_params.len > 0 {
            var args: Vec<Type> = Vec::new();
            var i = 0;
            while i < type_params.len {
                args.push(Type::Named(type_params.get(i)));
                i += 1;
            }
            target = Type::Generic(name, args);
        }
        program.impls.push(new ImplDecl { target: target, type_params: type_params, methods: methods, pos: pos });
    }

    // An enum: `Variant(Types);` variants and methods
    func parse_enum(program: &Program): &EnumDecl {
        var pos = self.advance().pos;
        var name = self.expect_ident("enum name");
        var type_params = self.parse_type_params();
        self.record_bounds(program, name);
        var interfaces = self.parse_is_list();
        var variants: Vec<Variant> = Vec::new();
        var methods: Vec<&FuncDecl> = Vec::new();
        self.expect(Tok::LBrace, "`{`");
        while !self.accept(Tok::RBrace) {
            if self.at_method() {
                methods.push(self.parse_method());
                continue;
            }
            var vname = self.expect_ident("variant or method");
            var payload: Vec<Type> = Vec::new();
            if self.accept(Tok::LParen) {
                while !self.accept(Tok::RParen) {
                    payload.push(self.parse_type());
                    if !self.at(Tok::RParen) {
                        self.expect(Tok::Comma, "`,` or `)`");
                    }
                }
            }
            variants.push(Variant { name: vname, payload: payload });
            self.expect(Tok::Semi, "`;`");
        }
        Parser::add_methods(program, name, type_params, methods, pos);
        Parser::add_conformance(program, name, type_params, interfaces, pos);
        return new EnumDecl { name: name, type_params: type_params, variants: variants, pos: pos };
    }

    // `extend Type { methods }`
    func parse_extend(program: &Program): &ImplDecl {
        var pos = self.advance().pos;
        var type_params: Vec<str> = Vec::new();
        var target = self.parse_type();
        // `extend Vec<T>` declares T
        match target {
            Type::Generic(_, args) => {
                var i = 0;
                while i < args.len {
                    var name = named_of(args.get(i));
                    if name != "" && !contains_str(type_params, name) {
                        type_params.push(name);
                    }
                    i += 1;
                }
            },
            _ => {},
        }
        // `extend Type is A, B { ... }`
        var interfaces = self.parse_is_list();
        if interfaces.len > 0 {
            program.conformances.push(new Conformance { target: target, interfaces: interfaces, pos: pos });
        }
        var methods: Vec<&FuncDecl> = Vec::new();
        self.expect(Tok::LBrace, "`{`");
        while !self.accept(Tok::RBrace) {
            if self.accept(Tok::Semi) {
                continue;
            }
            if !self.at_method() {
                self.src.fail(self.peek().pos, "expected a method");
            }
            methods.push(self.parse_method());
        }
        return new ImplDecl { target: target, type_params: type_params, methods: methods, pos: pos };
    }

    // -----------------------------------------------------------------------
    // Types
    // -----------------------------------------------------------------------

    func parse_type(): Type {
        var tok = self.advance();
        match tok.kind {
            Tok::Amp => { return Type::Ptr(self.parse_type()); },
            Tok::Bang => { return Type::Never; },
            // `func(A, B): R`
            Tok::KwFunc => {
                self.expect(Tok::LParen, "`(`");
                var params: Vec<Type> = Vec::new();
                while !self.accept(Tok::RParen) {
                    params.push(self.parse_type());
                    if !self.at(Tok::RParen) {
                        self.expect(Tok::Comma, "`,` or `)`");
                    }
                }
                var ret = Type::Void;
                if self.accept(Tok::Colon) {
                    ret = self.parse_type();
                }
                return Type::Func(params, ret);
            },
            // `(A, B)` is a tuple; `(A)` is just A
            Tok::LParen => {
                var items: Vec<Type> = Vec::new();
                items.push(self.parse_type());
                while self.accept(Tok::Comma) {
                    items.push(self.parse_type());
                }
                self.expect(Tok::RParen, "`)`");
                if items.len == 1 {
                    return items.get(0);
                }
                return Type::Tuple(items);
            },
            Tok::AmpAmp => { return Type::Ptr(Type::Ptr(self.parse_type())); },
            Tok::LBracket => {
                var inner = self.parse_type();
                var size = -1;
                if self.accept(Tok::Semi) {
                    size = self.expect(Tok::Int, "array size").value;
                }
                self.expect(Tok::RBracket, "`]`");
                return Type::Array(inner, size);
            },
            Tok::Ident => {
                var base = type_from_name(tok.text);
                if named_of(base) != "" && self.at(Tok::Lt) {
                    return Type::Generic(tok.text, self.parse_type_args());
                }
                return base;
            },
            _ => {
                self.src.fail(tok.pos, concat("expected a type, found ", tok_name(tok.kind)));
                return Type::Void;
            },
        }
    }

    // `<A, B>` type arguments
    func parse_type_args(): Vec<Type> {
        self.expect(Tok::Lt, "`<`");
        var args: Vec<Type> = Vec::new();
        while true {
            args.push(self.parse_type());
            if self.pending_gt {
                self.pending_gt = false;
                return args;
            }
            if self.accept(Tok::Comma) {
                continue;
            }
            if self.accept(Tok::Gt) {
                return args;
            }
            if self.accept(Tok::Shr) {
                // `>>` closes this list and the enclosing one
                self.pending_gt = true;
                return args;
            }
            self.expect(Tok::Gt, "`>`");
        }
        return args;
    }

    // -----------------------------------------------------------------------
    // Statements
    // -----------------------------------------------------------------------

    // Statements up to and including the closing `}` (the `{` is already consumed)
    func parse_block_body(): Vec<&Stmt> {
        var body: Vec<&Stmt> = Vec::new();
        while !self.accept(Tok::RBrace) {
            if self.at(Tok::Eof) {
                self.src.fail(self.peek().pos, "expected `}`");
            }
            if self.accept(Tok::Semi) {
                continue;
            }
            body.push(self.parse_stmt());
        }
        return body;
    }

    func parse_stmt(): &Stmt {
        var tok = self.peek();
        var pos = tok.pos;
        match tok.kind {
            Tok::KwVar => { return self.parse_var_decl(true); },
            Tok::KwConst => { return self.parse_var_decl(false); },
            Tok::KwReturn => {
                self.advance();
                if self.accept(Tok::Semi) {
                    return new_stmt(StmtKind::Return(Option::None), pos);
                }
                var value = self.parse_expr(PREC_LOWEST, true);
                self.expect(Tok::Semi, "`;`");
                return new_stmt(StmtKind::Return(Option::Some(value)), pos);
            },
            Tok::KwIf => { return self.parse_if(); },
            Tok::KwWhile => {
                self.advance();
                var cond = self.parse_expr(PREC_LOWEST, false);
                self.expect(Tok::LBrace, "`{`");
                var body = self.parse_block_body();
                return new_stmt(StmtKind::Loop(Option::Some(cond), body), pos);
            },
            Tok::KwFor => {
                self.advance();
                if self.at(Tok::Ident) && self.peek_at(1).kind == Tok::KwIn {
                    var name = self.advance().text;
                    self.advance();
                    var iterable = self.parse_expr(PREC_LOWEST, false);
                    var end: Option<&Expr> = Option::None;
                    var inclusive = false;
                    if self.at(Tok::DotDot) || self.at(Tok::DotDotEq) {
                        inclusive = self.advance().kind == Tok::DotDotEq;
                        end = Option::Some(self.parse_expr(PREC_LOWEST, false));
                    }
                    self.expect(Tok::LBrace, "`{`");
                    var body = self.parse_block_body();
                    return new_stmt(StmtKind::ForIn(name, iterable, end, inclusive, body), pos);
                }
                var cond: Option<&Expr> = Option::None;
                if !self.at(Tok::LBrace) {
                    cond = Option::Some(self.parse_expr(PREC_LOWEST, false));
                }
                self.expect(Tok::LBrace, "`{`");
                var body = self.parse_block_body();
                return new_stmt(StmtKind::Loop(cond, body), pos);
            },
            Tok::KwBreak => {
                self.advance();
                self.accept(Tok::Semi);
                return new_stmt(StmtKind::Break, pos);
            },
            Tok::KwContinue => {
                self.advance();
                self.accept(Tok::Semi);
                return new_stmt(StmtKind::Continue, pos);
            },
            _ => {
                var expr = self.parse_expr(PREC_LOWEST, true);
                if self.accept(Tok::Assign) {
                    var value = self.parse_expr(PREC_LOWEST, true);
                    self.expect(Tok::Semi, "`;`");
                    return new_stmt(StmtKind::Assign(expr, value), pos);
                }
                if self.at(Tok::OpAssign) {
                    return self.parse_compound_assign(expr, pos);
                }
                // A `match` statement doesn't need a semicolon
                if is_match_expr(expr) {
                    self.accept(Tok::Semi);
                } else {
                    self.expect(Tok::Semi, "`;`");
                }
                return new_stmt(StmtKind::ExprStmt(expr), pos);
            },
        }
    }

    func parse_compound_assign(target: &Expr, pos: int): &Stmt {
        var op = binop_for_text(self.advance().text);
        var value = self.parse_expr(PREC_LOWEST, true);
        self.expect(Tok::Semi, "`;`");
        return new_stmt(StmtKind::CompoundAssign(op, target, value), pos);
    }

    func parse_var_decl(mutable: bool): &Stmt {
        var pos = self.advance().pos;
        // `var (a, b) = tuple;`
        if self.accept(Tok::LParen) {
            var names: Vec<str> = Vec::new();
            while !self.accept(Tok::RParen) {
                names.push(self.expect_ident("name to bind"));
                if !self.at(Tok::RParen) {
                    self.expect(Tok::Comma, "`,` or `)`");
                }
            }
            self.expect(Tok::Assign, "`=`");
            var tuple = self.parse_expr(PREC_LOWEST, true);
            self.expect(Tok::Semi, "`;`");
            return new_stmt(StmtKind::Destructure(names, mutable, tuple), pos);
        }
        var name = self.expect_ident("variable name");
        var typ = Type::Infer;
        if self.accept(Tok::Colon) {
            typ = self.parse_type();
        }
        self.expect(Tok::Assign, "`=`");
        var value = self.parse_expr(PREC_LOWEST, true);
        self.expect(Tok::Semi, "`;`");
        return new_stmt(StmtKind::VarDecl(name, mutable, typ, value), pos);
    }

    func parse_if(): &Stmt {
        var pos = self.advance().pos;
        var cond = self.parse_expr(PREC_LOWEST, false);
        self.expect(Tok::LBrace, "`{`");
        var body = self.parse_block_body();
        var else_body: Vec<&Stmt> = Vec::new();
        if self.accept(Tok::KwElse) {
            if self.at(Tok::KwIf) {
                else_body.push(self.parse_if());
            } else {
                self.expect(Tok::LBrace, "`{`");
                else_body = self.parse_block_body();
            }
        }
        return new_stmt(StmtKind::If(cond, body, else_body), pos);
    }

    // -----------------------------------------------------------------------
    // Expressions
    // -----------------------------------------------------------------------

    // A string literal, which may interpolate expressions with `${...}`
    func parse_string(raw: str, pos: int): &Expr {
        var base = pos + 1;
        var parts: Vec<&Expr> = Vec::new();
        var literal_start = 0;
        var i = 0;
        while raw[i] != 0 {
            if raw[i] == '\\' {
                i += 2;
                continue;
            }
            if raw[i] == '$' && raw[i + 1] == '{' {
                if literal_start < i {
                    var text = unescape(self.src, substring(raw, literal_start, i - literal_start), base + literal_start);
                    parts.push(new_expr(ExprKind::StrLit(text), base + literal_start));
                }
                var close = skip_interpolation(self.src, self.src.text.to_str(), base + i) - 1;
                var sub = Parser { tokens: lex_range(self.src, base + i + 2, close), index: 0, src: self.src, pending_gt: false, bounds: Vec::new(), last_had_body: true };
                parts.push(sub.parse_expr(PREC_LOWEST, true));
                if !sub.at(Tok::Eof) {
                    self.src.fail(sub.peek().pos, "expected `}` to end the interpolated expression");
                }
                i = close - base + 1;
                literal_start = i;
                continue;
            }
            i += 1;
        }
        if literal_start == 0 {
            return new_expr(ExprKind::StrLit(unescape(self.src, raw, base)), pos);
        }
        if raw[literal_start] != 0 {
            var text = unescape(self.src, substring(raw, literal_start, strlen(raw) - literal_start), base + literal_start);
            parts.push(new_expr(ExprKind::StrLit(text), base + literal_start));
        }
        return new_expr(ExprKind::Interpolate(parts), pos);
    }

    func parse_expr(precedence: int, allow_struct: bool): &Expr {
        var left = self.parse_prefix(allow_struct);
        while precedence < infix_precedence(self.peek().kind, allow_struct) {
            left = self.parse_infix(left, allow_struct);
        }
        return left;
    }

    func parse_prefix(allow_struct: bool): &Expr {
        var tok = self.advance();
        var pos = tok.pos;
        match tok.kind {
            Tok::Int => { return new_expr(ExprKind::IntLit(tok.value), pos); },
            Tok::Float => { return new_expr(ExprKind::FloatLit(tok.text), pos); },
            Tok::Char => { return new_expr(ExprKind::IntLit(char_value(tok.text)), pos); },
            Tok::Str => { return self.parse_string(tok.text, pos); },
            Tok::KwTrue => { return new_expr(ExprKind::BoolLit(true), pos); },
            Tok::KwFalse => { return new_expr(ExprKind::BoolLit(false), pos); },
            Tok::KwNull => { return new_expr(ExprKind::Null, pos); },
            Tok::LParen => {
                var inner = self.parse_expr(PREC_LOWEST, true);
                // `(a, b, ...)` is a tuple
                if self.at(Tok::Comma) {
                    var items: Vec<&Expr> = Vec::new();
                    items.push(inner);
                    while self.accept(Tok::Comma) {
                        items.push(self.parse_expr(PREC_LOWEST, true));
                    }
                    self.expect(Tok::RParen, "`)`");
                    return new_expr(ExprKind::Tuple(items), pos);
                }
                self.expect(Tok::RParen, "`)`");
                return inner;
            },
            Tok::Bang => {
                return new_expr(ExprKind::Unary(UnOp::Not, self.parse_expr(PREC_PREFIX, allow_struct)), pos);
            },
            Tok::Minus => {
                return new_expr(ExprKind::Unary(UnOp::Neg, self.parse_expr(PREC_PREFIX, allow_struct)), pos);
            },
            Tok::Star => {
                return new_expr(ExprKind::Deref(self.parse_expr(PREC_PREFIX, allow_struct)), pos);
            },
            Tok::Tilde => {
                return new_expr(ExprKind::Unary(UnOp::BitNot, self.parse_expr(PREC_PREFIX, allow_struct)), pos);
            },
            Tok::Amp => {
                return new_expr(ExprKind::AddrOf(self.parse_expr(PREC_PREFIX, true)), pos);
            },
            Tok::LBracket => { return self.parse_array_lit(pos); },
            Tok::KwMatch => { return self.parse_match(pos); },
            Tok::KwFunc => { return self.parse_closure(pos); },
            Tok::Ident => {
                // `new Type { ... }` allocates a struct on the heap
                if tok.text != "new" || !self.at(Tok::Ident) {
                    return new_expr(ExprKind::Ident(tok.text), pos);
                }
                var inner = self.parse_expr(PREC_PREFIX, true);
                if !is_struct_lit(inner) {
                    self.src.fail(pos, "`new` needs a struct literal");
                }
                // `new Type { ... } in arena` (`in` is only special here)
                if self.accept(Tok::KwIn) {
                    var arena = self.parse_expr(PREC_PREFIX, false);
                    return new_expr(ExprKind::AllocIn(inner, arena), pos);
                }
                return new_expr(ExprKind::Alloc(inner), pos);
            },
            Tok::KwSizeof => {
                self.expect(Tok::LParen, "`(`");
                var typ = self.parse_type();
                self.expect(Tok::RParen, "`)`");
                return new_expr(ExprKind::SizeOf(typ), pos);
            },
            _ => {
                self.src.fail(pos, concat("expected an expression, found ", tok_name(tok.kind)));
                return new_expr(ExprKind::Null, pos);
            },
        }
    }

    // A closure, after `func`: `(a: A, b)` parameters, an optional `: R`
    // return type, then `{ body }` or `=> value`
    func parse_closure(pos: int): &Expr {
        self.expect(Tok::LParen, "`(`");
        var params: Vec<Param> = Vec::new();
        while !self.accept(Tok::RParen) {
            var name = self.expect_ident("parameter name");
            var typ = Type::Infer;
            if self.accept(Tok::Colon) {
                typ = self.parse_type();
            }
            params.push(Param { name: name, typ: typ });
            if !self.at(Tok::RParen) {
                self.expect(Tok::Comma, "`,` or `)`");
            }
        }
        var ret = Type::Infer;
        if self.accept(Tok::Colon) {
            ret = self.parse_type();
        }
        var body: Vec<&Stmt> = Vec::new();
        if self.accept(Tok::FatArrow) {
            var value_pos = self.peek().pos;
            var value = self.parse_expr(PREC_LOWEST, true);
            body.push(new_stmt(StmtKind::Return(Option::Some(value)), value_pos));
        } else {
            self.expect(Tok::LBrace, "`{` or `=>`");
            body = self.parse_block_body();
        }
        return new_expr(ExprKind::Closure(params, ret, body), pos);
    }

    func parse_array_lit(pos: int): &Expr {
        var items: Vec<&Expr> = Vec::new();
        if self.accept(Tok::RBracket) {
            return new_expr(ExprKind::ArrayLit(items), pos);
        }
        var first = self.parse_expr(PREC_LOWEST, true);
        items.push(first);
        // `[value; count]` repeats the value
        if self.accept(Tok::Semi) {
            var count = self.expect(Tok::Int, "array length").value;
            var i = 1;
            while i < count {
                items.push(first);
                i += 1;
            }
            self.expect(Tok::RBracket, "`]`");
            return new_expr(ExprKind::ArrayLit(items), pos);
        }
        while self.accept(Tok::Comma) {
            if self.at(Tok::RBracket) {
                break;
            }
            items.push(self.parse_expr(PREC_LOWEST, true));
        }
        self.expect(Tok::RBracket, "`]`");
        return new_expr(ExprKind::ArrayLit(items), pos);
    }

    func parse_infix(left: &Expr, allow_struct: bool): &Expr {
        var tok = self.advance();
        var pos = tok.pos;
        match tok.kind {
            Tok::KwAs => { return new_expr(ExprKind::Cast(left, self.parse_type()), left.pos); },
            Tok::Dot => {
                // `tuple.0`
                if self.at(Tok::Int) {
                    return new_expr(ExprKind::Field(left, int_to_str(self.advance().value)), left.pos);
                }
                var name = self.expect_ident("field or method name");
                // A generic method with type arguments: `value.method::<T>(...)`
                if self.at(Tok::ColonColon) && self.peek_at(1).kind == Tok::Lt {
                    self.advance();
                    return new_expr(ExprKind::MethodTurbofish(left, name, self.parse_type_args()), left.pos);
                }
                return new_expr(ExprKind::Field(left, name), left.pos);
            },
            Tok::ColonColon => {
                if self.at(Tok::Lt) {
                    // Turbofish: `Name::<Types>`
                    var name = match left.kind {
                        ExprKind::Ident(n) => n,
                        _ => {
                            self.src.fail(pos, "type arguments can only follow a name");
                            ""
                        },
                    };
                    return new_expr(ExprKind::Turbofish(name, self.parse_type_args()), left.pos);
                }
                var member = self.expect_ident("name after `::`");
                return new_expr(ExprKind::Path(left, member), left.pos);
            },
            Tok::LParen => {
                var args: Vec<&Expr> = Vec::new();
                while !self.accept(Tok::RParen) {
                    args.push(self.parse_expr(PREC_LOWEST, true));
                    if !self.at(Tok::RParen) {
                        self.expect(Tok::Comma, "`,` or `)`");
                    }
                }
                return new_expr(ExprKind::Call(left, args), left.pos);
            },
            Tok::LBracket => {
                var index = self.parse_expr(PREC_LOWEST, true);
                self.expect(Tok::RBracket, "`]`");
                return new_expr(ExprKind::Index(left, index), left.pos);
            },
            Tok::LBrace => { return self.parse_struct_lit(left); },
            Tok::Question => { return new_expr(ExprKind::Try(left), left.pos); },
            _ => {
                var precedence = infix_precedence(tok.kind, allow_struct);
                var right = self.parse_expr(precedence, allow_struct);
                if tok.kind == Tok::StarStar {
                    self.src.fail(pos, "`**` is not supported");
                }
                return new_expr(ExprKind::Binary(binop_for(tok.kind), left, right), left.pos);
            },
        }
    }

    func parse_struct_lit(name: &Expr): &Expr {
        var fields: Vec<FieldInit> = Vec::new();
        while !self.accept(Tok::RBrace) {
            var field_tok = self.expect(Tok::Ident, "field name");
            self.expect(Tok::Colon, "`:`");
            var value = self.parse_expr(PREC_LOWEST, true);
            fields.push(FieldInit { name: field_tok.text, value: value, pos: field_tok.pos });
            if !self.at(Tok::RBrace) {
                self.expect(Tok::Comma, "`,` or `}`");
            }
        }
        return new_expr(ExprKind::StructLit(name, fields), name.pos);
    }

    func parse_match(pos: int): &Expr {
        var scrutinee = self.parse_expr(PREC_LOWEST, false);
        self.expect(Tok::LBrace, "`{`");
        var arms: Vec<&MatchArm> = Vec::new();
        while !self.accept(Tok::RBrace) {
            if self.accept(Tok::Comma) {
                continue;
            }
            var arm_pos = self.peek().pos;
            var pattern = self.parse_pattern(false);
            self.expect(Tok::FatArrow, "`=>`");
            var body_pos = self.peek().pos;
            var body = new_expr(ExprKind::Null, body_pos);
            if self.accept(Tok::LBrace) {
                body = self.parse_block_expr(body_pos);
            } else {
                body = self.parse_expr(PREC_LOWEST, false);
            }
            arms.push(new MatchArm {
                pattern: pattern,
                body: body,
                pos: arm_pos,
                enum_name: "",
                tag: 0,
                bindings: Vec::new(),
                tests: Vec::new(),
                binds: Vec::new(),
            });
        }
        return new_expr(ExprKind::Match(scrutinee, arms), pos);
    }

    // A match pattern. Inside a tuple pattern (`in_tuple`), a plain name binds
    // the element.
    func parse_pattern(in_tuple: bool): Pattern {
        var tok = self.advance();
        match tok.kind {
            Tok::LParen => {
                var items: Vec<Pattern> = Vec::new();
                items.push(self.parse_pattern(true));
                while self.accept(Tok::Comma) {
                    items.push(self.parse_pattern(true));
                }
                self.expect(Tok::RParen, "`)`");
                return Pattern::Tuple(items);
            },
            Tok::Int => { return Pattern::IntValue(tok.value); },
            Tok::Char => { return Pattern::IntValue(char_value(tok.text)); },
            Tok::Minus => { return Pattern::IntValue(0 - self.expect(Tok::Int, "integer").value); },
            Tok::Ident => {
                if tok.text == "_" {
                    return Pattern::Wildcard;
                }
                if in_tuple && !self.at(Tok::ColonColon) {
                    return Pattern::Binding(tok.text);
                }
                self.expect(Tok::ColonColon, "`::`");
                var variant = self.expect_ident("variant name");
                var bindings: Vec<str> = Vec::new();
                if self.accept(Tok::LParen) {
                    while !self.accept(Tok::RParen) {
                        bindings.push(self.expect_ident("binding name"));
                        if !self.at(Tok::RParen) {
                            self.expect(Tok::Comma, "`,` or `)`");
                        }
                    }
                }
                return Pattern::Variant(tok.text, variant, bindings);
            },
            _ => {
                self.src.fail(tok.pos, "expected a pattern");
                return Pattern::Wildcard;
            },
        }
    }

    // A `{ statements; value }` block (the `{` is already consumed)
    func parse_block_expr(pos: int): &Expr {
        var stmts: Vec<&Stmt> = Vec::new();
        var value: Option<&Expr> = Option::None;
        while !self.accept(Tok::RBrace) {
            if self.accept(Tok::Semi) {
                continue;
            }
            var kind = self.peek().kind;
            if kind == Tok::KwVar || kind == Tok::KwConst || kind == Tok::KwIf || kind == Tok::KwWhile
                || kind == Tok::KwFor || kind == Tok::KwReturn || kind == Tok::KwBreak || kind == Tok::KwContinue {
                stmts.push(self.parse_stmt());
                continue;
            }
            var stmt_pos = self.peek().pos;
            var expr = self.parse_expr(PREC_LOWEST, true);
            if self.accept(Tok::Assign) {
                var rhs = self.parse_expr(PREC_LOWEST, true);
                self.expect(Tok::Semi, "`;`");
                stmts.push(new_stmt(StmtKind::Assign(expr, rhs), stmt_pos));
            } else if self.at(Tok::OpAssign) {
                stmts.push(self.parse_compound_assign(expr, stmt_pos));
            } else if self.accept(Tok::Semi) {
                stmts.push(new_stmt(StmtKind::ExprStmt(expr), stmt_pos));
            } else if self.at(Tok::RBrace) {
                self.advance();
                value = Option::Some(expr);
                return new_expr(ExprKind::Block(stmts, value), pos);
            } else if is_match_expr(expr) {
                stmts.push(new_stmt(StmtKind::ExprStmt(expr), stmt_pos));
            } else {
                self.expect(Tok::Semi, "`;` or `}`");
            }
        }
        return new_expr(ExprKind::Block(stmts, value), pos);
    }
}

func new_program(): &Program {
    return new Program {
        funcs: Vec::new(),
        structs: Vec::new(),
        enums: Vec::new(),
        impls: Vec::new(),
        globals: Vec::new(),
        aliases: Vec::new(),
        interfaces: Vec::new(),
        conformances: Vec::new(),
        bounds: Map::new(),
    };
}

func parse_program(src: &Source, tokens: Vec<Token>): &Program {
    var p = Parser { tokens: tokens, index: 0, src: src, pending_gt: false, bounds: Vec::new(), last_had_body: true };
    var program = new_program();
    while !p.at(Tok::Eof) {
        p.parse_item(program);
    }
    return program;
}

// Process the escapes in the raw contents of a string literal
func unescape(src: &Source, raw: str, pos: int): str {
    var sb = StringBuilder::new();
    var i = 0;
    while raw[i] != 0 {
        var c: int = raw[i];
        if c == '\\' {
            i += 1;
            var e: int = raw[i];
            if e == 'n' { sb.append_char(10); }
            else if e == 't' { sb.append_char(9); }
            else if e == 'r' { sb.append_char(13); }
            else if e == '0' { sb.append_char(0); }
            else if e == '\\' { sb.append_char('\\'); }
            else if e == '"' { sb.append_char('"'); }
            else if e == '\'' { sb.append_char('\''); }
            else if e == '$' { sb.append_char('$'); }
            else if e == 'x' {
                sb.append_char(hex_value(raw[i + 1] as int) * 16 + hex_value(raw[i + 2] as int));
                i += 2;
            } else {
                src.fail(pos + i, "invalid escape sequence");
            }
        } else {
            sb.append_char(c);
        }
        i += 1;
    }
    return sb.to_str();
}

// The value of a character literal's raw contents
func char_value(raw: str): int {
    if raw[0] == '\\' {
        var e: int = raw[1];
        if e == 'n' { return 10; }
        if e == 't' { return 9; }
        if e == 'r' { return 13; }
        if e == '0' { return 0; }
        return e;
    }
    return raw[0] as int;
}

func infix_precedence(kind: Tok, allow_struct: bool): int {
    return match kind {
        Tok::PipePipe => PREC_OR,
        Tok::AmpAmp => PREC_AND,
        Tok::EqEq => PREC_EQUALS,
        Tok::NotEq => PREC_EQUALS,
        Tok::Lt => PREC_COMPARE,
        Tok::Le => PREC_COMPARE,
        Tok::Gt => PREC_COMPARE,
        Tok::Ge => PREC_COMPARE,
        Tok::Pipe => PREC_BIT_OR,
        Tok::Caret => PREC_BIT_XOR,
        Tok::Amp => PREC_BIT_AND,
        Tok::Shl => PREC_SHIFT,
        Tok::Shr => PREC_SHIFT,
        Tok::Plus => PREC_SUM,
        Tok::Minus => PREC_SUM,
        Tok::Star => PREC_PRODUCT,
        Tok::Slash => PREC_PRODUCT,
        Tok::Percent => PREC_PRODUCT,
        Tok::StarStar => PREC_PRODUCT,
        Tok::KwAs => PREC_CAST,
        Tok::LBrace => {
            if allow_struct {
                return PREC_STRUCT;
            }
            PREC_LOWEST
        },
        Tok::LParen => PREC_CALL,
        Tok::LBracket => PREC_CALL,
        Tok::Question => PREC_CALL,
        Tok::Dot => PREC_ACCESS,
        Tok::ColonColon => PREC_ACCESS,
        _ => PREC_LOWEST,
    };
}

// The operator of a compound assignment token (`+` for `+=`)
func binop_for_text(text: str): BinOp {
    if text == "+" { return BinOp::Add; }
    if text == "-" { return BinOp::Sub; }
    if text == "*" { return BinOp::Mul; }
    if text == "/" { return BinOp::Div; }
    if text == "%" { return BinOp::Mod; }
    if text == "&" { return BinOp::BitAnd; }
    if text == "|" { return BinOp::BitOr; }
    if text == "^" { return BinOp::BitXor; }
    if text == "<<" { return BinOp::Shl; }
    return BinOp::Shr;
}

func binop_for(kind: Tok): BinOp {
    return match kind {
        Tok::PipePipe => BinOp::Or,
        Tok::AmpAmp => BinOp::And,
        Tok::EqEq => BinOp::Eq,
        Tok::NotEq => BinOp::Ne,
        Tok::Lt => BinOp::Lt,
        Tok::Le => BinOp::Le,
        Tok::Gt => BinOp::Gt,
        Tok::Ge => BinOp::Ge,
        Tok::Pipe => BinOp::BitOr,
        Tok::Caret => BinOp::BitXor,
        Tok::Amp => BinOp::BitAnd,
        Tok::Shl => BinOp::Shl,
        Tok::Shr => BinOp::Shr,
        Tok::Plus => BinOp::Add,
        Tok::Minus => BinOp::Sub,
        Tok::Star => BinOp::Mul,
        Tok::Slash => BinOp::Div,
        Tok::Percent => BinOp::Mod,
        _ => BinOp::Pow,
    };
}

func is_match_expr(e: &Expr): bool {
    return match e.kind {
        ExprKind::Match(_, _) => true,
        _ => false,
    };
}

func contains_str(list: Vec<str>, s: str): bool {
    var i = 0;
    while i < list.len {
        if list.get(i) == s {
            return true;
        }
        i += 1;
    }
    return false;
}

// Whether `self` is used anywhere in these statements (to tell methods from
// static functions)
func stmts_mention_self(body: Vec<&Stmt>): bool {
    var i = 0;
    while i < body.len {
        if stmt_mentions_self(body.get(i)) {
            return true;
        }
        i += 1;
    }
    return false;
}

func opt_mentions_self(e: Option<&Expr>): bool {
    return match e {
        Option::Some(x) => expr_mentions_self(x),
        Option::None => false,
    };
}

func exprs_mention_self(list: Vec<&Expr>): bool {
    var i = 0;
    while i < list.len {
        if expr_mentions_self(list.get(i)) {
            return true;
        }
        i += 1;
    }
    return false;
}

func stmt_mentions_self(s: &Stmt): bool {
    return match s.kind {
        StmtKind::VarDecl(_, _, _, value) => expr_mentions_self(value),
        StmtKind::Assign(target, value) => expr_mentions_self(target) || expr_mentions_self(value),
        StmtKind::ExprStmt(e) => expr_mentions_self(e),
        StmtKind::Return(value) => opt_mentions_self(value),
        StmtKind::If(cond, then_body, else_body) => expr_mentions_self(cond) || stmts_mention_self(then_body) || stmts_mention_self(else_body),
        StmtKind::Loop(cond, body) => opt_mentions_self(cond) || stmts_mention_self(body),
        StmtKind::ForIn(_, iterable, end, _, body) => expr_mentions_self(iterable) || opt_mentions_self(end) || stmts_mention_self(body),
        StmtKind::CompoundAssign(_, target, value) => expr_mentions_self(target) || expr_mentions_self(value),
        StmtKind::Destructure(_, _, value) => expr_mentions_self(value),
        _ => false,
    };
}

func expr_mentions_self(e: &Expr): bool {
    return match e.kind {
        ExprKind::Ident(name) => name == "self",
        ExprKind::Binary(_, l, r) => expr_mentions_self(l) || expr_mentions_self(r),
        ExprKind::Unary(_, x) => expr_mentions_self(x),
        ExprKind::AddrOf(x) => expr_mentions_self(x),
        ExprKind::Deref(x) => expr_mentions_self(x),
        ExprKind::Call(f, args) => expr_mentions_self(f) || exprs_mention_self(args),
        ExprKind::Index(a, i) => expr_mentions_self(a) || expr_mentions_self(i),
        ExprKind::Field(x, _) => expr_mentions_self(x),
        ExprKind::Path(ns, _) => expr_mentions_self(ns),
        ExprKind::StructLit(_, fields) => {
            var i = 0;
            while i < fields.len {
                if expr_mentions_self(fields.get(i).value) {
                    return true;
                }
                i += 1;
            }
            false
        },
        ExprKind::ArrayLit(items) => exprs_mention_self(items),
        ExprKind::Cast(x, _) => expr_mentions_self(x),
        ExprKind::Alloc(x) => expr_mentions_self(x),
        ExprKind::AllocIn(x, arena) => expr_mentions_self(x) || expr_mentions_self(arena),
        ExprKind::Match(scrutinee, arms) => {
            if expr_mentions_self(scrutinee) {
                return true;
            }
            var i = 0;
            while i < arms.len {
                if expr_mentions_self(arms.get(i).body) {
                    return true;
                }
                i += 1;
            }
            false
        },
        ExprKind::Block(stmts, value) => stmts_mention_self(stmts) || opt_mentions_self(value),
        ExprKind::Interpolate(parts) => exprs_mention_self(parts),
        ExprKind::Tuple(items) => exprs_mention_self(items),
        ExprKind::Try(x) => expr_mentions_self(x),
        ExprKind::MethodTurbofish(x, _, _) => expr_mentions_self(x),
        ExprKind::Closure(_, _, body) => stmts_mention_self(body),
        _ => false,
    };
}
