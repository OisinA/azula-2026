// The sieve of Eratosthenes, using a raw heap array.

const LIMIT: int = 100;

func main {
    // One flag per number: true while it might be prime
    var flags: &bool = malloc((LIMIT + 1) * sizeof(bool));
    var i = 0;
    while i <= LIMIT {
        flags[i] = i >= 2;
        i += 1;
    }

    var p = 2;
    while p * p <= LIMIT {
        if flags[p] {
            var multiple = p * p;
            while multiple <= LIMIT {
                flags[multiple] = false;
                multiple += p;
            }
        }
        p += 1;
    }

    var count = 0;
    i = 0;
    while i <= LIMIT {
        if flags[i] {
            printf("%d ", i);
            count += 1;
        }
        i += 1;
    }
    printf("\n%d primes up to %d\n", count, LIMIT);
    free(flags);
}
