// A module: items are private to this file unless declared `pub`.

pub struct Rect {
    width: int;
    height: int;

    func area(): int {
        return self.width * self.height;
    }

    func perimeter(): int {
        return twice(self.width + self.height);
    }
}

pub func square(side: int): Rect {
    return Rect { width: side, height: side };
}

// Private: only this file can use it (and its name can't clash with others)
func twice(n: int): int {
    return 2 * n;
}
