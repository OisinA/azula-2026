struct Rect {
    width: int,
    height: int,
}

impl Rect {
    func area(self: Rect): int {
        return self.width * self.height;
    }

    func perimeter(self: Rect): int {
        return 2 * (self.width + self.height);
    }
}

func square(side: int): Rect {
    return Rect { width: side, height: side };
}
