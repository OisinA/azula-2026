// Modules can import other modules; each file is only included once.
import "geometry.azl" as geo

pub func report(shapes: Vec<geo::Rect>) {
    var total = 0;
    for r in shapes {
        println("${r.width}x${r.height}: area ${r.area()}, perimeter ${r.perimeter()}");
        total += r.area();
    }
    println("total area ${total}");
}

// This file's own `twice` doesn't clash with geometry.azl's private one
func twice(n: int): int {
    return n + n;
}

pub func doubled_total(shapes: Vec<geo::Rect>): int {
    return twice(shapes.iter().map(func(r) => r.area()).fold(0, func(a, b) => a + b));
}
