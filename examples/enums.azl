// Enums, with and without payloads, and pattern matching.

enum Direction { North, East, South, West }

func turn_right(d: Direction): Direction {
    return match d {
        Direction::North => Direction::East,
        Direction::East => Direction::South,
        Direction::South => Direction::West,
        Direction::West => Direction::North,
    };
}

func direction_name(d: Direction): str {
    return match d {
        Direction::North => "north",
        Direction::East => "east",
        Direction::South => "south",
        Direction::West => "west",
    };
}

// Variants can carry values
enum Shape {
    Circle(int),
    Rectangle(int, int),
    Triangle(int, int, int),
    Point,
}

func area(s: Shape): int {
    return match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rectangle(w, h) => w * h,
        Shape::Triangle(a, b, _) => a * b / 2,
        Shape::Point => 0,
    };
}

func describe(s: Shape) {
    match s {
        Shape::Circle(r) => { printf("circle of radius %d", r); },
        Shape::Rectangle(w, h) => {
            if w == h {
                printf("square of side %d", w);
            } else {
                printf("%dx%d rectangle", w, h);
            }
        },
        Shape::Triangle(a, b, c) => { printf("triangle with sides %d, %d, %d", a, b, c); },
        Shape::Point => { printf("point"); },
    }
    printf(" (area about %d)\n", area(s));
}

// Matching on integers and characters
func vowel_count(s: str): int {
    var count = 0;
    var i = 0;
    while s[i] != 0 {
        count = count + match s[i] {
            'a' => 1,
            'e' => 1,
            'i' => 1,
            'o' => 1,
            'u' => 1,
            _ => 0,
        };
        i = i + 1;
    }
    return count;
}

func main {
    var d = Direction::North;
    var i = 0;
    while i < 5 {
        printf("%s ", direction_name(d));
        d = turn_right(d);
        i = i + 1;
    }
    printf("\n");
    if d == Direction::East {
        printf("plain enums can be compared with ==\n");
    }

    describe(Shape::Circle(2));
    describe(Shape::Rectangle(3, 4));
    describe(Shape::Rectangle(5, 5));
    describe(Shape::Triangle(3, 4, 5));
    describe(Shape::Point);

    printf("%d vowels in \"programming language\"\n", vowel_count("programming language"));
}
