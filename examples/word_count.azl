// Count how often each word appears in a text, using Map and Vec.

func is_letter(c: int): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

func lower(c: int): int {
    if c >= 'A' && c <= 'Z' {
        return c + 32;
    }
    return c;
}

// Split text into lowercase words
func words(text: str): Vec<str> {
    var result: Vec<str> = Vec::new();
    var i = 0;
    while text[i] != 0 {
        if is_letter(text[i] as int) {
            var word = StringBuilder::new();
            while is_letter(text[i] as int) {
                word.append_char(lower(text[i] as int));
                i = i + 1;
            }
            result.push(word.build());
        } else {
            i = i + 1;
        }
    }
    return result;
}

func main {
    var text = "The quick brown fox jumps over the lazy dog. The dog sleeps; the fox runs. A quick fox!";
    var all = words(text);

    var counts: Map<int> = Map::new();
    var i = 0;
    while i < all.length() {
        var word = all.get(i);
        counts.insert(word, counts.get(word).unwrap_or(0) + 1);
        i = i + 1;
    }

    printf("%d words, %d different\n", all.length(), counts.length());

    // Print words seen more than once, most common first
    var max = 0;
    var keys = counts.key_list();
    i = 0;
    while i < keys.length() {
        var n = counts.get(keys.get(i)).unwrap();
        if n > max {
            max = n;
        }
        i = i + 1;
    }
    var n = max;
    while n > 1 {
        i = 0;
        while i < all.length() {
            var word = all.get(i);
            // Only report each word at its first occurrence, so output is in text order
            if counts.get(word).unwrap() == n && first_index(all, word) == i {
                printf("%-6s %d\n", word, n);
            }
            i = i + 1;
        }
        n = n - 1;
    }
}

func first_index(list: Vec<str>, word: str): int {
    var i = 0;
    while i < list.length() {
        if strcmp(list.get(i), word) == 0 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}
