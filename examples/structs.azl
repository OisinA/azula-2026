// Structs, methods, and the difference between values and pointers.

struct Vec2 {
    x: int;
    y: int;

    func new(x: int, y: int): Vec2 {
        return Vec2 { x: x, y: y };
    }

    // `self: Vec2` receives a copy
    func add(other: Vec2): Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }

    func length_squared(): int {
        return self.x * self.x + self.y * self.y;
    }

    // `self: &Vec2` can modify the value the method is called on
    func scale(factor: int) {
        self.x *= factor;
        self.y *= factor;
    }
}

struct Particle {
    position: Vec2;
    velocity: Vec2;
    name: str;

    func step() {
        self.position = self.position.add(self.velocity);
    }

    func show() {
        printf("%s at (%d, %d)\n", self.name, self.position.x, self.position.y);
    }
}

func main {
    var a = Vec2::new(3, 4);
    var b = a.add(Vec2::new(1, 1));
    printf("a = (%d, %d), |a|^2 = %d\n", a.x, a.y, a.length_squared());
    printf("b = (%d, %d)\n", b.x, b.y);

    a.scale(10);
    printf("a scaled = (%d, %d)\n", a.x, a.y);

    // Fields of nested structs can be updated in place
    var p = Particle { name: "dust", position: Vec2::new(0, 0), velocity: Vec2::new(2, -1) };
    var i = 0;
    while i < 3 {
        p.step();
        i += 1;
    }
    p.show();
    p.velocity.x = 0;
    p.step();
    p.show();

    // alloc puts a struct on the heap and returns a pointer to it
    var heap: &Particle = new Particle { name: "heap", position: Vec2::new(5, 5), velocity: Vec2::new(1, 1) };
    heap.step();
    heap.show();
}
